+/* SPIR-V disk cache. glslang takes milliseconds per shader and every program
+ * a title uses is translated again on every launch, the first time it is
+ * drawn: the hitches of the first minutes in each area. The result depends
+ * only on the HLSL text, the stage and the translator, so it is stored under
+ * a 128-bit hash of those, one file per shader, and read back on the next
+ * launch. A file whose header does not match (another translator version, a
+ * different text length, a short read) counts as a miss and is rewritten.
+ * Bump SPIRV_CACHE_TAG whenever the options above change.
+ * PS3RECOMP_SHADER_CACHE=<dir> moves it (default $XDG_CACHE_HOME or
+ * ~/.cache, then ps3recomp/spirv), =0 turns it off.
+ * PS3RECOMP_SHADER_CACHE_STATS=1 logs hits, misses and translation time. */
+namespace {
+
+#define SPV_STR2(x) #x
+#define SPV_STR(x) SPV_STR2(x)
+const char SPIRV_CACHE_TAG[] = "rsx-spirv-cache 1 glslang "
+    SPV_STR(GLSLANG_VERSION_MAJOR) "." SPV_STR(GLSLANG_VERSION_MINOR) "."
+    SPV_STR(GLSLANG_VERSION_PATCH) GLSLANG_VERSION_FLAVOR;
+
+struct SpvCacheHeader {
+    char magic[8];          /* "RSXSPV1\0" */
+    u64  key_lo, key_hi;    /* repeats the file name */
+    u64  text_bytes;        /* strlen(hlsl) */
+    u32  stage, words;
+};
+
+std::string spv_cache_dir()
+{
+    static std::once_flag once;
+    static std::string dir;
+    std::call_once(once, [] {
+        const char* e = getenv("PS3RECOMP_SHADER_CACHE");
+        if (e && e[0] == '0' && !e[1]) return;
+        std::string d;
+        if (e && *e) d = e;
+        else if (const char* x = getenv("XDG_CACHE_HOME"); x && *x) d = std::string(x) + "/ps3recomp/spirv";
+        else if (const char* h = getenv("HOME"); h && *h) d = std::string(h) + "/.cache/ps3recomp/spirv";
+        else return;
+        for (size_t i = 1; i <= d.size(); i++)          /* mkdir -p */
+            if (i == d.size() || d[i] == '/') mkdir(d.substr(0, i).c_str(), 0755);
+        struct stat st;
+        if (stat(d.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) dir = d;
+    });
+    return dir;
+}
+
+void spv_cache_key(const char* hlsl, size_t n, int stage, u64* lo, u64* hi)
+{
+    u64 a = 1469598103934665603ull, b = 0x9E3779B97F4A7C15ull;
+    auto mix = [&](const unsigned char* p, size_t len) {
+        for (size_t i = 0; i < len; i++) {
+            a = (a ^ p[i]) * 1099511628211ull;
+            b = (b ^ p[i]) * 0xff51afd7ed558ccdull;
+            b ^= b >> 29;
+        }
+    };
+    mix((const unsigned char*)SPIRV_CACHE_TAG, sizeof SPIRV_CACHE_TAG);
+    const unsigned char st = (unsigned char)stage;
+    mix(&st, 1);
+    mix((const unsigned char*)hlsl, n);
+    *lo = a; *hi = b;
+}
+
+std::atomic<unsigned> s_spv_hits{0}, s_spv_misses{0}, s_spv_tmp{0};
+std::atomic<unsigned long long> s_spv_miss_us{0};
+
+} // namespace
+
+extern "C" int rsx_hlsl_to_spirv(const char* hlsl, int stage,
+                                 u32* words, u32 max_words, u32* out_words,
+                                 char* log, u32 log_size)
+{
+    const std::string dir = (hlsl && words && out_words) ? spv_cache_dir() : std::string();
+    if (dir.empty())
+        return hlsl_to_spirv_uncached(hlsl, stage, words, max_words, out_words, log, log_size);
+    static const int stats = getenv("PS3RECOMP_SHADER_CACHE_STATS") ? 1 : 0;
+
+    const size_t n = strlen(hlsl);
+    u64 lo, hi;
+    spv_cache_key(hlsl, n, stage, &lo, &hi);
+    char name[64];
+    snprintf(name, sizeof name, "/%016llx%016llx.spv", (unsigned long long)hi, (unsigned long long)lo);
+    const std::string path = dir + name;
+
+    if (FILE* f = fopen(path.c_str(), "rb")) {
+        SpvCacheHeader h;
+        const bool ok = fread(&h, sizeof h, 1, f) == 1 &&
+            memcmp(h.magic, "RSXSPV1", 8) == 0 && h.key_lo == lo && h.key_hi == hi &&
+            h.text_bytes == n && h.stage == (u32)stage && h.words && h.words <= max_words &&
+            fread(words, sizeof(u32), h.words, f) == h.words && fgetc(f) == EOF;
+        fclose(f);
+        if (ok) {
+            *out_words = h.words;
+            const unsigned k = ++s_spv_hits;
+            if (stats && (k & 63u) == 1u)
+                fprintf(stderr, "[spirv-cache] %u hits, %u misses (%llu ms translating)\n",
+                        k, s_spv_misses.load(), s_spv_miss_us.load() / 1000ull);
+            return 0;
+        }
+    }
+
+    const auto t0 = std::chrono::steady_clock::now();
+    const int rc = hlsl_to_spirv_uncached(hlsl, stage, words, max_words, out_words, log, log_size);
+    const unsigned long long us = (unsigned long long)std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now() - t0).count();
+    s_spv_miss_us += us;
+    const unsigned k = ++s_spv_misses;
+    if (stats)
+        fprintf(stderr, "[spirv-cache] miss %u: %llu us (%u hits so far)\n", k, us, s_spv_hits.load());
+    if (rc != 0 || !*out_words) return rc;
+
+    /* Written whole to a private name, then renamed: a reader never sees
+     * half a file, and two writers of one key leave one complete copy. */
+    SpvCacheHeader h;
+    memset(&h, 0, sizeof h);
+    memcpy(h.magic, "RSXSPV1", 8);
+    h.key_lo = lo; h.key_hi = hi; h.text_bytes = n;
+    h.stage = (u32)stage; h.words = *out_words;
+    char tmp_suffix[48];
+    snprintf(tmp_suffix, sizeof tmp_suffix, ".%d.%u.tmp", (int)getpid(), ++s_spv_tmp);
+    const std::string tmp = path + tmp_suffix;
+    if (FILE* f = fopen(tmp.c_str(), "wb")) {
+        const bool ok = fwrite(&h, sizeof h, 1, f) == 1 &&
+            fwrite(words, sizeof(u32), h.words, f) == h.words;
+        if (fclose(f) == 0 && ok) rename(tmp.c_str(), path.c_str());
+        else remove(tmp.c_str());
+    }
+    return 0;
+}
+
 #else /* !PS3RECOMP_HAVE_SPIRV_TRANSLATION */
 
 extern "C" int rsx_hlsl_to_spirv_available(void) { return 0; }
