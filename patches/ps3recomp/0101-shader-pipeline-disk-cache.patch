@@ -221,6 +225,121 @@ typedef struct vk_state {
 
 static vk_state s_vk;
 
+/* Pipeline disk cache. Every graphics pipeline is created through
+ * s_vk_pcache, which starts from the file the last launch left
+ * (<shader cache dir>/vk_pipelines.bin, the directory of the SPIR-V cache,
+ * rsx_shader_spirv.cpp) and is written back from a background thread every
+ * 15 s while new pipelines appear: the driver validates the header (vendor,
+ * device, driver UUID) and ignores a stale file. PS3RECOMP_SHADER_CACHE=0
+ * turns it off with the SPIR-V cache; PS3RECOMP_SHADER_CACHE_STATS=1 logs
+ * pipeline creation counts and times. */
+static VkPipelineCache s_vk_pcache;
+static char            s_vk_pcache_path[1024];
+static volatile u32    s_vk_pipes_made, s_vk_pipes_saved;
+static double          s_vk_pipe_ms, s_vk_pipe_ms_max;
+
+static double vk_now_ms(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1e3 + t.tv_nsec * 1e-6;
+}
+
+static int vk_pcache_save(void)
+{
+    size_t n = 0;
+    if (!s_vk_pcache || pvkGetPipelineCacheData(s_vk.device, s_vk_pcache, &n, NULL) != VK_SUCCESS || !n)
+        return -1;
+    void* data = malloc(n);
+    if (!data) return -1;
+    int rc = -1;
+    if (pvkGetPipelineCacheData(s_vk.device, s_vk_pcache, &n, data) == VK_SUCCESS) {
+        char tmp[1100];
+        snprintf(tmp, sizeof tmp, "%s.%d.tmp", s_vk_pcache_path, (int)getpid());
+        FILE* f = fopen(tmp, "wb");
+        if (f) {
+            const int ok = fwrite(data, 1, n, f) == n;
+            if (fclose(f) == 0 && ok && rename(tmp, s_vk_pcache_path) == 0) rc = 0;
+            else remove(tmp);
+        }
+    }
+    free(data);
+    return rc;
+}
+
+static void* vk_pcache_saver(void* arg)
+{
+    (void)arg;
+    for (;;) {
+        sleep(15);
+        const u32 made = s_vk_pipes_made;
+        if (made != s_vk_pipes_saved && vk_pcache_save() == 0) s_vk_pipes_saved = made;
+    }
+    return NULL;
+}
+
+static void vk_pcache_open(void)
+{
+    const char* e = getenv("PS3RECOMP_SHADER_CACHE");
+    if (e && e[0] == '0' && !e[1]) return;
+    char dir[900];
+    const char* x = getenv("XDG_CACHE_HOME");
+    const char* h = getenv("HOME");
+    if (e && *e)        snprintf(dir, sizeof dir, "%s", e);
+    else if (x && *x)   snprintf(dir, sizeof dir, "%s/ps3recomp/spirv", x);
+    else if (h && *h)   snprintf(dir, sizeof dir, "%s/.cache/ps3recomp/spirv", h);
+    else return;
+    for (char* p = dir + 1; ; p++) {                        /* mkdir -p */
+        const char c = *p;
+        if (c == '/' || !c) { *p = 0; mkdir(dir, 0755); *p = c; }
+        if (!c) break;
+    }
+    snprintf(s_vk_pcache_path, sizeof s_vk_pcache_path, "%s/vk_pipelines.bin", dir);
+    void* data = NULL;
+    size_t n = 0;
+    FILE* f = fopen(s_vk_pcache_path, "rb");
+    if (f) {
+        if (fseek(f, 0, SEEK_END) == 0) {
+            const long len = ftell(f);
+            if (len > 0 && len < (256L << 20) && fseek(f, 0, SEEK_SET) == 0 &&
+                (data = malloc((size_t)len)) && fread(data, 1, (size_t)len, f) == (size_t)len)
+                n = (size_t)len;
+        }
+        fclose(f);
+    }
+    VkPipelineCacheCreateInfo ci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO,
+                                     .initialDataSize = n, .pInitialData = n ? data : NULL };
+    if (pvkCreatePipelineCache(s_vk.device, &ci, NULL, &s_vk_pcache) != VK_SUCCESS) {
+        ci.initialDataSize = 0; ci.pInitialData = NULL;      /* a file the driver refuses */
+        if (pvkCreatePipelineCache(s_vk.device, &ci, NULL, &s_vk_pcache) != VK_SUCCESS)
+            s_vk_pcache = VK_NULL_HANDLE;
+    }
+    free(data);
+    if (!s_vk_pcache) return;
+    fprintf(stderr, "[vk] pipeline cache: %s (%zu bytes loaded)\n", s_vk_pcache_path, n);
+    pthread_t t;
+    if (pthread_create(&t, NULL, vk_pcache_saver, NULL) == 0) pthread_detach(t);
+}
+
+/* vkCreateGraphicsPipelines through the disk cache, timed. */
+static VkResult vk_create_pipeline(const VkGraphicsPipelineCreateInfo* gci, VkPipeline* out)
+{
+    static int stats = -1;
+    if (stats < 0) stats = getenv("PS3RECOMP_SHADER_CACHE_STATS") ? 1 : 0;
+    const double t0 = stats ? vk_now_ms() : 0.0;
+    const VkResult r = pvkCreateGraphicsPipelines(s_vk.device, s_vk_pcache, 1, gci, NULL, out);
+    __atomic_add_fetch(&s_vk_pipes_made, 1u, __ATOMIC_RELAXED);
+    if (stats) {
+        const double ms = vk_now_ms() - t0;
+        s_vk_pipe_ms += ms;
+        if (ms > s_vk_pipe_ms_max) s_vk_pipe_ms_max = ms;
+        if ((s_vk_pipes_made & 63u) == 1u || ms > 20.0)
+            fprintf(stderr, "[vk-pipeline] %u made, %.0f ms total, max %.1f ms (this one %.1f ms)\n",
+                    s_vk_pipes_made, s_vk_pipe_ms, s_vk_pipe_ms_max, ms);
+    }
+    return r;
+}
