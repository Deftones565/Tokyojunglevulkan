     ps3_hle_register_ctx(ps3_compute_nid("cellFsUnlink"),   "cellFsUnlink",   cellFsUnlink);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsFsync"),    "cellFsFsync",    cellFsFsync);
+    ps3_hle_register_ctx(ps3_compute_nid("sceNpDrmIsAvailable"),  "sceNpDrmIsAvailable",  sceNpDrmIsAvailable);
+    ps3_hle_register_ctx(ps3_compute_nid("sceNpDrmIsAvailable2"), "sceNpDrmIsAvailable2", sceNpDrmIsAvailable);
