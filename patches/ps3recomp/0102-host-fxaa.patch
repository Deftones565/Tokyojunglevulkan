+/* Host FXAA (rsx_vulkan_backend_set_fxaa; libs/video/vulkan/rsx_vk_fxaa.*):
+ * one full-screen pass over the frame at its own size into s_fxaa.img, which
+ * the window blit then scales instead of the frame. Engine frames only (they
+ * are sampled images); anything else is presented as before. A setup failure
+ * turns it off for the run. */
+static struct {
+    int                   on, failed;
+    VkRenderPass          rp;
+    VkPipeline            pipe;
+    VkPipelineLayout      layout;
+    VkDescriptorSetLayout dsl;
+    VkDescriptorPool      pool;
+    VkDescriptorSet       set;
+    VkSampler             samp;
+    vk_image              img;
+    VkFramebuffer         fb;
+    u32                   w, h;
+} s_fxaa;
+
+static void vk_fxaa_drop(void)
+{
+    if (!s_vk.device) return;
+    if (s_fxaa.fb)     pvkDestroyFramebuffer(s_vk.device, s_fxaa.fb, NULL);
+    vk_destroy_image_now(&s_fxaa.img);
+    if (s_fxaa.pipe)   pvkDestroyPipeline(s_vk.device, s_fxaa.pipe, NULL);
+    if (s_fxaa.layout) pvkDestroyPipelineLayout(s_vk.device, s_fxaa.layout, NULL);
+    if (s_fxaa.pool)   pvkDestroyDescriptorPool(s_vk.device, s_fxaa.pool, NULL);
+    if (s_fxaa.dsl)    pvkDestroyDescriptorSetLayout(s_vk.device, s_fxaa.dsl, NULL);
+    if (s_fxaa.samp)   pvkDestroySampler(s_vk.device, s_fxaa.samp, NULL);
+    if (s_fxaa.rp)     pvkDestroyRenderPass(s_vk.device, s_fxaa.rp, NULL);
+    const int on = s_fxaa.on, failed = s_fxaa.failed;
+    memset(&s_fxaa, 0, sizeof s_fxaa);
+    s_fxaa.on = on; s_fxaa.failed = failed;
+}
+
+/* Pipeline objects once, the target at the frame's size. 0 when ready. */
+static int vk_fxaa_setup(u32 w, u32 h)
+{
+    if (!s_fxaa.pipe) {
+        VkAttachmentDescription at = {
+            .format = VK_FORMAT_R8G8B8A8_UNORM, .samples = VK_SAMPLE_COUNT_1_BIT,
+            .loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+            .stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, .stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE,
+            .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED, .finalLayout = VK_IMAGE_LAYOUT_GENERAL,
+        };
+        VkAttachmentReference ref = { 0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL };
+        VkSubpassDescription sub = { .pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                     .colorAttachmentCount = 1, .pColorAttachments = &ref };
+        VkRenderPassCreateInfo rci = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO,
+                                       .attachmentCount = 1, .pAttachments = &at,
+                                       .subpassCount = 1, .pSubpasses = &sub };
+        VK_CHECK(pvkCreateRenderPass(s_vk.device, &rci, NULL, &s_fxaa.rp), "vkCreateRenderPass(fxaa)");
+        VkSamplerCreateInfo sci = { .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+                                    .magFilter = VK_FILTER_LINEAR, .minFilter = VK_FILTER_LINEAR,
+                                    .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+                                    .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+                                    .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+                                    .maxLod = 0.0f };
+        VK_CHECK(pvkCreateSampler(s_vk.device, &sci, NULL, &s_fxaa.samp), "vkCreateSampler(fxaa)");
+        VkDescriptorSetLayoutBinding b = { 0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1,
+                                           VK_SHADER_STAGE_FRAGMENT_BIT, NULL };
+        VkDescriptorSetLayoutCreateInfo dci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                                .bindingCount = 1, .pBindings = &b };
+        VK_CHECK(pvkCreateDescriptorSetLayout(s_vk.device, &dci, NULL, &s_fxaa.dsl), "vkCreateDescriptorSetLayout(fxaa)");
+        VkDescriptorPoolSize ps = { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1 };
+        VkDescriptorPoolCreateInfo pci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                           .maxSets = 1, .poolSizeCount = 1, .pPoolSizes = &ps };
+        VK_CHECK(pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &s_fxaa.pool), "vkCreateDescriptorPool(fxaa)");
+        VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                                           .descriptorPool = s_fxaa.pool, .descriptorSetCount = 1,
+                                           .pSetLayouts = &s_fxaa.dsl };
+        VK_CHECK(pvkAllocateDescriptorSets(s_vk.device, &ai, &s_fxaa.set), "vkAllocateDescriptorSets(fxaa)");
+        VkPipelineLayoutCreateInfo lci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                           .setLayoutCount = 1, .pSetLayouts = &s_fxaa.dsl };
+        VK_CHECK(pvkCreatePipelineLayout(s_vk.device, &lci, NULL, &s_fxaa.layout), "vkCreatePipelineLayout(fxaa)");
+
+        VkShaderModule vs = VK_NULL_HANDLE, fs = VK_NULL_HANDLE;
+        VkShaderModuleCreateInfo mvs = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+                                         .codeSize = sizeof rsx_vk_fxaa_vert_spv, .pCode = rsx_vk_fxaa_vert_spv };
+        VkShaderModuleCreateInfo mfs = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+                                         .codeSize = sizeof rsx_vk_fxaa_frag_spv, .pCode = rsx_vk_fxaa_frag_spv };
+        if (pvkCreateShaderModule(s_vk.device, &mvs, NULL, &vs) != VK_SUCCESS ||
+            pvkCreateShaderModule(s_vk.device, &mfs, NULL, &fs) != VK_SUCCESS) {
+            if (vs) pvkDestroyShaderModule(s_vk.device, vs, NULL);
+            return -1;
+        }
+        VkPipelineShaderStageCreateInfo st[2] = {
+            { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+              .stage = VK_SHADER_STAGE_VERTEX_BIT, .module = vs, .pName = "main" },
+            { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+              .stage = VK_SHADER_STAGE_FRAGMENT_BIT, .module = fs, .pName = "main" },
+        };
+        VkPipelineVertexInputStateCreateInfo vi = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+        VkPipelineInputAssemblyStateCreateInfo ia = { .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+                                                      .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST };
+        VkPipelineViewportStateCreateInfo vps = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+                                                  .viewportCount = 1, .scissorCount = 1 };
+        VkPipelineRasterizationStateCreateInfo rs = { .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+                                                      .polygonMode = VK_POLYGON_MODE_FILL,
+                                                      .cullMode = VK_CULL_MODE_NONE,
+                                                      .frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE,
+                                                      .lineWidth = 1.0f };
+        VkPipelineMultisampleStateCreateInfo ms = { .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+                                                    .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT };
+        VkPipelineColorBlendAttachmentState ba = { .colorWriteMask = 0xF };
+        VkPipelineColorBlendStateCreateInfo cb = { .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+                                                   .attachmentCount = 1, .pAttachments = &ba };
+        static const VkDynamicState dyn[2] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+        VkPipelineDynamicStateCreateInfo ds = { .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO,
+                                                .dynamicStateCount = 2, .pDynamicStates = dyn };
+        VkGraphicsPipelineCreateInfo gci = {
+            .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+            .stageCount = 2, .pStages = st, .pVertexInputState = &vi, .pInputAssemblyState = &ia,
+            .pViewportState = &vps, .pRasterizationState = &rs, .pMultisampleState = &ms,
+            .pColorBlendState = &cb, .pDynamicState = &ds, .layout = s_fxaa.layout,
+            .renderPass = s_fxaa.rp, .subpass = 0,
+        };
+        const VkResult r = vk_create_pipeline(&gci, &s_fxaa.pipe);
+        pvkDestroyShaderModule(s_vk.device, vs, NULL);
+        pvkDestroyShaderModule(s_vk.device, fs, NULL);
+        if (r != VK_SUCCESS) { s_fxaa.pipe = VK_NULL_HANDLE; return -1; }
+    }
+    if (!s_fxaa.fb || s_fxaa.w != w || s_fxaa.h != h) {
+        if (s_fxaa.fb) { pvkDestroyFramebuffer(s_vk.device, s_fxaa.fb, NULL); s_fxaa.fb = VK_NULL_HANDLE; }
+        vk_destroy_image_now(&s_fxaa.img);
+        if (vk_create_image(&s_fxaa.img, VK_FORMAT_R8G8B8A8_UNORM, w, h,
+                            VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT)) return -1;
+        VkFramebufferCreateInfo fci = { .sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO,
+                                        .renderPass = s_fxaa.rp, .attachmentCount = 1,
+                                        .pAttachments = &s_fxaa.img.view,
+                                        .width = w, .height = h, .layers = 1 };
+        VK_CHECK(pvkCreateFramebuffer(s_vk.device, &fci, NULL, &s_fxaa.fb), "vkCreateFramebuffer(fxaa)");
+        s_fxaa.w = w; s_fxaa.h = h;
+    }
+    /* Every frame: a destroyed surface's view handle can come back as a new
+     * view's, so "same handle" does not mean "same view". The last present
+     * was waited for, so the set is not in use. */
+    {
+        VkDescriptorImageInfo ii = { s_fxaa.samp, s_disp.src_view, VK_IMAGE_LAYOUT_GENERAL };
+        VkWriteDescriptorSet wr = { .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = s_fxaa.set,
+                                    .dstBinding = 0, .descriptorCount = 1,
+                                    .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+                                    .pImageInfo = &ii };
+        pvkUpdateDescriptorSets(s_vk.device, 1, &wr, 0, NULL);
+    }
+    return 0;
+}
+
+/* Record the pass: the frame (GENERAL) -> s_fxaa.img, left in GENERAL for
+ * the blit. */
+static void vk_fxaa_record(void)
+{
+    VkRenderPassBeginInfo rbi = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO,
+                                  .renderPass = s_fxaa.rp, .framebuffer = s_fxaa.fb,
+                                  .renderArea = { { 0, 0 }, { s_fxaa.w, s_fxaa.h } } };
+    pvkCmdBeginRenderPass(s_vk.cmd, &rbi, VK_SUBPASS_CONTENTS_INLINE);
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s_fxaa.pipe);
+    VkViewport vp = { 0.0f, 0.0f, (float)s_fxaa.w, (float)s_fxaa.h, 0.0f, 1.0f };
+    VkRect2D sc = { { 0, 0 }, { s_fxaa.w, s_fxaa.h } };
+    pvkCmdSetViewport(s_vk.cmd, 0, 1, &vp);
+    pvkCmdSetScissor(s_vk.cmd, 0, 1, &sc);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s_fxaa.layout, 0, 1, &s_fxaa.set, 0, NULL);
+    pvkCmdDraw(s_vk.cmd, 3, 1, 0, 0);
+    pvkCmdEndRenderPass(s_vk.cmd);
+    vk_barrier_image(s_fxaa.img.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+}
+
