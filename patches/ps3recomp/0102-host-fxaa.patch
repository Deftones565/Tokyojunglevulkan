diff --git a/libs/video/vulkan/rsx_vk_fxaa.frag b/libs/video/vulkan/rsx_vk_fxaa.frag
new file mode 100644
index 0000000..b89dd18
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_fxaa.frag
@@ -0,0 +1,40 @@
+#version 450
+// Host FXAA (luma-based, after Timothy Lottes' FXAA 3.11 console variant):
+// finds the local edge direction from the four diagonal neighbours, blurs
+// along it, and keeps the narrower blur when the wider one strays outside the
+// neighbourhood's luma range. One pass over the finished frame, before it is
+// scaled to the window. Output alpha is 1.
+layout(set = 0, binding = 0) uniform sampler2D u_frame;
+layout(location = 0) in vec2 v_uv;
+layout(location = 0) out vec4 o_col;
+
+const float REDUCE_MIN = 1.0 / 128.0;
+const float REDUCE_MUL = 1.0 / 8.0;
+const float SPAN_MAX = 8.0;
+const vec3 LUMA = vec3(0.299, 0.587, 0.114);
+
+void main()
+{
+    vec2 rcp = 1.0 / vec2(textureSize(u_frame, 0));
+    vec3 nw = texture(u_frame, v_uv + vec2(-1.0, -1.0) * rcp).rgb;
+    vec3 ne = texture(u_frame, v_uv + vec2( 1.0, -1.0) * rcp).rgb;
+    vec3 sw = texture(u_frame, v_uv + vec2(-1.0,  1.0) * rcp).rgb;
+    vec3 se = texture(u_frame, v_uv + vec2( 1.0,  1.0) * rcp).rgb;
+    vec3 m  = texture(u_frame, v_uv).rgb;
+    float lnw = dot(nw, LUMA), lne = dot(ne, LUMA);
+    float lsw = dot(sw, LUMA), lse = dot(se, LUMA), lm = dot(m, LUMA);
+    float lmin = min(lm, min(min(lnw, lne), min(lsw, lse)));
+    float lmax = max(lm, max(max(lnw, lne), max(lsw, lse)));
+
+    vec2 dir = vec2(-((lnw + lne) - (lsw + lse)), (lnw + lsw) - (lne + lse));
+    float reduce = max((lnw + lne + lsw + lse) * (0.25 * REDUCE_MUL), REDUCE_MIN);
+    float rcp_min = 1.0 / (min(abs(dir.x), abs(dir.y)) + reduce);
+    dir = clamp(dir * rcp_min, vec2(-SPAN_MAX), vec2(SPAN_MAX)) * rcp;
+
+    vec3 a = 0.5 * (texture(u_frame, v_uv + dir * (1.0 / 3.0 - 0.5)).rgb +
+                    texture(u_frame, v_uv + dir * (2.0 / 3.0 - 0.5)).rgb);
+    vec3 b = a * 0.5 + 0.25 * (texture(u_frame, v_uv + dir * -0.5).rgb +
+                               texture(u_frame, v_uv + dir *  0.5).rgb);
+    float lb = dot(b, LUMA);
+    o_col = vec4((lb < lmin || lb > lmax) ? a : b, 1.0);
+}
diff --git a/libs/video/vulkan/rsx_vk_fxaa.vert b/libs/video/vulkan/rsx_vk_fxaa.vert
new file mode 100644
index 0000000..53a6719
--- /dev/null
+++ b/libs/video/vulkan/rsx_vk_fxaa.vert
@@ -0,0 +1,8 @@
+#version 450
+// Full-screen triangle for the host FXAA pass (rsx_vulkan_backend.c, vk_fxaa_*).
+layout(location = 0) out vec2 v_uv;
+void main()
+{
+    v_uv = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
+    gl_Position = vec4(v_uv * 2.0 - 1.0, 0.0, 1.0);
+}
