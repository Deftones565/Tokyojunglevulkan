 static u64 rsx_vertex_remap_hash(u64 value)
 {
     value ^= value >> 33;
@@ -321,6 +458,58 @@ int rsx_vertex_remap_build(
         remap->occurrence_capacity = count;
     }
 
+    /* The same first-occurrence numbering without hashing: refs that are one
+     * consecutive run have no repeats, and refs of one base index whose
+     * vertex ids span a compact range are numbered through a direct table. */
+    {
+        const u32 base = refs[0].base_index, v0 = refs[0].vertex_id;
+        u32 lo = v0, hi = v0;
+        int run = 1, one_base = 1;
+        for (u32 i = 1; i < count; i++) {
+            const u32 v = refs[i].vertex_id;
+            if (refs[i].base_index != base) { one_base = 0; break; }
+            if (v != v0 + i) run = 0;
+            if (v < lo) lo = v;
+            if (v > hi) hi = v;
+        }
+        if (one_base && run)
+            return 1;                          /* *unique_count = count */
+        const u64 range = (u64)hi - lo + 1u;
+        if (one_base && range <= (u64)count * 4u + 4096u && range <= (1u << 24)) {
+            if (range > remap->dense_capacity) {
+                u32* gen = (u32*)realloc(remap->dense_gen, (size_t)range * sizeof(u32));
+                if (!gen) return 0;
+                remap->dense_gen = gen;
+                u32* val = (u32*)realloc(remap->dense_val, (size_t)range * sizeof(u32));
+                if (!val) return 0;
+                remap->dense_val = val;
+                memset(remap->dense_gen, 0, (size_t)range * sizeof(u32));
+                remap->dense_capacity = (u32)range;
+                remap->dense_generation = 0;
+            }
+            if (!++remap->dense_generation) {
+                memset(remap->dense_gen, 0, (size_t)remap->dense_capacity * sizeof(u32));
+                remap->dense_generation = 1u;
+            }
+            const u32 g = remap->dense_generation;
+            u32 unique = 0;
+            for (u32 occurrence = 0; occurrence < count; occurrence++) {
+                const rsx_vertex_ref ref = refs[occurrence];
+                const u32 k = ref.vertex_id - lo;
+                if (remap->dense_gen[k] != g) {
+                    remap->dense_gen[k] = g;
+                    remap->dense_val[k] = unique;
+                    refs[unique] = ref;
+                    remap->occurrence_to_unique[occurrence] = unique++;
+                } else {
+                    remap->occurrence_to_unique[occurrence] = remap->dense_val[k];
+                }
+            }
+            *unique_count = unique;
+            return 1;
+        }
+    }
+
     if (count > UINT_MAX / 2u)
         return 0;
     u32 slot_capacity = 16u;
@@ -390,6 +579,8 @@ void rsx_vertex_remap_destroy(rsx_vertex_remap* remap)
         return;
     free(remap->occurrence_to_unique);
     free(remap->slots);
+    free(remap->dense_gen);
+    free(remap->dense_val);
     memset(remap, 0, sizeof(*remap));
 }
 
