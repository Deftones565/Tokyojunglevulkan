+/* The other generation's batch storage (s_pg): swapped with s_bs/s_bst at
+ * each non-waiting present. vsc/psc stay: they are the bound constants. */
+static struct {
+    vk_buffer        v, i, u, bst;
+    VkDescriptorPool pool;
+    u32              sets;
+} s_pg_store[VK_PGEN];
+
+/* After the present of the frame generation s_pg.cur recorded: wait for the
+ * other generation's last frame, recycle what it owned and record into it. */
+static void vk_pg_next(void)
+{
+    const int g = s_pg.cur, n = (g + 1) % VK_PGEN;
+    vk_pg_wait(n);
+    s_pg_store[g].v = s_bs.v; s_pg_store[g].i = s_bs.i; s_pg_store[g].u = s_bs.u;
+    s_pg_store[g].bst = s_bst; s_pg_store[g].pool = s_bs.pool; s_pg_store[g].sets = s_bs.sets;
+    s_bs.v = s_pg_store[n].v; s_bs.i = s_pg_store[n].i; s_bs.u = s_pg_store[n].u;
+    s_bst = s_pg_store[n].bst; s_bs.pool = s_pg_store[n].pool; s_bs.sets = s_pg_store[n].sets;
+    memset(&s_pg_store[n], 0, sizeof s_pg_store[n]);
+    s_pg.cur = n;
+    vk_graveyard_empty_gen(n);
+    vk_batch_reset();
+    s_batch.draws = 0;
+}
