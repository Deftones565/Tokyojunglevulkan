+
+static void vk_pg_wait(int g)
+{
+    if (!s_pg.pending[g]) return;
+    pvkWaitForFences(s_vk.device, 1, &s_pg.fence[g], VK_TRUE, UINT64_MAX);
+    s_pg.pending[g] = 0;
+}
+
+static void vk_pg_idle(void)
+{
+    for (int g = 0; g < VK_PGEN; g++) vk_pg_wait(g);
+}
