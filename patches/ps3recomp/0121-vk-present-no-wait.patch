+/* Presents that do not wait (vk_present_window). The frame is submitted and
+ * presented, and the CPU goes on to the next one while the GPU draws it: the
+ * FIFO thread used to wait for the whole frame's GPU work at every present
+ * (Steam Deck: ~12 of 33 ms a frame), and the game's main thread waited on
+ * the FIFO thread. What the batch owns until its GPU work is done -- the
+ * rings, upload staging, descriptor pool, graveyard and the present's own
+ * command buffer, fence, acquire semaphore and overlay buffer -- is kept per
+ * frame, in VK_PGEN generations: frame N records into generation N % 2, and
+ * the present of frame N waits for frame N-1's GPU work (its present's fence)
+ * before recycling that generation. So the GPU runs at most one frame behind.
+ * GPU order is unchanged (one queue, a global barrier in front of every
+ * recorded operation); anything that destroys an object waits for both.
+ * PS3RECOMP_VK_PRESENT_WAIT=1 waits at every present, as before. */
+#define VK_PGEN 2
+static struct {
+    int             ready;           /* the objects below exist             */
+    int             cur;             /* generation now recording            */
+    VkCommandBuffer cb[VK_PGEN];
+    VkFence         fence[VK_PGEN];
+    VkSemaphore     acq[VK_PGEN];
+    int             pending[VK_PGEN];
