SPU integer helpers: SSE4.1 versions of the byte/halfword/quadword-byte loops, forced inline

Applies on top of 0057 (spu-float-helpers-simd). Under the same guard as the
spu_shufb SSE path (__SSE4_1__, x86-64), with the scalar loops kept as the
fallback: ceqb cgtb clgtb ceqbi cgtbi clgtbi andbi orbi xorbi absdb avgb sumb
cntb xsbh, ah sfh ahi sfhi ceqh cgth clgth ceqhi cgthi clgthi andhi orhi xorhi
shlhi rothi rotmhi rothmi rotmahi, cg bg addx sfx, and the quadword byte
shifts/rotates (shlqby[i|bi] rotqby[i|bi] rotqmby[i|bi]) as one pshufb. These
and the SSE spu_shufb become always_inline (SPU_HOT): in the huge lifted
functions the inliner left them as calls passing each u128 in GPR pairs.
Checked bit for bit against the old code by
tools/spu-bisect/xf-harness/bx_harness.c (exhaustive byte/halfword pairs and
imm values, every shift count; 0 mismatches).

--- a/runtime/spu/spu_helpers.h
+++ b/runtime/spu/spu_helpers.h
@@ -56,6 +56,48 @@
  * are unaffected (W is identity modulo the within-word reversal). */
 #define SPU_W(P) (((P) & ~3) | (3 - ((P) & 3)))
 
+/* SPU_HOT: forced inline. The lifted functions are huge and the inliner gives
+ * up on them, leaving hot helpers like absdb, rotqby and shufb as calls that
+ * pass and return each u128 (a union with uint64_t members) in general
+ * registers. */
+#if defined(__GNUC__) || defined(__clang__)
+#define SPU_HOT static inline __attribute__((always_inline))
+#else
+#define SPU_HOT static inline
+#endif
+/* x86 vector versions of the integer byte/halfword/word helpers (the lifted
+ * SPU sources get -msse4.1 when the build host has it: PORT_SPU_HOST_SIMD).
+ * The scalar loops next to each one stay as the fallback and the reference;
+ * tools/spu-bisect/xf-harness/bx_harness.c in the port checks every one bit
+ * for bit. Lane-wise ops do not care about the in-word byte order; the
+ * quadword byte shifts work in SPU byte order through SPU_W. */
+#if defined(__SSE4_1__) && (defined(__x86_64__) || defined(_M_X64))
+#include <smmintrin.h>
+#define SPU_SIMD_X86 1
+SPU_HOT __m128i spu__mi(u128 a) { __m128i v; memcpy(&v, &a, 16); return v; }
+SPU_HOT u128 spu__um(__m128i v) { u128 r; memcpy(&r, &v, 16); return r; }
+/* Quadword byte moves: result SPU byte i = a's SPU byte s(i), or 0. SPU byte P
+ * is host byte P ^ 3 (= SPU_W(P)), so host byte h takes host byte
+ * s(h ^ 3) ^ 3; pshufb writes 0 where the control byte has bit 7 set. */
+SPU_HOT __m128i spu__qidx(void) { return _mm_setr_epi8(3,2,1,0, 7,6,5,4, 11,10,9,8, 15,14,13,12); }
+/* rotate left by sh (0..15) bytes: s = (i + sh) & 15 */
+SPU_HOT u128 spu__qrot(u128 a, int sh) {
+    const __m128i s = _mm_and_si128(_mm_add_epi8(spu__qidx(), _mm_set1_epi8((char)sh)), _mm_set1_epi8(0x0F));
+    return spu__um(_mm_shuffle_epi8(spu__mi(a), _mm_xor_si128(s, _mm_set1_epi8(3))));
+}
+/* shift left by sh (0..31) bytes: s = i + sh, 0 when s > 15 */
+SPU_HOT u128 spu__qshl(u128 a, int sh) {
+    const __m128i s = _mm_add_epi8(spu__qidx(), _mm_set1_epi8((char)sh));
+    const __m128i c = _mm_or_si128(_mm_xor_si128(s, _mm_set1_epi8(3)), _mm_cmpgt_epi8(s, _mm_set1_epi8(15)));
+    return spu__um(_mm_shuffle_epi8(spu__mi(a), c));
+}
+/* shift right by sh (0..31) bytes: s = i - sh, 0 when s < 0 (bit 7 set) */
+SPU_HOT u128 spu__qshr(u128 a, int sh) {
+    const __m128i s = _mm_sub_epi8(spu__qidx(), _mm_set1_epi8((char)sh));
+    return spu__um(_mm_shuffle_epi8(spu__mi(a), _mm_xor_si128(s, _mm_set1_epi8(3))));
+}
+#endif
