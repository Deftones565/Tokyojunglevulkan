             rsx_dsp_get_texture(&g.rsx, u, &t);
             fprintf(s_pd.draws_log, " t%u %u:0x%08X f%02X %ux%u", u, t.location, t.offset,
                     t.format & 0xFFu, t.width, t.height);
+            /* Each sampled texture's guest bytes, once per address, as
+             * <dir>/tex_L_ADDR_fFF_WxH_pPITCH.bin (RSX_ENGINE_PASS_DUMP_TEX=1). */
+            static int dump_tex = -1;
+            if (dump_tex < 0) dump_tex = getenv("RSX_ENGINE_PASS_DUMP_TEX") != NULL;
+            if (dump_tex) {
+                static u32 done[256]; static u32 n_done;
+                int seen = 0;
+                for (u32 k = 0; k < n_done; k++) if (done[k] == (t.offset ^ (t.location << 31))) seen = 1;
+                const u32 span = eng_texture_span(t.format, t.width, t.height, t.mipmaps,
+                                                  t.pitch, (int)t.cubemap);
+                const u8* src = (!seen && span) ? eng_guest_ptr(NULL, t.location, t.offset, span) : NULL;
+                if (src && n_done < 256) {
+                    done[n_done++] = t.offset ^ (t.location << 31);
+                    char path[1200];
+                    snprintf(path, sizeof path, "%s/tex_%u_%08X_f%02X_%ux%u_p%u.bin", s_pd.dir,
+                             t.location, t.offset, t.format & 0xFFu, t.width, t.height, t.pitch);
+                    FILE* tf = fopen(path, "wb");
+                    if (tf) { fwrite(src, 1, span, tf); fclose(tf); }
+                }
+            }
         }
         fprintf(s_pd.draws_log, "\n");
     }
