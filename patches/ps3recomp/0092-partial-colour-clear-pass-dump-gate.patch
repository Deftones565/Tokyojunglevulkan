# CLEAR_SURFACE names R, G, B and A on their own: a clear of only some keeps the
# others (readback, set, write back). Clearing all four painted Tokyo Jungle's
# pause-menu map panel white (user-confirmed fixed 2026-10-19). Diagnostics:
# RSX_ENGINE_PASS_DUMP_GATE=<file> starts the pass dump when <file> appears;
# RSX_ENGINE_PASS_DUMP_TEX=1 saves each sampled texture's guest bytes.
diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index fce37e9..e968988 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -2473,6 +2473,18 @@ static int pd_capturing(void)
     if (s_pd.state == 1 && s_pd.after_s &&
         difftime(time(NULL), s_pd.start) >= (double)s_pd.after_s && pd_open_index())
         fprintf(s_pd.index, "from a draw of frame %u, %u s in\n", g.frames, s_pd.after_s);
+    /* RSX_ENGINE_PASS_DUMP_GATE=<file>: start at the first frame where <file>
+     * exists, so a screen the player opens at any time (a pause menu) can be
+     * captured: create the file once it is up. Checked once a frame. */
+    { static const char* gate = (const char*)-1; static u32 checked = ~0u;
+      if (gate == (const char*)-1) gate = getenv("RSX_ENGINE_PASS_DUMP_GATE");
+      if (s_pd.state == 1 && gate && checked != g.frames) {
+          checked = g.frames;
+          FILE* gf = fopen(gate, "rb");
+          if (gf) { fclose(gf);
+                    if (pd_open_index())
+                        fprintf(s_pd.index, "from a draw of frame %u, gate file %s\n", g.frames, gate); }
+      } }
     return s_pd.state == 2;
 }
 
