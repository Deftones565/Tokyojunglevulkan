diff --git a/runtime/spu/spu_drain.c b/runtime/spu/spu_drain.c
index 931d3b3..01e6eed 100644
--- a/runtime/spu/spu_drain.c
+++ b/runtime/spu/spu_drain.c
@@ -57,8 +57,14 @@ unsigned spu_recent_pcs(uint32_t* out, unsigned max)
     return k;
 }
 
+int g_spu_launch_slow = -1;
+
 void spu_task_launch_check(spu_context* ctx, void* fn)
 {
+    if (g_spu_launch_slow < 0)   /* any switch that needs every hop: never skip */
+        g_spu_launch_slow = (getenv("SPU_NO_LS0_END") || getenv("SPU_EXITTRACE") ||
+                             getenv("SPU_STEPTRACE") || getenv("SPU_JOBDRAIN") ||
+                             getenv("SPURS_PM_FLOW")) ? 1 : 0;
     t_recent[t_recent_n++ & 31] = (uint32_t)ctx->pc & SPU_LS_MASK;
     extern void spu_check_stack_reset(spu_context*, void (*)(spu_context*));
     spu_check_stack_reset(ctx, (void (*)(spu_context*))fn);
@@ -344,9 +350,12 @@ void spu_depth_guard(spu_context* ctx)
     /* Ring of recent drain sites. When the depth trips, the useful question is
      * not "where are we" but "what cycle got us here" -- one pc names a point,
      * a ring names the loop. */
+    /* Per thread: one ring every SPU thread wrote kept its cache line moving
+     * between cores on every drain (~2% of gameplay CPU). The report below
+     * prints the tripping thread's own ring, which is the cycle it is in. */
     enum { RING = 24 };
-    static uint32_t s_ring[RING];
-    static uint32_t s_n;
+    static SPU_THREAD_LOCAL uint32_t s_ring[RING];
+    static SPU_THREAD_LOCAL uint32_t s_n;
     s_ring[s_n % RING] = ((uint32_t)ctx->pc & SPU_LS_MASK);
     s_n++;
 
