 {
     static int en = -1;
@@ -933,8 +953,9 @@ static inline void spu_pchist_tick(const spu_context* ctx)
             }                                                              \
             void (*_tf)(spu_context*) = g_spu_trampoline_fn;    \
             g_spu_trampoline_fn = 0;                            \
-            yz_lockstep_tick(ctx);                             \
-            spu_task_launch_check((ctx), (void*)_tf);          \
+            if (g_yz_lockstep_on) yz_lockstep_tick(ctx);       \
+            if (spu_task_launch_fast(ctx)) (ctx)->steps++;     \
+            else spu_task_launch_check((ctx), (void*)_tf);     \
             if ((ctx)->int_enable &&                            \
