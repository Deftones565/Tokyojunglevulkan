diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
index 7ff8329..c3ce218 100644
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -838,6 +838,20 @@ extern SPU_THREAD_LOCAL void (*g_spu_trampoline_fn)(spu_context*);
 /* Ring of the last PCs this SPU thread executed, for the unlifted-branch
  * report. The dispatcher records indirect branches; SPU_DRAIN records every
  * trampoline hop, which is the one that actually precedes a bad branch. */
+/* Per-hop dispatch fast path (SPU_DRAIN). Every hop of every SPU job called
+ * yz_lockstep_tick and spu_task_launch_check out of line -- ~14% of gameplay
+ * CPU in Tokyo Jungle's busy areas with their neighbours -- though almost all
+ * of their work is diagnostics that are off. A hop skips the check when it
+ * cannot do anything: not a branch to LS 0 (a job's end), not a policy module,
+ * no stack-reset entry registered, no trace switched on
+ * (g_spu_launch_slow, set by the first full call). It still counts the step,
+ * which the LS-0 test reads. The lockstep tick is skipped while lockstep is
+ * off (g_yz_lockstep_on 0; -1 = not decided yet, so it is called). */
+extern volatile int g_yz_lockstep_on;
+extern int          g_spu_launch_slow;           /* -1 unknown, 0 fast ok, 1 always full */
+extern volatile unsigned g_spu_stack_reset_n;
+static inline int spu_task_launch_fast(const struct spu_context* ctx);
+
 extern SPU_THREAD_LOCAL uint32_t g_spu_pch[8];
 extern SPU_THREAD_LOCAL unsigned g_spu_pch_n;
 
@@ -878,6 +892,12 @@ void spu_drain_call(spu_context* ctx, uint32_t return_pc);
  *
  * Extents from the .symtab embedded in ps1_netemu (firmware file offset
  * 0x171100), so they are exact rather than guessed. */
+static inline int spu_task_launch_fast(const spu_context* ctx)
+{
+    return g_spu_launch_slow == 0 && (ctx->pc & SPU_LS_MASK) != 0 &&
+           !ctx->policy_mode && g_spu_stack_reset_n == 0;
+}
+
