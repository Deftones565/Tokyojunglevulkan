+/* One send/recv on the connection, through TLS if it has it. >0: bytes
+ * moved. 0 from io_recv: the peer closed. -1: try again once the socket is
+ * ready for *want (POLLIN or POLLOUT). -2: the connection is broken. */
+static int io_send(psnr_client* c, const uint8_t* p, size_t n, short* want)
+{
+#ifdef PSNR_HAVE_OPENSSL
+    if (c->ssl) {
+        int k = SSL_write(c->ssl, p, (int)n);
+        if (k > 0) return k;
+        switch (SSL_get_error(c->ssl, k)) {
+        case SSL_ERROR_WANT_WRITE: *want = POLLOUT; return -1;
+        case SSL_ERROR_WANT_READ:  *want = POLLIN;  return -1;
+        default: return -2;
+        }
+    }
+#endif
+    {
+        int k = send(c->s, (const char*)p, (int)n, 0);
+        if (k >= 0) return k;
+        *want = POLLOUT;
+        return WOULD_BLOCK() ? -1 : -2;
+    }
+}
+
+static int io_recv(psnr_client* c, uint8_t* p, size_t n)
+{
+#ifdef PSNR_HAVE_OPENSSL
+    if (c->ssl) {
+        int k = SSL_read(c->ssl, p, (int)n);
+        if (k > 0) return k;
+        switch (SSL_get_error(c->ssl, k)) {
+        case SSL_ERROR_WANT_READ: case SSL_ERROR_WANT_WRITE: return -1;
+        case SSL_ERROR_ZERO_RETURN: return 0;
+        default: return -2;
+        }
+    }
+#endif
+    {
+        int k = recv(c->s, (char*)p, (int)n, 0);
+        if (k >= 0) return k;
+        return WOULD_BLOCK() ? -1 : -2;
+    }
+}
