+/* 64 hex digits (whitespace around them allowed) into 32 bytes. */
+static int hex32(const char* in, uint8_t out[32])
+{
+    while (*in && isspace((unsigned char)*in)) in++;
+    for (int i = 0; i < 32; i++) {
+        unsigned v;
+        if (!isxdigit((unsigned char)in[0]) || !isxdigit((unsigned char)in[1]) ||
+            sscanf(in, "%2x", &v) != 1)
+            return 0;
+        out[i] = (uint8_t)v;
+        in += 2;
+    }
+    while (*in && isspace((unsigned char)*in)) in++;
+    return *in == 0;
+}
+
+/* PSNR_TLS (default 1), PSNR_CERT_SHA256 and PSNR_KEY / PSNR_KEY_FILE
+ * (environment) into psnr_set_security. 0 if one is malformed, or if the
+ * key would go out unencrypted to anything but this machine. */
+static int setup_security(const char* host)
+{
+    const char* tls = getenv("PSNR_TLS");
+    const char* pin_hex = getenv("PSNR_CERT_SHA256");
+    const char* key_hex = getenv("PSNR_KEY");
+    const char* key_file = getenv("PSNR_KEY_FILE");
+    uint8_t pin[32], key[32];
+    char buf[160] = {0};
+    int have_pin = 0, have_key = 0;
+
+    if (pin_hex && *pin_hex) {
+        if (!hex32(pin_hex, pin)) { printf("[psnr] PSNR_CERT_SHA256 must be 64 hex digits\n"); return 0; }
+        have_pin = 1;
+    }
+    if ((!key_hex || !*key_hex) && key_file && *key_file) {
+        FILE* f = fopen(key_file, "r");
+        if (!f) { printf("[psnr] can't read PSNR_KEY_FILE %s\n", key_file); return 0; }
+        (void)fread(buf, 1, sizeof(buf) - 1, f);
+        fclose(f);
+        key_hex = buf;
+    }
+    if (key_hex && *key_hex) {
+        if (!hex32(key_hex, key)) { printf("[psnr] the player key must be 64 hex digits\n"); return 0; }
+        have_key = 1;
+    }
+    memset(buf, 0, sizeof(buf));
+    int use_tls = !(tls && strcmp(tls, "0") == 0);
+    if (!use_tls && have_key && strcmp(host, "127.0.0.1") != 0 && strcmp(host, "localhost") != 0) {
+        printf("[psnr] PSNR_TLS=0 would send the player key to %s unencrypted; refusing. "
+               "Plain TCP is for a test server on this machine only\n", host);
+        memset(key, 0, sizeof(key));
+        return 0;
+    }
+    psnr_set_security(use_tls, have_pin ? pin : NULL, have_key ? key : NULL);
+    memset(key, 0, sizeof(key));
+    return 1;
+}
