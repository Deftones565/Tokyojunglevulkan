 {
     if (g.tex_staging_cap >= bytes) return 1;
@@ -1270,10 +1367,15 @@ static u32 eng_texture_slot(u32 location, u32 offset, u32 fmt, u32 w, u32 h,
             e->cubemap != (u32)(cube != 0))
             continue;
         if (e->handle && e->last_hash_frame != g.frames) {
+            e->last_hash_frame = g.frames;
+            const int written = eng_ww_changed(eng_guest_ptr(NULL, location, offset, span),
+                                               span, &e->ww_stamp);
+            if (written < 0) s_ww_unknown++;
+            if (!written) { s_ww_skipped++; goto hit; }
+            s_ww_hashed++;
             int readable = 0;
             const u64 hash = eng_texture_content_hash(location, offset, span,
                                                       &readable);
-            e->last_hash_frame = g.frames;
             if (readable && hash != e->content_hash) {
                 const u32 fresh = eng_texture_upload(location, offset, fmt, w, h,
                                                      levels, pitch, cube, remap);
@@ -1284,6 +1386,7 @@ static u32 eng_texture_slot(u32 location, u32 offset, u32 fmt, u32 w, u32 h,
                 }
             }
         }
+    hit:
         e->last_use_serial = ++g.texture_use_serial;
         return e->handle;
     }
@@ -1307,6 +1410,7 @@ static u32 eng_texture_slot(u32 location, u32 offset, u32 fmt, u32 w, u32 h,
     e.remap = remap; e.cubemap = (u32)(cube != 0);
     e.last_hash_frame = g.frames;
     e.last_use_serial = ++g.texture_use_serial;
+    (void)eng_ww_changed(eng_guest_ptr(NULL, location, offset, span), span, &e.ww_stamp);
     { int readable = 0;
       e.content_hash = eng_texture_content_hash(location, offset, span, &readable); }
     e.handle = eng_texture_upload(location, offset, fmt, w, h, levels, pitch,
@@ -1333,8 +1437,10 @@ static void eng_textures_touch(u32 location, u32 offset, u32 bytes)
 {
     for (u32 i = 0; i < g.n_textures; i++) {
         eng_texture* e = &g.textures[i];
-        if (e->location == location && e->offset >= offset && e->offset - offset < bytes)
+        if (e->location == location && e->offset >= offset && e->offset - offset < bytes) {
             e->last_hash_frame = g.frames - 1u;
+            e->ww_stamp = ~0ull;                      /* hash it, written or not */
+        }
     }
 }
 
@@ -3088,6 +3194,14 @@ static void eng_present(u32 buffer_id)
     g.last_present_surface = target;
     g.be->present(g.be->user, g.surfaces[target].handle);
     g.frames++;
+    { static int st = -1;                         /* RSX_TEX_WW_STATS=1 (diag) */
+      if (st < 0) st = getenv("RSX_TEX_WW_STATS") ? 1 : 0;
+      if (st && g.frames % 600u == 0) {
+          fprintf(stderr, "[rsx engine] tex write watch: %llu skipped, %llu hashed, %llu unknown\n",
+                  (unsigned long long)s_ww_skipped, (unsigned long long)s_ww_hashed,
+                  (unsigned long long)s_ww_unknown);
+          s_ww_skipped = s_ww_hashed = s_ww_unknown = 0;
+      } }
     g.last_guest_draws = g.guest_draws;
     g.guest_draws = 0;
 }
