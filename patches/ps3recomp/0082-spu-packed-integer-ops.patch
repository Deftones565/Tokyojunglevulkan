  * word1<<32, but SPU's MS half is word0<<32 | word1), so native shifts on them
  * corrupt any bits crossing a 32-bit boundary. Assemble the logical hi/lo halves
  * with _u32[0] as most-significant, shift, then disassemble. */
+#ifdef SPU_SIMD_X86
+/* Carry bits across guest words, not host uint64 halves. SSE shifts by 32
+ * produce zero, which also makes count zero an exact identity. */
+SPU_HOT u128 spu__qbit_left(u128 a, unsigned sh, int rotate) {
+    const __m128i v=spu__mi(a);
+    const __m128i next=rotate ? _mm_shuffle_epi32(v, _MM_SHUFFLE(0,3,2,1)) : _mm_srli_si128(v,4);
+    return spu__um(_mm_or_si128(_mm_sll_epi32(v,_mm_cvtsi32_si128(sh)),
+                               _mm_srl_epi32(next,_mm_cvtsi32_si128(32-sh))));
+}
+SPU_HOT u128 spu__qbit_right(u128 a, unsigned sh) {
+    const __m128i v=spu__mi(a);
+    return spu__um(_mm_or_si128(_mm_srl_epi32(v,_mm_cvtsi32_si128(sh)),
+                               _mm_sll_epi32(_mm_slli_si128(v,4),_mm_cvtsi32_si128(32-sh))));
+}
+#endif
