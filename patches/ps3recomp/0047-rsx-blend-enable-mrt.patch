diff --color -ru a/libs/video/rsx_draw_engine.h b/libs/video/rsx_draw_engine.h
--- a/libs/video/rsx_draw_engine.h	2026-10-15 16:14:55.801262995 +0400
+++ b/libs/video/rsx_draw_engine.h	2026-10-15 16:14:55.797508249 +0400
@@ -76,6 +76,11 @@
 typedef struct rsx_be_render_state {
     u32 alpha_test_enable, alpha_func, alpha_ref_raw, alpha_ref_format;
     u32 blend_enable, sf_rgb, df_rgb, sf_a, df_a, eq_rgb, eq_a;
+    /* BLEND_ENABLE_MRT bits 1..3: whether targets B, C and D blend too.
+     * BLEND_ENABLE governs target A only; an MRT member whose bit is clear
+     * is written straight (Tokyo Jungle's bright-pass in target B is
+     * overwritten every frame while target A accumulates). */
+    u32 blend_mrt;
     u32 depth_test, depth_write, depth_func;
     u32 cull_enable, cull_face, front_face;
     u32 color_mask;
