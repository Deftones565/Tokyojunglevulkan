  * (taken right after it reads `put`), s_drain_caught_seq is the number of the
  * last pass that ended with the walker at that `put`. */
 static volatile u32 s_drain_seq, s_drain_caught_seq;
+/* Wake-ups around cellGcm_rsx_wait_consumed (the main PPU thread waits there
+ * before every job chain; 40% of its time in Tokyo Jungle's busy areas):
+ * s_caught_cv when a pass catches up, s_waiter_cv when a waiter arrives, which
+ * cellGcm_drain_nap (the frame clock's nap) ends on. Both used to be polls --
+ * usleep(100) on one side, a 250 us nap on the other -- each overshooting on
+ * Linux, and they added up on every wait. */
+static SRWLOCK            s_caught_lock = SRWLOCK_INIT;
+static CONDITION_VARIABLE s_caught_cv   = CONDITION_VARIABLE_INIT;
+static volatile int       s_drain_waiter_arrived;
+#ifndef _WIN32
+#include <pthread.h>
+#include <time.h>
+/* Microsecond nap for the frame clock (the SRW wrapper only does whole ms). */
+static pthread_mutex_t s_nap_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  s_nap_cv = PTHREAD_COND_INITIALIZER;
+#endif
 
 
 /* Kick event: a game thread whose fence wait finds the queue DRY signals the
@@ -1813,6 +1829,25 @@ void cellGcm_rsx_process_fifo(void)
  * the main PPU thread spent 62% of gameplay here while the drain thread idled
  * 42%). GCM_RSX_WAKE=0 turns the early wake off. */
 static volatile int s_rsx_waiters;
+/* The frame clock's nap between polls: up to `us` microseconds, ending at
+ * once when a guest thread starts waiting on the drain. */
+void cellGcm_drain_nap(unsigned us)
+{
+#ifndef _WIN32
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_nsec += (long)us * 1000L;
+    if (ts.tv_nsec >= 1000000000L) { ts.tv_sec += ts.tv_nsec / 1000000000L; ts.tv_nsec %= 1000000000L; }
+    pthread_mutex_lock(&s_nap_mu);
+    if (!s_drain_waiter_arrived)
+        pthread_cond_timedwait(&s_nap_cv, &s_nap_mu, &ts);
+    s_drain_waiter_arrived = 0;
+    pthread_mutex_unlock(&s_nap_mu);
+#else
+    Sleep(us >= 1000 ? us / 1000 : 1);
+#endif
+}
+
 int cellGcm_rsx_waiters(void)
 {
     static int on = -1;
@@ -1832,15 +1867,20 @@ int cellGcm_rsx_wait_consumed(unsigned timeout_ms)
