+#ifndef _WIN32
+    pthread_mutex_lock(&s_nap_mu);                     /* wake the frame clock now */
+    s_drain_waiter_arrived = 1;
+    pthread_cond_signal(&s_nap_cv);
+    pthread_mutex_unlock(&s_nap_mu);
+#endif
     int ok;
     for (;;) {
         if ((s32)(__atomic_load_n(&s_drain_caught_seq, __ATOMIC_ACQUIRE) - seq0) > 0) { ok = 1; break; }
         if (ps3_ms_now() - t0 >= timeout_ms) { ok = 0; break; }
-#ifdef _WIN32
-        Sleep(0);
-#else
-        usleep(100);
-#endif
+        AcquireSRWLockExclusive(&s_caught_lock);
+        if ((s32)(__atomic_load_n(&s_drain_caught_seq, __ATOMIC_ACQUIRE) - seq0) <= 0)
+            SleepConditionVariableSRW(&s_caught_cv, &s_caught_lock, 1, 0);
+        ReleaseSRWLockExclusive(&s_caught_lock);
     }
     __atomic_sub_fetch(&s_rsx_waiters, 1, __ATOMIC_ACQ_REL);
     if (stats) {
@@ -2462,8 +2502,12 @@ static void gcm_rsx_process_fifo_unlocked(void)
     { static int eq = -1;
       if (eq < 0) { const char* e = getenv("GCM_GET_EQ_PUT"); eq = e ? atoi(e) : 0; }
       vm_write32(GCM_CONTROL_GUEST_ADDR + 4, eq ? put : s_fifo_getoff); }
-    if (s_fifo_getoff == put)
+    if (s_fifo_getoff == put) {
         __atomic_store_n(&s_drain_caught_seq, drain_seq, __ATOMIC_RELEASE);
+        AcquireSRWLockExclusive(&s_caught_lock);       /* no lost wake-up */
+        ReleaseSRWLockExclusive(&s_caught_lock);
+        WakeAllConditionVariable(&s_caught_cv);
+    }
 
     AcquireSRWLockExclusive(&s_ref_pub_lock);                           /* ref */
     gcm_ref_publish_one();
