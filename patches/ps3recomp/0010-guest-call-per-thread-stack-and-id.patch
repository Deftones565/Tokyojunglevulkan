+/* Guest stack and thread identity for a callback run by ppu_guest_call/_ct.
+ *
+ * Every host thread used to start its callbacks at one fixed address,
+ * 0xCFFE0000 (inside RSX local memory), and every host-only thread ran them as
+ * thread 0x7FFF0000. Two threads calling back at once (the GCM ticker and an
+ * HLE worker) then shared their frames, and every owner-tracking primitive saw
+ * one thread. Each host thread now takes its own stack from the thread-stack
+ * allocator the first time it calls back (sys_ppu_thread.c), and each host-only
+ * thread its own id. A callback nested inside another on the same thread starts
+ * below the outer one's live frame instead of on top of it. */
+extern "C" uint32_t ppu_thread_alloc_callback_stack(uint32_t size);
+
+static PPU_THREAD_LOCAL uint32_t s_cb_lo = 0, s_cb_hi = 0;
+static PPU_THREAD_LOCAL uint64_t s_cb_host_tid = 0;
+
+static uint32_t cb_stack_pointer(void)
+{
+    if (!s_cb_hi) {
+        const uint32_t size = 0x80000;
+        uint32_t base = ppu_thread_alloc_callback_stack(size);
+        if (!base) {
+            fprintf(stderr, "[ppu] guest_call: the guest stack region is exhausted\n");
+            abort();
+        }
+        s_cb_lo = base;
+        s_cb_hi = base + size;
+    }
+    if (g_active_ctx) {
+        uint32_t sp = (uint32_t)g_active_ctx->gpr[1];
+        if (sp > s_cb_lo + 0x10000u && sp <= s_cb_hi)
+            return (sp - 0x400u) & ~0xFu;
+    }
+    return s_cb_hi - 0x100u;
+}
+
+static uint64_t cb_thread_id(void)
+{
+    if (g_active_ctx) return g_active_ctx->thread_id;
+    if (!s_cb_host_tid) {
+        static LONG n = 0;
+        s_cb_host_tid = 0x7FFF0000ull | ((uint32_t)InterlockedIncrement(&n) & 0xFFFFu);
+    }
+    return s_cb_host_tid;
+}
