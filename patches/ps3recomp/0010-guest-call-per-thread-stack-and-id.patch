+/* A guest stack for a host thread that calls into guest code through
+ * ppu_guest_call (the GCM ticker, HLE worker threads, synchronous HLE
+ * callbacks). Same allocator and lock as sys_ppu_thread_create, so it is a
+ * real stack in the 0xD0000000 region that never overlaps a thread's.
+ * Returns the stack's lowest address, or 0 when the region is exhausted. */
+uint32_t ppu_thread_alloc_callback_stack(uint32_t size)
+{
+    table_lock();
+    uint32_t base = vm_stack_allocate(&g_vm_stack_alloc, size);
+    table_unlock();
+    return base;
+}
