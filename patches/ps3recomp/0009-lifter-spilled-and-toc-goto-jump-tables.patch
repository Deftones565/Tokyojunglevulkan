+def _toc_goto_target(win, rC, read_u32, toc, func_ranges, bctr_addr):
+    """Target of a TOC-slot goto (see discover_jump_tables), or None.
+
+    Walks `win` backward from the bctr: the nearest definition of rC must be
+    `lwz/ld rC,d(r2)`, optionally through `clrldi rC,rC,32` (the 64-bit zero
+    extension SN puts between the load and the mtctr). The slot's value counts
+    only when it is a word-aligned address inside the function that holds the
+    bctr; without function bounds there is nothing to check it against."""
+    if not func_ranges:
+        return None
+    reg = rC
+    for w in reversed(win):
+        a = [x.strip() for x in w.operands.split(',')]
+        if not a or a[0] != reg or w.mnemonic.startswith(('st', 'lf', 'mt', 'cmp')):
+            continue                    # these read reg, they do not define it
+        if a[1:] in ([reg, '32'], [reg, '0', '32']) and w.mnemonic in ('clrldi', 'rldicl'):
+            continue                    # zero-extends in place (ppu_disasm prints rldicl); keep walking
+        if w.mnemonic not in ('lwz', 'ld') or len(a) != 2 or '(r2)' not in a[1]:
+            return None
+        try:
+            disp = int(a[1].split('(')[0].strip(), 0)
+        except ValueError:
+            return None
+        lo = hi = None
+        for s, e in func_ranges:
+            if s <= bctr_addr < e and (lo is None or s > lo):
+                lo, hi = s, e
+        if lo is None:
+            return None
+        for t in (toc if isinstance(toc, (list, tuple)) else [toc]):
+            if not t:
+                continue
+            ea = (t + disp) & 0xFFFFFFFF
+            v = read_u32(ea)
+            if v is not None and w.mnemonic == 'ld':
+                v = read_u32((ea + 4) & 0xFFFFFFFF) if v == 0 else None
+            if v is not None and lo <= v < hi and v % 4 == 0:
+                return v
+        return None
+    return None
+
