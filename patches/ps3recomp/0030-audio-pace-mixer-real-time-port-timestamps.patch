+#define AUDIO_STAMP_RING    256
+#define AUDIO_BLOCK_US(n)   ((u64)(n) * CELL_AUDIO_BLOCK_SAMPLES * 1000000ULL / CELL_AUDIO_SAMPLE_RATE)
 
