+        {   /* Never step backwards: a clock base taken from these must not jump. */
+            u64 t = now_us;
+            if (port->read_index) {
+                const u64 prev = port->stamp_us[(port->read_index - 1) % AUDIO_STAMP_RING];
+                if (t <= prev) t = prev + 1;
+            }
+            port->stamp_us[port->read_index % AUDIO_STAMP_RING] = t;
+        }
