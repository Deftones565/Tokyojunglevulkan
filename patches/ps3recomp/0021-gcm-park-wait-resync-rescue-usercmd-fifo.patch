     vm_write32(GCM_CONTROL_GUEST_ADDR + 4, get);
     s_fifo_getoff  = get;
     s_fifo_calloff = 0;
+    s_jump_src     = GCM_NO_OFF;
+    s_park_io      = GCM_NO_OFF;
 }
