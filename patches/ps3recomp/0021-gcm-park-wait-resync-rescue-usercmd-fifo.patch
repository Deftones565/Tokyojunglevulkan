             g_ps3_guest_caller(s_user_handler_opd, (uint64_t)cmd, 0, 0, 0, 0, 0, 0, 0);
     }
@@ -797,6 +834,12 @@ static u32 gcm_ea2io(u32 ea);   /* defined with the wrap callback below */
 static u32 s_fifo_getoff  = 0;
 static u32 s_last_ring_off = 0;   /* last offset the walker actually consumed */
 static u32 s_fifo_calloff = 0;
+/* Source of the last JUMP the walker took, and the park it is waiting on --
+ * see the JUMP-to-self case in the walker. */
+#define GCM_NO_OFF 0xFFFFFFFFu
+static u32 s_jump_src = GCM_NO_OFF;
+static u32 s_park_io = GCM_NO_OFF, s_park_word;
+static unsigned long long s_park_t0;
 
 /* ---------------------------------------------------------------------------
  * 2D transfer engines (FIFO subchannels != 0).
@@ -1328,6 +1371,28 @@ static u32 gcm_spu_block_for_put(u32 put)
  *
  * Dropping DRAWS on a resync is survivable: a frame is lost. Dropping a FENCE
  * is not, it deadlocks the title. Sweep the skipped range first. */
+/* A resync is about to skip the method header `w` at `io`. Publish what
+ * a title can block on: a SET_REFERENCE fence (returns 1, the caller counts
+ * them), or a SET_USER_COMMAND, raised as the walker would have. Tokyo
+ * Jungle's main loop spins until its user-command handler has run, so
+ * skipping one deadlocks it exactly as a lost fence does. */
+static unsigned gcm_rescue_at(u32 io, u32 w)
+{
+    if ((w >> 29) != 0) return 0;
+    u32 dea = gcm_io2ea(io + 4); if (!dea) return 0;
+    if ((w & 0xFFFCu) == 0xEB00u) {
+        extern void rsx_raise_user_cmd(u32 arg);
+        rsx_raise_user_cmd(vm_read32(dea));
+        { static int m = 0; if (m++ < 8)
+            fprintf(stderr, "[cellGcmSys] resync rescued user command 0x%08X"
+                    " at 0x%08X\n", vm_read32(dea), io); }
+        return 0;
+    }
+    if ((w & 0x1FFCu) != 0x0050u) return 0;
+    gcm_ref_push_at(vm_read32(dea), io);
+    return 1;
+}
+
 static void gcm_fifo_resync_why(const char* why, u32* getoff, u32 put)
 {
     static int n = 0;
@@ -1354,17 +1419,87 @@ static void gcm_fifo_resync_why(const char* why, u32* getoff, u32 put)
         unsigned rescued = 0;
         for (u32 io = from; io + 8 <= land; io += 4) {
             u32 ea = gcm_io2ea(io); if (!ea) continue;
-            u32 w = vm_read32(ea);
-            if ((w >> 29) != 0 || (w & 0x1FFCu) != 0x0050u) continue;
-            u32 dea = gcm_io2ea(io + 4); if (!dea) continue;
-            gcm_ref_push_at(vm_read32(dea), io);
-            rescued++;
+            rescued += gcm_rescue_at(io, vm_read32(ea));
         }
         if (rescued) { static int m = 0; if (m++ < 8)
             fprintf(stderr, "[cellGcmSys] resync rescued %u fence(s) from"
                     " 0x%08X..0x%08X\n", rescued, from, land); }
+    } else if (from > land) {
+        /* The ring wrapped between the last consumed offset and `put`: the
+         * skipped commands run from `from` to the ring's wrap JUMP, then from
+         * its target up to `land`. A word-by-word scan cannot tell that JUMP
+         * from a float in some method's data, so walk the stream by its
+         * headers instead -- method data is skipped by count, CALLs are not
+         * entered, and only a backward JUMP that lands at or before `land`
+         * counts as the wrap. Bounded, so a misread header cannot run away. */
+        unsigned rescued = 0;
+        int wrapped = 0;
+        u32 io = from;
+        for (u32 steps = 0; steps < 0x40000u; steps++) {
+            if (wrapped && io >= land) break;
+            u32 ea = gcm_io2ea(io); if (!ea) break;
+            u32 w = vm_read32(ea);
+            if ((w >> 29) == 1) {                          /* JUMP */
+                u32 tgt = w & 0x1FFFFFFCu;
+                if (wrapped || tgt >= io || tgt > land) break;
+                wrapped = 1; io = tgt; continue;
+            }
+            if ((w & 3u) == 2u || w == 0x00020000u || w == 0) { io += 4; continue; }
+            rescued += gcm_rescue_at(io, w);
+            io += 4 + ((w >> 18) & 0x7FFu) * 4;
+        }
+        if (rescued) { static int m = 0; if (m++ < 8)
+            fprintf(stderr, "[cellGcmSys] resync rescued %u fence(s) across the ring"
+                    " wrap 0x%08X..0x%08X\n", rescued, from, land); }
     }
     *getoff = land;
+    s_jump_src = GCM_NO_OFF;
+    s_park_io  = GCM_NO_OFF;
+}
+
+/* The walker is parked on a JUMP to itself at `park` (word `w`) and the title
+ * has moved `put` elsewhere. Two titles do this for opposite reasons:
+ *
+ *   - Twisted Metal abandons a park at the write head of one segment and moves
+ *     on to its other segment; it only patches a park when it reuses that
+ *     block. Waiting there would freeze the FIFO, so the walker resyncs.
+ *
+ *   - Tokyo Jungle JUMPs from its main ring into one of four per-frame
+ *     segments, the PPU writes a short header and a park, and an SPU job is
+ *     meant to fill in the frame's draws and patch the park so the GPU returns
+ *     to the ring, where `put` already is. The RSX sits on that park until it
+ *     is patched; resyncing drops the whole frame.
+ *
+ * The second kind is told apart by how the walker got here: the JUMP into
+ * this segment came from the same 1 MB IO block `put` is in, i.e. the title
+ * has queued more work behind the jump and expects the GPU to come back.
+ * (Comparing src < put is not enough: the main ring wraps.) Such a park is
+ * waited on -- the pass stops without consuming it, the next one re-reads the
+ * word -- for at most GCM_PARK_WAIT_MS of wall time, after which it is logged
+ * and resynced as before. Off (0) by default until Tokyo Jungle's segments are
+ * actually patched: waiting on a park nothing writes turns its gameplay into a
+ * stall. Try GCM_PARK_WAIT_MS=500. */
+static int gcm_park_should_wait(u32 park, u32 w, u32 put)
+{
+    static long wait_ms = -1;
+    if (wait_ms < 0) { const char* e = getenv("GCM_PARK_WAIT_MS");
+                       wait_ms = e ? atol(e) : 0; }
+    if (wait_ms <= 0 || s_jump_src == GCM_NO_OFF) return 0;
+    if ((s_jump_src >> 20) != (put >> 20) || (park >> 20) == (put >> 20)) return 0;
+
+    const unsigned long long now = ps3_ms_now();
+    if (park != s_park_io || w != s_park_word) {
+        s_park_io = park; s_park_word = w; s_park_t0 = now;
+        return 1;
+    }
+    if (now - s_park_t0 < (unsigned long long)wait_ms) return 1;
+
+    static unsigned n = 0;
+    if (n++ < 32 || (n % 256) == 0)
+        fprintf(stderr, "[cellGcmSys] park 0x%08X (entered from 0x%08X) unpatched after "
+                "%llu ms -- resync to put 0x%08X (#%u)\n",
+                park, s_jump_src, now - s_park_t0, put, n);
+    return 0;
 }
 
