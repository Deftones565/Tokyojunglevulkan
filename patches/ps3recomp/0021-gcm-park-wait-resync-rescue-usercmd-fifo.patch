-    GCM_USER_PENDING_STORE(0);
+    gcm_ucmd_clear();
 
     memset(s_display_buffers, 0, sizeof(s_display_buffers));
     memset(s_display_buffer_set, 0, sizeof(s_display_buffer_set));
@@ -3369,13 +3510,13 @@ void cellGcmSetUserCommand(u32 cmd)
     GCM_USER_STORE(cmd);
 }
 
