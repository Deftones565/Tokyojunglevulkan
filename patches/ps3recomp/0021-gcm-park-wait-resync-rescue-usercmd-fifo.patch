+static atomic_flag s_ucmd_lock = ATOMIC_FLAG_INIT;
+#define GCM_UCMD_LOCK()   while (atomic_flag_test_and_set_explicit(&s_ucmd_lock, memory_order_acquire)) {}
+#define GCM_UCMD_UNLOCK() atomic_flag_clear_explicit(&s_ucmd_lock, memory_order_release)
 #endif
 
+/* Retired SET_USER_COMMANDs waiting for the pump, oldest first. Each one is
+ * its own interrupt, as lv2 posts one event per 0xEB00 to the gcm interrupt
+ * thread; a single "latest cause" slot loses all but the last when two retire
+ * before a pump -- Tokyo Jungle queues 0xF5AAC0DE and 0x00086300 each frame
+ * and spins until the first one's handler has run. The pump pops one per
+ * call, at the point it claims its vblank/flip work, so a cause published
+ * from inside a callback waits for the next pump instead of jumping ahead. */
+#define GCM_UCMD_Q 16u
+static u32 s_ucmd_q[GCM_UCMD_Q];
+static u32 s_ucmd_head, s_ucmd_tail;
+
+static void gcm_ucmd_push(u32 cmd)
+{
+    int dropped = 0;
+    GCM_UCMD_LOCK();
+    if (s_ucmd_tail - s_ucmd_head >= GCM_UCMD_Q) { s_ucmd_head++; dropped = 1; }
+    s_ucmd_q[s_ucmd_tail++ % GCM_UCMD_Q] = cmd;
+    GCM_UCMD_UNLOCK();
+    if (dropped) { static int n = 0; if (n++ < 8)
+        fprintf(stderr, "[cellGcmSys] user-command queue full (%u): oldest dropped\n",
+                GCM_UCMD_Q); }
+}
+
+static int gcm_ucmd_pop(u32* cmd)
+{
+    int have = 0;
+    GCM_UCMD_LOCK();
+    if (s_ucmd_head != s_ucmd_tail) { *cmd = s_ucmd_q[s_ucmd_head++ % GCM_UCMD_Q]; have = 1; }
+    GCM_UCMD_UNLOCK();
+    return have;
+}
+
+static void gcm_ucmd_clear(void)
+{
+    GCM_UCMD_LOCK();
+    s_ucmd_head = s_ucmd_tail = 0;
+    GCM_UCMD_UNLOCK();
+}
+
 /* Tile configuration (up to 15 tiles, 8 commonly used) */
 static CellGcmTileInfo s_tiles[CELL_GCM_MAX_TILE_COUNT];
 
@@ -458,7 +495,7 @@ s32 cellGcmInit(u32 cmdSize, u32 ioSize, u32 ioAddress)
     s_second_v_frequency = 0;
     s_vblank_frequency = 0;
     GCM_USER_STORE(0);
-    GCM_USER_PENDING_STORE(0);
+    gcm_ucmd_clear();
 
     /* Set up the initial IO mapping for the command buffer region */
     if (ioAddress != 0 && ioSize > 0) {
@@ -697,7 +734,8 @@ void ppu_gcm_pump(void)
 {
     if (!GCM_PUMP_TRY_ENTER()) return;
     long p = (long)GCM_PENDING_TAKE();
-    u64 user = GCM_USER_PENDING_TAKE();
+    u32 cmd;
+    const int have_user = gcm_ucmd_pop(&cmd);
     /* GCM_PUMP_DBG=1: how often each guest handler is actually delivered. */
     { static int d = -1; static unsigned nv, nf, calls;
       if (d < 0) d = getenv("GCM_PUMP_DBG") ? 1 : 0;
@@ -717,8 +755,7 @@ void ppu_gcm_pump(void)
             g_ps3_guest_caller(s_flip_handler_opd, 1, 0, 0, 0, 0, 0, 0, 0);
         }
     }
-    if (user) {
-        u32 cmd = (u32)user;
+    if (have_user) {
