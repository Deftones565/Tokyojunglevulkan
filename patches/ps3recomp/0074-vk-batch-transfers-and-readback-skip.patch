+/* Host R,G,B,A rows <-> guest A,R,G,B pixels: per 32-bit little-endian
+ * word that is a rotate by 8 (identity when the host keeps A,R,G,B order).
+ * Word loops the compiler vectorises; the byte loops were ~10% of the FIFO
+ * thread each way in Tokyo Jungle gameplay (six full-screen 2D copies a
+ * frame). */
+static void eng_rgba_to_guest(u8* dst, const u8* src, u32 n, int rgba)
+{
+    if (rgba) { memcpy(dst, src, (size_t)n * 4u); return; }
+    for (u32 c = 0; c < n; c++) {
+        u32 v; memcpy(&v, src + 4u * c, 4);
+        v = (v << 8) | (v >> 24);
+        memcpy(dst + 4u * c, &v, 4);
+    }
+}
+
+static void eng_guest_to_rgba(u8* dst, const u8* src, u32 n, int rgba)
+{
+    if (rgba) { memcpy(dst, src, (size_t)n * 4u); return; }
+    for (u32 c = 0; c < n; c++) {
+        u32 v; memcpy(&v, src + 4u * c, 4);
+        v = (v >> 8) | (v << 24);
+        memcpy(dst + 4u * c, &v, 4);
+    }
