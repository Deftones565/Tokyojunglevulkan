                 ctx.gpr[3]._u32[0], ctx.gpr[3]._u32[1], ctx.gpr[3]._u32[2], ctx.gpr[3]._u32[3],
@@ -307,7 +308,7 @@ static inline int32_t spu_run_lifted_job_abi(spu_lifted_entry_fn entry,
