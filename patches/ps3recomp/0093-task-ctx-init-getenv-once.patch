# SPU task runs: clear everything but the local store when the caller copies
# the thread's 256 KB in anyway (a redundant 256 KB memset per task run, ~10%
# CPU in busy areas); dispatch-path getenv() calls cached (SPU_GETENV_ONCE).
# Headless A/B, same street, nothing else running: 55.3 -> 57.3 flips/s.
diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
index 7ff740f..7ff8329 100644
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -12,6 +12,7 @@
 
 #include "../../include/ps3emu/ps3types.h"
 #include <stdint.h>
+#include <stddef.h>   /* offsetof */
 #include <string.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -424,6 +425,29 @@ static inline void spu_context_init(spu_context* ctx, uint32_t spu_id)
     ctx->status = SPU_STATUS_STOPPED;
 }
 
+/* spu_context_init for a context whose local store the caller is about to
+ * overwrite whole (a task run copying its thread's 256 KB in): clears every
+ * field but the local store. The result after the copy is the same as a full
+ * init and the copy; it saves a 256 KB memset per task run, which was ~10% of
+ * gameplay CPU in Tokyo Jungle's busier areas. */
+static inline void spu_context_init_except_ls(spu_context* ctx, uint32_t spu_id)
+{
+    const size_t ls_begin = offsetof(spu_context, ls_store);
+    const size_t ls_end   = ls_begin + SPU_LS_SIZE;
+    memset(ctx, 0, ls_begin);
+    memset((uint8_t*)ctx + ls_end, 0, sizeof(*ctx) - ls_end);
+    ctx->ls     = ctx->ls_store;
+    ctx->spu_id = spu_id;
+    ctx->status = SPU_STATUS_STOPPED;
+}
+
+/* getenv() looked up once per call site: the SPU dispatch paths test a dozen
+ * diagnostic switches on every task run, and each getenv scans the whole
+ * environment. Nothing changes them while the game runs. */
+#define SPU_GETENV_ONCE(name) \
+    ({ static const char* _spu_env = (const char*)-1; \
+       if (_spu_env == (const char*)-1) _spu_env = getenv(name); _spu_env; })
+
 /* Set r1 the way the SPU ABI defines it: word 0 is the stack pointer, word 1
  * the number of bytes of stack still available below it. Code built with
  * stack checking subtracts every frame from all four words (ai r1,r1,-N) and
