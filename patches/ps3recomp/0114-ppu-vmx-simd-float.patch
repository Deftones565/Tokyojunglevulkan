+/* test_ppu_vmx_simd.c -- the SSE4.1 + FMA versions of vaddfp, vsubfp,
+ * vmaddfp and vnmsubfp (ppu_vmx.h, VMX_SIMD) against the scalar reference
+ * vmx_ref_*, bit for bit, with VSCR[NJ] on and off.
+ *
+ *   cc -O2 -msse4.1 -mfma -ffp-contract=off -I runtime/ppu \
+ *      runtime/ppu/tests/test_ppu_vmx_simd.c -lm -o /tmp/t && /tmp/t [millions]
+ *
+ * Operands mix uniform random words with the cases that matter: +-0,
+ * denormals, +-inf, quiet and signalling NaNs with payloads, values near
+ * 1.0 (so a*c - b cancels to an exact zero), and pairs built so that
+ * a*c == b exactly. Exits 1 on the first mismatch, printing it. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include "ppu_vmx.h"
+
+#ifndef VMX_SIMD
+#error "build with -msse4.1 -mfma: nothing to compare otherwise"
+#endif
+
+static uint64_t s = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { s ^= s << 13; s ^= s >> 7; s ^= s << 17; return (uint32_t)(s >> 16); }
+
+static uint32_t special(void)
+{
+    static const uint32_t k[] = {
+        0x00000000u, 0x80000000u, 0x00000001u, 0x807FFFFFu, 0x00400000u, 0x80000010u,
+        0x7F800000u, 0xFF800000u, 0x7FC00000u, 0xFFC00000u, 0x7F800001u, 0xFFBFFFFFu,
+        0x7FA12345u, 0x3F800000u, 0xBF800000u, 0x3F800001u, 0x3F7FFFFFu, 0x00800000u,
+        0x80800000u, 0x7F7FFFFFu, 0xFF7FFFFFu, 0x40000000u, 0x34000000u, 0x0C000000u,
+    };
+    return k[rnd() % (sizeof k / sizeof k[0])];
+}
+
+static uint32_t operand(void)
+{
+    switch (rnd() & 7) {
+    case 0: case 1: return special();
+    case 2: return (rnd() & 0x807FFFFFu);                               /* denormal / zero */
+    case 3: return (rnd() & 0x80FFFFFFu) | 0x3F000000u;                 /* near 1 */
+    default: return rnd();
+    }
+}
+
+static void put(uint8_t* v, int i, uint32_t x) { vmx_sw(v, i, x); }
+
+static int check(const char* op, const uint8_t* a, const uint8_t* b, const uint8_t* c,
+                 const uint8_t* want, const uint8_t* got, uint32_t vscr)
+{
+    if (!memcmp(want, got, 16)) return 0;
+    for (int i = 0; i < 4; i++)
+        if (vmx_w(want, i) != vmx_w(got, i)) {
+            fprintf(stderr, "MISMATCH %s lane %d vscr %08X: a %08X b %08X c %08X -> ref %08X simd %08X\n",
+                    op, i, vscr, vmx_w(a, i), vmx_w(b, i), c ? vmx_w(c, i) : 0, vmx_w(want, i), vmx_w(got, i));
+        }
+    return 1;
+}
+
+int main(int argc, char** argv)
+{
+    const long n = (argc > 1 ? atol(argv[1]) : 50) * 1000000L;
+    uint8_t a[16], b[16], c[16], w[16], g[16];
+    long cases = 0;
+    for (long it = 0; it < n; it++) {
+        for (int i = 0; i < 4; i++) { put(a, i, operand()); put(b, i, operand()); put(c, i, operand()); }
+        if ((it & 15) == 0) {                     /* b = a*c exactly (small mantissas) */
+            for (int i = 0; i < 4; i++) {
+                float x = (float)(int)(rnd() % 4096 - 2048) * 0.25f, z = (float)(int)(rnd() % 4096 - 2048);
+                put(a, i, vmx_u(x)); put(c, i, vmx_u(z)); put(b, i, vmx_u(x * z));
+            }
+        }
+        const uint32_t vscr = (it & 1) ? VMX_NJ : 0;
+        vmx_ref_vaddfp(w, a, b, vscr);  vmx_vaddfp(g, a, b, vscr);
+        if (check("vaddfp", a, b, NULL, w, g, vscr)) return 1;
+        vmx_ref_vsubfp(w, a, b, vscr);  vmx_vsubfp(g, a, b, vscr);
+        if (check("vsubfp", a, b, NULL, w, g, vscr)) return 1;
+        vmx_ref_vmaddfp(w, a, b, c, vscr);  vmx_vmaddfp(g, a, b, c, vscr);
+        if (check("vmaddfp", a, b, c, w, g, vscr)) return 1;
+        vmx_ref_vnmsubfp(w, a, b, c, vscr);  vmx_vnmsubfp(g, a, b, c, vscr);
+        if (check("vnmsubfp", a, b, c, w, g, vscr)) return 1;
+        /* aliasing: the destination is a source, as the lifter emits */
+        memcpy(w, a, 16); memcpy(g, a, 16);
+        vmx_ref_vmaddfp(w, w, b, c, vscr); vmx_vmaddfp(g, g, b, c, vscr);
+        if (check("vmaddfp(d=a)", a, b, c, w, g, vscr)) return 1;
+        cases += 5;
+    }
+    printf("test_ppu_vmx_simd: %ld vector ops (%ld lanes), 0 mismatches\n", cases, cases * 4);
+    return 0;
+}
