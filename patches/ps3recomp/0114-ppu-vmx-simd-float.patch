+    return _mm_shuffle_epi8(_mm_loadu_si128((const __m128i*)p),
+                            _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12));
+}
+VMX_INL void vmx_s_st(void* p, __m128i v) {
+    _mm_storeu_si128((__m128i*)p, _mm_shuffle_epi8(v,
+                     _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12)));
+}
+/* vmx_flush: exponent 0 -> keep only the sign */
+VMX_INL __m128i vmx_s_flush(__m128i x, uint32_t vscr) {
+    if (!(vscr & VMX_NJ)) return x;
+    const __m128i den = _mm_cmpeq_epi32(_mm_and_si128(x, _mm_set1_epi32(0x7F800000)), _mm_setzero_si128());
+    return _mm_blendv_epi8(x, _mm_and_si128(x, _mm_set1_epi32((int)0x80000000u)), den);
+}
+VMX_INL __m128i vmx_s_isnan(__m128i x) {
+    return _mm_cmpgt_epi32(_mm_and_si128(x, _mm_set1_epi32(0x7FFFFFFF)), _mm_set1_epi32(0x7F800000));
+}
+/* vmx_fix: a NaN result becomes the default QNaN */
+VMX_INL __m128i vmx_s_fix(__m128i z) {
+    return _mm_blendv_epi8(z, _mm_set1_epi32(0x7FC00000), vmx_s_isnan(z));
+}
+/* vmx_vnan2: A's NaN (quieted), else B's, else the fixed result */
+VMX_INL __m128i vmx_s_nan2(__m128i z, __m128i x, __m128i y) {
+    const __m128i q = _mm_set1_epi32(0x7FC00000);
+    z = vmx_s_fix(z);
+    z = _mm_blendv_epi8(z, _mm_or_si128(y, q), vmx_s_isnan(y));
+    return _mm_blendv_epi8(z, _mm_or_si128(x, q), vmx_s_isnan(x));
+}
+#define VMX_SFBIN(name, op) \
+VMX_INL void name(VMX_D, VMX_A, VMX_B, uint32_t vscr) { \
+    const __m128i x = vmx_s_flush(vmx_s_ld(a_), vscr), y = vmx_s_flush(vmx_s_ld(b_), vscr); \
