                 gcm_set_current_display_buffer(w & 7u);
                 s_flip_pending = 1;
                 s_flip_request_count++;
+                /* The flip resets the RSX register state, as RPCS3's
+                 * GCM_FLIP_COMMAND handler does (RSX::reset). Titles start
+                 * their next frame from the defaults; Tokyo Jungle's world
+                 * pass depends on DEPTH_MASK being 1 again. GCM_FLIP_RESET=0
+                 * keeps the old carry-over behaviour. */
+                { static int on = -1;
+                  if (on < 0) { const char* e = getenv("GCM_FLIP_RESET"); on = e ? atoi(e) : 1; }
+                  if (on) rsx_draw_engine_reset_state(); }
             } else {
                 cellGcmSetFlipCommand(w & 0xFFu);
             }
