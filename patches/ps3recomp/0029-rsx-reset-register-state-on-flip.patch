+void rsx_dispatch_reset_state(rsx_dispatch* rsx)
+{
+    for (u32 i = 0; i < sizeof k_rsx_flip_reset / sizeof k_rsx_flip_reset[0]; i++)
+        rsx->regs[k_rsx_flip_reset[i].method >> 2] = k_rsx_flip_reset[i].value;
+}
