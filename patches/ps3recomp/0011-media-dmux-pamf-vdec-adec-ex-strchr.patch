+        const u32 out = GUEST_EA(outBuffer);
+        if (out) memcpy(vm_base + out, vm_base + slot + ADEC_Q_PCM_OFF, vm_read32(slot + PCMITEM_SIZE));
+        a->qHead = (a->qHead + 1) % a->slots;
