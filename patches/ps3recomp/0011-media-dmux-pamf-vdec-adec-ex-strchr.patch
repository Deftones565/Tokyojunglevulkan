     u32 auCount;        /* total AUs decoded */
+    /* Decoder path (libavcodec AC3): decoded frames wait in a queue of
+     * PCM items laid out in the caller's work memory (Open's resource). */
+    AdecFf* ff;
+    u32 workEa, slots;
+    u32 qHead, qCount, newPcm;
+    u8  wordSize;       /* AC3 param: 0 int16, 1 float */
+    u8  outputMode;     /* AC3 param: 1 = 1/0 (mono), 2 = 2/0, ... 7 = 3/2 */
+    u8  lfeOn;          /* AC3 param: append the LFE channel */
+    u8  chanPtr[6];     /* AC3 param: output channel k carries input chanPtr[k] */
+    u32 curAu;          /* guest EA of the AU being decoded */
+    u64 lastPts;        /* PTS of the last PCM item, for AUs that carry none */
 } AdecSlot;
 
+/* One queued PCM item: [0x000 CellAdecPcmItem][0x040 CellAdecBsiAc3]
+ * [0x100 samples], sized for one AC3 frame (1536 samples) of 5.1 float. */
+#define ADEC_Q_SLOT      0x9100u
+#define ADEC_Q_PCM_OFF   0x100u
+#define ADEC_Q_BSI_OFF   0x40u
+#define ADEC_Q_MAX       16u
+
 static AdecSlot s_adec[MAX_ADEC];
 
 /* Fire one guest callback.
@@ -106,6 +125,123 @@ static void adec_notify(CellAdecHandle handle, u32 msg_type, s32 msg_data)
                        (u64)(s64)msg_data, (u64)a->cbArg, 0, 0, 0, 0);
 }
 
+/* ---------------------------------------------------------------------------
+ * Decoder path: one decoded frame -> one queued PCM item
+ * -----------------------------------------------------------------------*/
+
+/* AC3 bit rates in kbit/s by frmsizecod >> 1 (ATSC A/52). */
+static const u16 k_ac3_kbps[19] = { 32, 40, 48, 56, 64, 80, 96, 112, 128, 160,
+                                    192, 224, 256, 320, 384, 448, 512, 576, 640 };
+
+/* Full-bandwidth channels per AC3 output mode (acmod numbering): 1/0 C,
+ * 2/0 L R, 3/0 L C R, 2/1 L R s, 3/1 L C R s, 2/2 L R l r, 3/2 L C R l r. */
+static const u8 k_mode_channels[8] = { 2, 1, 2, 3, 3, 4, 4, 5 };
+
+/* The decoder's input channels in AC3 order (L, C, R, l, r, s = LFE) taken
+ * from FFmpeg's native order (FL FR FC LFE BL BR FLC FRC BC SL SR); a
+ * channel the stream does not carry reads as silence. */
+static float ac3_input(const AdecFfFrame* f, int i, int which)
+{
+    static const signed char k_bits[6][2] = {
+        { 0, -1 }, { 2, -1 }, { 1, -1 }, { 9, 4 }, { 10, 5 }, { 3, -1 } };
+    if (!f->mask) {                       /* unknown layout: take them in order */
+        return which < f->channels ? f->plane[which][i] : 0.0f;
+    }
+    for (int alt = 0; alt < 2; alt++) {
+        const int bit = k_bits[which][alt];
+        if (bit < 0 || !(f->mask & (1ull << bit))) continue;
+        int c = 0;
+        for (int b = 0; b < bit; b++) if (f->mask & (1ull << b)) c++;
+        return f->plane[c][i];
+    }
+    if (f->channels == 1 && which == 1) return f->plane[0][i];   /* mono = C */
+    return 0.0f;
+}
+
+static void adec_on_frame(void* ctx, const AdecFfFrame* f)
+{
+    AdecSlot* a = (AdecSlot*)ctx;
+    if (a->qCount >= a->slots) {
+        printf("[cellAdec] PCM queue full; dropping a frame\n");
+        return;
+    }
+    const u32 idx  = (a->qHead + a->qCount) % a->slots;
+    const u32 slot = a->workEa + idx * ADEC_Q_SLOT;
+    const u32 pcm  = slot + ADEC_Q_PCM_OFF, bsi = slot + ADEC_Q_BSI_OFF;
+    const int full = k_mode_channels[a->outputMode & 7];
+    const int nch  = full + (a->lfeOn ? 1 : 0);
+    const u32 bps  = a->wordSize ? 4u : 2u;
+    int n = f->samples;
+    if ((u32)n * nch * bps > ADEC_Q_SLOT - ADEC_Q_PCM_OFF)
+        n = (int)((ADEC_Q_SLOT - ADEC_Q_PCM_OFF) / (nch * bps));
+    u8* o = vm_base + pcm;
+    for (int i = 0; i < n; i++) {
+        for (int c = 0; c < nch; c++) {
+            float v = ac3_input(f, i, a->chanPtr[c]);
+            if (v > 1.0f) v = 1.0f; else if (v < -1.0f) v = -1.0f;
+            if (a->wordSize) {
+                u32 bits; memcpy(&bits, &v, 4);
+                o[0] = (u8)(bits >> 24); o[1] = (u8)(bits >> 16);
+                o[2] = (u8)(bits >> 8);  o[3] = (u8)bits; o += 4;
+            } else {
+                s16 s16v = (s16)(v * 32767.0f);
+                o[0] = (u8)((u16)s16v >> 8); o[1] = (u8)s16v; o += 2;
+            }
+        }
+    }
+    const u32 bytes = (u32)n * nch * bps;
+
+    /* CellAdecBsiAc3: what was decoded, from the AU's sync frame header. */
+    const u32 au = a->curAu, au_start = vm_read32(au + 0x00), au_size = vm_read32(au + 0x04);
+    const u8* h = vm_base + au_start;
+    for (u32 k = 0; k < 0x50; k += 4) vm_write32(bsi + k, 0);
+    vm_write32(bsi + 0x00, CELL_ADEC_TYPE_AC3);
+    vm_write32(bsi + 0x0C, a->auCount + 1);              /* totalCallNum */
+    if (au_size >= 7 && h[0] == 0x0B && h[1] == 0x77) {
+        const u8 fscod = h[4] >> 6, frm = h[4] & 0x3F;
+        if (frm < 38) vm_write32(bsi + 0x10, k_ac3_kbps[frm >> 1] * 1000u);
+        vm_write8(bsi + 0x23, fscod);                    /* fsIndex */
+        vm_write16(bsi + 0x30, frm);                     /* frmSizeCod */
+        vm_write8(bsi + 0x32, h[6] >> 5);                /* acmod */
+        vm_write8(bsi + 0x3A, h[5] & 7);                 /* bsmod */
+        vm_write8(bsi + 0x3B, h[5] >> 3);                /* bsid */
+    }
+    vm_write32(bsi + 0x14, bytes);                       /* pcmSize */
+    vm_write32(bsi + 0x18, au_size * 8);                 /* esSizeBit */
+    vm_write8(bsi + 0x21, 1);                            /* validity */
+    vm_write8(bsi + 0x22, (u8)nch);                      /* channelValue */
+    vm_write8(bsi + 0x24, a->wordSize);                  /* outputQuantization */
+    vm_write8(bsi + 0x25, a->outputMode);                /* outputChannel */
+    vm_write8(bsi + 0x26, nch == 1);                     /* monoFlag */
+
+    /* CellAdecPcmItem, echoing the AU it came from */
+    vm_write32(slot + PCMITEM_PCM_HANDLE, idx);
+    vm_write32(slot + PCMITEM_STATUS, 0);
+    vm_write32(slot + PCMITEM_START_ADDR, pcm);
+    vm_write32(slot + PCMITEM_SIZE, bytes);
+    vm_write32(slot + PCMITEM_BSI_INFO, bsi);
+    vm_write32(slot + PCMITEM_AU_START, au_start);
+    vm_write32(slot + PCMITEM_AU_SIZE, au_size);
+    /* An AU without a timestamp continues from the previous frame, the way
+     * the firmware decoder corrects it: one frame of samples at 90 kHz
+     * (2880 for a 1536-sample AC3 frame at 48 kHz). The movie player builds
+     * its audio clock from these, and an all-invalid run never starts it. */
+    u64 pts = ((u64)vm_read32(au + 0x08) << 32) | vm_read32(au + 0x0C);
+    if (pts == ~0ull && a->lastPts != ~0ull && f->rate > 0)
+        pts = a->lastPts + (u64)f->samples * 90000u / (u32)f->rate;
+    a->lastPts = pts;
+    vm_write32(slot + PCMITEM_AU_PTS_HI, (u32)(pts >> 32));
+    vm_write32(slot + PCMITEM_AU_PTS_LO, (u32)pts);
+    vm_write32(slot + PCMITEM_AU_USERDATA, vm_read32(au + 0x10));
+    vm_write32(slot + PCMITEM_AU_USERDATA + 4, vm_read32(au + 0x14));
+
+    a->qCount++;
+    a->newPcm++;
+    { static int k = 0;
+      if (k++ < 3) printf("[cellAdec] AC3 frame: %d ch %d Hz %d samples -> %u bytes\n",
+                          f->channels, f->rate, f->samples, bytes); }
+}
+
 /* ---------------------------------------------------------------------------
  * API implementations
  * -----------------------------------------------------------------------*/
@@ -163,6 +299,19 @@ s32 cellAdecOpen(const CellAdecType* type, const CellAdecResource* res,
              * once already. */
             s_adec[i].itemEa = ADEC_ITEM_EA(i);
             s_adec[i].pcmEa  = ADEC_PCM_EA(i);
+            /* CellAdecResource and ...ResourceEx both start
