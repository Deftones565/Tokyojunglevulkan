+    u32 x1 = x0 + 1 < pw ? x0 + 1 : x0, y1 = y0 + 1 < ph ? y0 + 1 : y0;
+    u32 ax = (fx >> 8) & 0xFF, ay = (fy >> 8) & 0xFF;
+    int top = p[y0 * stride + x0] * (256 - ax) + p[y0 * stride + x1] * ax;
+    int bot = p[y1 * stride + x0] * (256 - ax) + p[y1 * stride + x1] * ax;
+    return (top * (256 - ay) + bot * ay + (1 << 15)) >> 16;
+}
+
+/* Coordinate of output pixel `o` in an input of `in` pixels, 16.16, centre-
+ * aligned and clamped to the last sample. */
+static inline u32 map_coord(u32 o, u32 in, u32 out)
 {
-    (void)inPicBuf; (void)outPicBuf;
-    if (handle >= CELL_VPOST_HANDLE_MAX || !s_handles[handle].in_use)
-        return (s32)CELL_VPOST_ERROR_HANDLE_NOT_FOUND;
-    if (!picInfo || !ctrlParam)
-        return (s32)CELL_VPOST_ERROR_INVALID_ARGUMENT;
-
-    /* Stub: no actual processing — just return success.
-       A real impl would do color conversion / scaling here. */
+    if (out <= 1 || in <= 1) return 0;
+    long long v = ((long long)(2 * o + 1) * in * 65536 / (2 * out)) - 32768;
+    long long hi = (long long)(in - 1) << 16;
+    return (u32)(v < 0 ? 0 : v > hi ? hi : v);
+}
+
+s32 cellVpostExec(u32 handle, const void* inPicBuff, const void* ctrlParam,
+                  void* outPicBuff, void* picInfo)
+{
+    if (handle == 0 || handle > VPOST_MAX || !s_vpost[handle - 1].in_use)
+        return (s32)CELL_VPOST_ERROR_E_ARG_HDL_INVALID;
+    const u32 in = ea_of(inPicBuff), ctl = ea_of(ctrlParam);
+    const u32 out = ea_of(outPicBuff), info = ea_of(picInfo);
+    if (!in)   return (s32)CELL_VPOST_ERROR_E_ARG_INPICBUF_NULL;
+    if (!ctl)  return (s32)CELL_VPOST_ERROR_E_ARG_CTRL_NULL;
+    if (!out)  return (s32)CELL_VPOST_ERROR_E_ARG_OUTPICBUF_NULL;
+    if (!info) return (s32)CELL_VPOST_ERROR_E_ARG_PICINFO_NULL;
+
+    const u32 w  = vm_read32(ctl + 0x0C), h  = vm_read32(ctl + 0x10);
+    const s32 chroma = (s32)vm_read32(ctl + 0x14);
+    const s32 quant  = (s32)vm_read32(ctl + 0x18);   /* 0 full, 1 broadcast */
+    const s32 matrix = (s32)vm_read32(ctl + 0x1C);   /* 0 BT.601, 1 BT.709 */
+    const u32 ow = vm_read32(ctl + 0x30), oh = vm_read32(ctl + 0x34);
+    const u8  alpha  = vm_read8(ctl + 0x48);
+    const u64 user   = vm_read64(ctl + 0x50);
+    const s32 fmt    = s_vpost[handle - 1].outPicFmt;
+    if (!w || !h || !ow || !oh || (w & 1) || (h & 1))
+        return (s32)CELL_VPOST_ERROR_E_ARG_CTRL_INVALID;
+
+    const u8* Y = vm_base + in;
+    const u8* U = Y + w * h;
+    const u8* V = U + (w / 2) * (h / 2);
+    u8* dst = vm_base + out;
+
+    if (fmt == CELL_VPOST_PIC_FMT_OUT_YUV420_PLANAR) {
+        u8* dY = dst; u8* dU = dY + ow * oh; u8* dV = dU + (ow / 2) * (oh / 2);
+        for (u32 y = 0; y < oh; y++)
+            for (u32 x = 0; x < ow; x++)
+                dY[y * ow + x] = (u8)sample(Y, w, h, w, map_coord(x, w, ow), map_coord(y, h, oh));
+        for (u32 y = 0; y < oh / 2; y++)
+            for (u32 x = 0; x < ow / 2; x++) {
+                u32 fx = map_coord(x, w / 2, ow / 2), fy = map_coord(y, h / 2, oh / 2);
+                dU[y * (ow / 2) + x] = (u8)sample(U, w / 2, h / 2, w / 2, fx, fy);
+                dV[y * (ow / 2) + x] = (u8)sample(V, w / 2, h / 2, w / 2, fx, fy);
+            }
+    } else {
+        /* YCbCr -> RGB in 8.8 fixed point. Broadcast range expands Y from
+         * 16..235 and chroma from 16..240; full range uses them as they are. */
+        const int bt709 = matrix == 1;
+        const int crv = bt709 ? 403 : 359, cbu = bt709 ? 475 : 454;
+        const int cgu = bt709 ? 48 : 88,   cgv = bt709 ? 120 : 183;
+        const int ys  = quant == 1 ? 298 : 256, yo = quant == 1 ? 16 : 0;
+        const int cs  = quant == 1 ? 292 : 256;   /* 255/224 for chroma */
+        for (u32 y = 0; y < oh; y++) {
+            const u32 fy  = map_coord(y, h, oh);
+            const u32 fcy = map_coord(y, h / 2, oh);
+            u8* row = dst + (size_t)y * ow * 4;
+            for (u32 x = 0; x < ow; x++) {
+                const u32 fx = map_coord(x, w, ow);
+                /* chroma position type A sits between luma columns, B on them */
+                const u32 fcx = chroma == 1 ? fx / 2 : map_coord(x, w / 2, ow);
+                int yy = (sample(Y, w, h, w, fx, fy) - yo) * ys >> 8;
+                int u  = ((sample(U, w / 2, h / 2, w / 2, fcx, fcy) - 128) * cs) >> 8;
+                int v  = ((sample(V, w / 2, h / 2, w / 2, fcx, fcy) - 128) * cs) >> 8;
+                row[x * 4 + 0] = clamp8(yy + ((crv * v) >> 8));
+                row[x * 4 + 1] = clamp8(yy - ((cgu * u + cgv * v) >> 8));
+                row[x * 4 + 2] = clamp8(yy + ((cbu * u) >> 8));
+                row[x * 4 + 3] = alpha;
+            }
+        }
+    }
+
+    /* What was done: the input as described, the output in the configured
+     * format, progressive frame in and out. */
+    vm_write32(info + 0x00, w);
+    vm_write32(info + 0x04, h);
+    vm_write32(info + 0x08, 0);           /* depth 8 */
+    vm_write32(info + 0x0C, 0);           /* progressive */
+    vm_write32(info + 0x10, 0);           /* YUV420 planar */
+    vm_write32(info + 0x14, (u32)chroma);
+    vm_write32(info + 0x18, 0);           /* frame */
+    vm_write32(info + 0x1C, (u32)quant);
+    vm_write32(info + 0x20, (u32)matrix);
+    vm_write32(info + 0x24, ow);
+    vm_write32(info + 0x28, oh);
+    vm_write32(info + 0x2C, 0);
+    vm_write32(info + 0x30, 0);
+    vm_write32(info + 0x34, (u32)fmt);
+    vm_write32(info + 0x38, (u32)chroma);
+    vm_write32(info + 0x3C, 0);
+    vm_write32(info + 0x40, (u32)quant);
+    vm_write32(info + 0x44, (u32)matrix);
+    vm_write64(info + 0x48, user);
+    vm_write32(info + 0x50, 0);
+    vm_write32(info + 0x54, 0);
+
+    { static int n = 0;
+      if (n++ < 3)
+          printf("[cellVpost] Exec(%u): %ux%u -> %ux%u fmt=%d matrix=%d range=%d\n",
+                 handle, w, h, ow, oh, fmt, matrix, quant); }
     return CELL_OK;
 }
