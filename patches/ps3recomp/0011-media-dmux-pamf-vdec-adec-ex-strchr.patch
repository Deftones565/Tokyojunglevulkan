diff --git a/libs/codec/cellDmux.c b/libs/codec/cellDmux.c
index b055385..605489d 100644
--- a/libs/codec/cellDmux.c
+++ b/libs/codec/cellDmux.c
@@ -1,290 +1,1010 @@
 /*
- * ps3recomp - cellDmux HLE implementation
+ * ps3recomp - cellDmux HLE: PAMF (MPEG-2 program stream) demultiplexer
  *
- * Stub demuxer that accepts PAMF data and reports AU-found callbacks.
- * Without real MPEG-TS parsing, this provides the API surface games
- * expect while the video pipeline is built out.
+ * What the firmware does, natively: libdmux plus libdmuxpamf take a buffer of
+ * MPEG-2 program stream packs, pull the enabled elementary streams out of
+ * their PES packets, cut each stream into access units (AUs), and hand every
+ * AU to the caller through its ES callback. The caller takes AUs with
+ * GetAu/PeekAu and gives their memory back with ReleaseAu, oldest first.
+ *
+ * It is asynchronous on the console, and callers depend on that: SetStream
+ * returns at once, and AU_FOUND / DEMUX_DONE / FLUSH_DONE arrive later from
+ * the demuxer's own thread. libsail reacts to DEMUX_DONE by feeding the next
+ * chunk, so doing the work inside SetStream would recurse once per chunk.
+ * Each demuxer therefore runs one host worker thread, which calls the guest
+ * callbacks through g_ps3_guest_caller (its own guest stack and thread id,
+ * patch 0010).
+ *
+ * Where things live:
+ *   - demuxer handle = the 16-byte-aligned start of the caller's demuxer
+ *     memory; its first 0x10 bytes hold the CellDmuxMsg passed to callbacks.
+ *   - ES handle = the 16-byte-aligned start of the caller's ES memory, laid
+ *     out as [msg 0x10][AU info slots][AU specific-info slots][AU data ring].
+ *     The AU info and data the caller reads via GetAu are in that guest
+ *     memory; all bookkeeping is host-side, keyed by those addresses.
+ *
+ * AU framing follows libdmuxpamf (behaviour per RPCS3's cellDmuxPamf, written
+ * from scratch here): MPEG-2 video AUs run from a picture start code or a
+ * sequence header to the next one of those (a sequence end code stays in the
+ * AU it ends); AVC AUs are split at access unit delimiters; AC3 AUs are whole
+ * sync frames (0x0B77, size from fscod/frmsizecod). Audio in private stream 1
+ * carries a 4-byte sub-stream header that is not part of the AU. A PES
+ * packet's PTS/DTS belongs to the first AU that begins in its payload.
+ *
+ * LPCM, ATRAC3plus and user-data streams are accepted by EnableEs but not cut
+ * into AUs yet: no title here plays them. Their packets are skipped.
  */
 
 #include "cellDmux.h"
+#include "ps3emu/guest_call.h"
+#include "../../runtime/ppu/ppu_memory.h"
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
-#include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
-#include "../guest_struct.h"   /* GUEST_EA, guest_struct_load/store */
+
+#ifdef _WIN32
+  #include <windows.h>
+  #include <process.h>
+  typedef HANDLE dmx_thread_t;
+  typedef CRITICAL_SECTION dmx_mutex_t;
+  typedef CONDITION_VARIABLE dmx_cond_t;
+  #define dmx_mutex_init(m)   InitializeCriticalSection(m)
+  #define dmx_mutex_lock(m)   EnterCriticalSection(m)
+  #define dmx_mutex_unlock(m) LeaveCriticalSection(m)
+  #define dmx_mutex_fini(m)   DeleteCriticalSection(m)
+  #define dmx_cond_init(c)    InitializeConditionVariable(c)
+  #define dmx_cond_wait(c, m) SleepConditionVariableCS(c, m, INFINITE)
+  #define dmx_cond_bcast(c)   WakeAllConditionVariable(c)
+  #define dmx_cond_fini(c)    ((void)0)
+#else
+  #include <pthread.h>
+  typedef pthread_t dmx_thread_t;
+  typedef pthread_mutex_t dmx_mutex_t;
+  typedef pthread_cond_t dmx_cond_t;
+  #define dmx_mutex_init(m)   pthread_mutex_init(m, NULL)
+  #define dmx_mutex_lock(m)   pthread_mutex_lock(m)
+  #define dmx_mutex_unlock(m) pthread_mutex_unlock(m)
+  #define dmx_mutex_fini(m)   pthread_mutex_destroy(m)
+  #define dmx_cond_init(c)    pthread_cond_init(c, NULL)
+  #define dmx_cond_wait(c, m) pthread_cond_wait(c, m)
+  #define dmx_cond_bcast(c)   pthread_cond_broadcast(c)
+  #define dmx_cond_fini(c)    pthread_cond_destroy(c)
+#endif
+
+#define DMUX_MAX          4
+#define DMUX_MAX_ES       8        /* per demuxer; libdmuxpamf allows 64 */
+#define DMUX_VER_UPPER    0x260000u
+#define DMUX_HANDLE_MEM   0x40u    /* what QueryAttr asks for: the msg block */
+#define ES_MSG_SIZE       0x10u
+#define AU_INFO_SIZE      0x28u
+#define AU_INFO_STRIDE    0x30u
+#define AU_SPEC_STRIDE    0x10u
+#define TS_INVALID        0xFFFFFFFFFFFFFFFFull
+
+enum { ES_M2V, ES_AVC, ES_AC3, ES_ATRACX, ES_LPCM, ES_USER, ES_BAD };
+
+/* AU queue depth and buffer sizes per stream kind, as libdmuxpamf sizes them
+ * (titles size their allocators to these numbers). */
+static u32 es_queue_max(int kind) { return kind == ES_LPCM ? 0x100 : 0x40; }
+
+static u32 es_au_max(int kind, u32 m2v_profile_level, u32 avc_level)
+{
+    switch (kind) {
+    case ES_M2V: return m2v_profile_level > 1 ? 0x12a800u : 0x38000u;
+    case ES_AVC:
+        switch (avc_level) {
+        case 21: return 0x12900u;  case 30: return 0x25f80u;
+        case 31: return 0x54600u;  case 32: return 0x78000u;
+        case 41: return 0xc0000u;  default: return 0xcc000u;
+        }
+    case ES_AC3:    return 0xf00u;
+    case ES_ATRACX: return 0x1008u;
+    case ES_USER:   return 0xa0000u;
+    default:        return 0x8000u;
+    }
+}
+
+static u32 es_ring_size(int kind, u32 m2v_profile_level, u32 avc_level)
+{
+    switch (kind) {
+    case ES_M2V: return m2v_profile_level > 1 ? 0x255000u : 0x70000u;
+    case ES_AVC:
+        switch (avc_level) {
+        case 21: return 0xb00c0u;  case 30: return 0x19f2e0u;
+        case 31: return 0x260120u; case 32: return 0x35f6c0u;
+        case 41: return 0x45e870u; default: return 0x46a870u;
+        }
+    case ES_AC3:    return 0xa000u;
+    case ES_ATRACX: return 0x6400u;
+    case ES_USER:   return 0x160000u;
+    default:        return 0x104380u;
+    }
+}
+
+static int es_kind(u32 stream_id, u32 private_id, u32 is_avc)
+{
+    if ((stream_id & 0xf0) == 0xe0) return is_avc ? ES_AVC : ES_M2V;
+    if (stream_id != 0xbd) return ES_BAD;
+    switch (private_id & 0xf0) {
+    case 0x00: return ES_ATRACX;
+    case 0x20: return ES_USER;
+    case 0x30: return ES_AC3;
+    case 0x40: return ES_LPCM;
+    default:   return ES_BAD;
+    }
+}
+
+/* ES memory the caller must provide: the message block, the AU info and
