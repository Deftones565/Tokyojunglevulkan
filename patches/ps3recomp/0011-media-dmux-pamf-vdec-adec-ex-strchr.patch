 }
 
 s32 cellAdecStartSeq(CellAdecHandle handle, void* param)
 {
-    (void)param;
+    if (handle < MAX_ADEC && s_adec[handle].in_use && s_adec[handle].ff) {
+        const u32 p = (u32)(uintptr_t)param;
+        /* CellAdecParamAc3: u8 wordSize @0, outputMode @1, outLfeOn @2,
