+                  printf("[cellAdec] decoding with libavcodec, %u PCM slots at 0x%08X\n",
+                         s_adec[i].slots, s_adec[i].workEa);
+              } }
             vm_write32(handle_ea, (u32)i);
             printf("[cellAdec] Open -> handle=%u item=0x%08X pcm=0x%08X\n",
                    i, s_adec[i].itemEa, s_adec[i].pcmEa);
@@ -172,6 +321,22 @@ s32 cellAdecOpen(const CellAdecType* type, const CellAdecResource* res,
     return (s32)CELL_ADEC_ERROR_BUSY;
 }
 
+/* cellAdecOpenEx / cellAdecOpenExt(type, resourceEx, cb, handle): libsail
+ * opens its decoder with OpenExt. The extended resource only adds SPURS
+ * placement, which a host-side decoder has no use for. Unregistered, the
