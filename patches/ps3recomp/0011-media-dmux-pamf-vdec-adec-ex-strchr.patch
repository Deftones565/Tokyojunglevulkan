+++ b/libs/codec/adec_ffmpeg.c
@@ -0,0 +1,150 @@
+/*
+ * ps3recomp - cellAdec's libavcodec path. See adec_ffmpeg.h.
+ *
+ * Only AC3 for now: it is what PAMF movies carry next to MPEG-2 video. The
+ * ATRAC family has its own decoder in this tree (cellAdecAtrac3p.c).
+ */
+
+#include "adec_ffmpeg.h"
+#include "cellAdec.h"
+
+#ifdef PS3RECOMP_FFMPEG_RUNTIME
+
+#include "ffmpeg_runtime.h"
+#include <libavutil/channel_layout.h>
+#include <libavutil/samplefmt.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct AdecFf {
+    const PS3FFmpeg* ff;
+    AVCodecContext* ctx;
+    AVPacket* pkt;
+    AVFrame* frame;
+    u8* buf;
+    u32 buf_cap;
+    float* conv;               /* planar float copy when FFmpeg's isn't */
+    size_t conv_cap;
+};
+
+AdecFf* adec_ff_open(u32 codec_type)
+{
+    if (codec_type != CELL_ADEC_TYPE_AC3) return NULL;
+    const PS3FFmpeg* ff = ps3_ffmpeg_get();
+    if (!ff) return NULL;
+    const AVCodec* codec = ff->avcodec_find_decoder(AV_CODEC_ID_AC3);
+    if (!codec) {
+        printf("[cellAdec] libavcodec has no AC3 decoder\n");
+        return NULL;
+    }
+    AdecFf* d = (AdecFf*)calloc(1, sizeof *d);
+    if (!d) return NULL;
+    d->ff = ff;
+    d->ctx = ff->avcodec_alloc_context3(codec);
+    d->pkt = ff->av_packet_alloc();
+    d->frame = ff->av_frame_alloc();
+    if (!d->ctx || !d->pkt || !d->frame || ff->avcodec_open2(d->ctx, codec, NULL) < 0) {
+        printf("[cellAdec] could not open the libavcodec AC3 decoder\n");
+        adec_ff_close(d);
+        return NULL;
+    }
+    return d;
+}
+
+void adec_ff_close(AdecFf* d)
+{
+    if (!d) return;
+    if (d->ctx) d->ff->avcodec_free_context(&d->ctx);
+    if (d->pkt) d->ff->av_packet_free(&d->pkt);
+    if (d->frame) d->ff->av_frame_free(&d->frame);
+    free(d->buf);
+    free(d->conv);
+    free(d);
+}
+
+void adec_ff_reset(AdecFf* d)
+{
+    if (d) d->ff->avcodec_flush_buffers(d->ctx);
+}
+
+/* Planar float view of a frame in whatever sample format it came in. */
+static int to_planar_float(AdecFf* d, const AVFrame* f, AdecFfFrame* out)
+{
+    const int nch = f->ch_layout.nb_channels, n = f->nb_samples;
+    if (nch <= 0 || nch > 8 || n <= 0) return 0;
+    out->channels = nch;
+    out->samples = n;
+    out->rate = f->sample_rate;
+    out->mask = f->ch_layout.order == AV_CHANNEL_ORDER_NATIVE ? f->ch_layout.u.mask : 0;
+    if (f->format == AV_SAMPLE_FMT_FLTP) {
+        for (int c = 0; c < nch; c++) out->plane[c] = (const float*)f->extended_data[c];
+        return 1;
+    }
+    size_t need = (size_t)nch * n;
+    if (need > d->conv_cap) {
+        float* nb = (float*)realloc(d->conv, need * sizeof(float));
+        if (!nb) return 0;
+        d->conv = nb; d->conv_cap = need;
+    }
+    for (int c = 0; c < nch; c++) {
+        float* o = d->conv + (size_t)c * n;
+        out->plane[c] = o;
+        for (int i = 0; i < n; i++) {
+            switch (f->format) {
+            case AV_SAMPLE_FMT_FLT:  o[i] = ((const float*)f->data[0])[i * nch + c]; break;
+            case AV_SAMPLE_FMT_S16P: o[i] = ((const int16_t*)f->extended_data[c])[i] / 32768.0f; break;
+            case AV_SAMPLE_FMT_S16:  o[i] = ((const int16_t*)f->data[0])[i * nch + c] / 32768.0f; break;
+            case AV_SAMPLE_FMT_S32P: o[i] = ((const int32_t*)f->extended_data[c])[i] / 2147483648.0f; break;
+            default: return 0;
+            }
+        }
+    }
+    return 1;
+}
+
+static void receive(AdecFf* d, adec_ff_emit_fn emit, void* ctx)
+{
+    for (;;) {
+        AVFrame* f = d->frame;
+        if (d->ff->avcodec_receive_frame(d->ctx, f) < 0) return;
+        AdecFfFrame fr;
+        memset(&fr, 0, sizeof fr);
+        if (to_planar_float(d, f, &fr)) emit(ctx, &fr);
+        d->ff->av_frame_unref(f);
+    }
+}
+
+int adec_ff_decode(AdecFf* d, const u8* au, u32 size, adec_ff_emit_fn emit, void* ctx)
+{
+    if (!size) return 0;
+    if (size + AV_INPUT_BUFFER_PADDING_SIZE > d->buf_cap) {
+        u8* nb = (u8*)realloc(d->buf, size + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!nb) return AVERROR(ENOMEM);
+        d->buf = nb;
+        d->buf_cap = size + AV_INPUT_BUFFER_PADDING_SIZE;
+    }
+    memcpy(d->buf, au, size);
+    memset(d->buf + size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    d->pkt->data = d->buf;
+    d->pkt->size = (int)size;
+    int r = d->ff->avcodec_send_packet(d->ctx, d->pkt);
+    if (r == AVERROR(EAGAIN)) {
+        receive(d, emit, ctx);
+        r = d->ff->avcodec_send_packet(d->ctx, d->pkt);
+    }
+    d->pkt->data = NULL;
+    d->pkt->size = 0;
+    receive(d, emit, ctx);
+    return r < 0 ? r : 0;
+}
+
+#else /* !PS3RECOMP_FFMPEG_RUNTIME */
+
+AdecFf* adec_ff_open(u32 codec_type) { (void)codec_type; return NULL; }
+void adec_ff_close(AdecFf* d) { (void)d; }
+void adec_ff_reset(AdecFf* d) { (void)d; }
+int adec_ff_decode(AdecFf* d, const u8* au, u32 size, adec_ff_emit_fn emit, void* ctx)
+{ (void)d; (void)au; (void)size; (void)emit; (void)ctx; return -1; }
+
+#endif
--- /dev/null
+++ b/libs/codec/adec_ffmpeg.h
@@ -0,0 +1,41 @@
+/*
+ * ps3recomp - cellAdec's libavcodec path (see ffmpeg_runtime.h)
+ *
+ * Decodes one access unit and hands each decoded frame back as planar float
+ * samples in [-1, 1], with the channels identified by an FFmpeg native-order
+ * channel mask. Without PS3RECOMP_FFMPEG_RUNTIME, adec_ff_open returns NULL
+ * and cellAdec keeps its silence-only behaviour.
+ */
+#ifndef PS3RECOMP_ADEC_FFMPEG_H
+#define PS3RECOMP_ADEC_FFMPEG_H
+
+#include "ps3emu/ps3types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct AdecFf AdecFf;
+
+typedef struct {
+    const float* plane[8];     /* one per channel, `samples` long */
+    int channels;
+    int samples;
+    int rate;
+    u64 mask;                  /* FFmpeg native channel mask, 0 if unknown */
+} AdecFfFrame;
+
+typedef void (*adec_ff_emit_fn)(void* ctx, const AdecFfFrame* f);
+
+AdecFf* adec_ff_open(u32 codec_type);
+void    adec_ff_close(AdecFf* d);
+void    adec_ff_reset(AdecFf* d);
+/* Returns 0, or a negative FFmpeg error when the AU did not decode. */
+int     adec_ff_decode(AdecFf* d, const u8* au, u32 size,
+                       adec_ff_emit_fn emit, void* ctx);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_ADEC_FFMPEG_H */
