     printf("[cellAdec] StartSeq(handle=%u)\n", handle);
 
     if (handle >= MAX_ADEC || !s_adec[handle].in_use)
@@ -233,6 +416,21 @@ s32 cellAdecDecodeAu(CellAdecHandle handle, const CellAdecAuInfo* auInfo)
 
     AdecSlot* a = &s_adec[handle];
 
+    if (a->ff) {
+        if (a->qCount >= a->slots)
+            return (s32)CELL_ADEC_ERROR_BUSY;          /* title must take PCM */
+        const u32 au = GUEST_EA(auInfo);
