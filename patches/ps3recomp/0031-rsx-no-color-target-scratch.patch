+/* Bytes per pixel of an NV4097 surface colour format. */
+static u32 eng_surface_bpp(u32 color_format)
+{
+    switch (color_format) {
+    case 9u:                     return 1;   /* B8 */
+    case 1u: case 2u: case 3u:               /* X1R5G5B5 (Z/O), R5G6B5 */
+    case 10u:                    return 2;   /* G8B8 */
+    case 11u:                    return 8;   /* F_W16Z16Y16X16 */
+    case 12u:                    return 16;  /* F_W32Z32Y32X32 */
+    default:                     return 4;   /* 8-bit RGBA family, F_X32 */
+    }
+}
