SPU shufb in host byte order: no byte swaps, C itself as the special-selector mask

Applies on top of 0058. The SSE spu_shufb swapped a, b, c into SPU byte order
and the result back (4 pshufb) and built the special-selector masks with three
and/cmpeq pairs; result and control are already at matching host bytes (SPU
byte t = host t^3), so only the source index needs ^3. Checked against
spu_shufb_ref by tools/spu-bisect/xf-harness/shufb_harness.c (every control
byte value in every position + 20M random vectors, gcc and clang: 0 mismatches).

--- a/runtime/spu/spu_helpers.h
+++ b/runtime/spu/spu_helpers.h
@@ -263,21 +263,25 @@
 #include <smmintrin.h>
 /* pshufb version: one of the hottest SPU ops (~11% of GH3's FMOD mixer task
  * as the byte loop). SPU byte P lives at host byte SPU_W(P), i.e. the bytes
- * of each 32-bit word reversed, so swap into SPU order, select, swap back. */
+ * of each 32-bit word reversed (see the comment in the function). */
 SPU_HOT u128 spu_shufb(u128 a, u128 b, u128 c) {
-    const __m128i sw = _mm_setr_epi8(3,2,1,0, 7,6,5,4, 11,10,9,8, 15,14,13,12);
-    __m128i A, B, C; memcpy(&A, &a, 16); memcpy(&B, &b, 16); memcpy(&C, &c, 16);
-    A = _mm_shuffle_epi8(A, sw); B = _mm_shuffle_epi8(B, sw); C = _mm_shuffle_epi8(C, sw);
-    const __m128i idx = _mm_and_si128(C, _mm_set1_epi8(0x0F));
-    const __m128i fromb = _mm_cmpeq_epi8(_mm_and_si128(C, _mm_set1_epi8(0x10)), _mm_set1_epi8(0x10));
-    __m128i r = _mm_blendv_epi8(_mm_shuffle_epi8(A, idx), _mm_shuffle_epi8(B, idx), fromb);
-    /* Special selectors: 10x -> 0x00, 110 -> 0xFF, 111 -> 0x80. */
-    const __m128i m80 = _mm_cmpeq_epi8(_mm_and_si128(C, _mm_set1_epi8((char)0x80)), _mm_set1_epi8((char)0x80));
-    const __m128i mC0 = _mm_cmpeq_epi8(_mm_and_si128(C, _mm_set1_epi8((char)0xC0)), _mm_set1_epi8((char)0xC0));
-    const __m128i mE0 = _mm_cmpeq_epi8(_mm_and_si128(C, _mm_set1_epi8((char)0xE0)), _mm_set1_epi8((char)0xE0));
-    const __m128i special = _mm_blendv_epi8(mC0, _mm_set1_epi8((char)0x80), mE0);
-    r = _mm_shuffle_epi8(_mm_blendv_epi8(r, special, m80), sw);
-    u128 out; memcpy(&out, &r, 16); return out;
+    /* Worked in host byte order, with no swaps: result SPU byte t and control
+     * SPU byte t both live at host byte t ^ 3, so the control already sits
+     * where its result goes; only the source index needs mapping, SPU byte s
+     * of a or b being host byte s ^ 3 = (sel ^ 3) & 15 (pshufb reads the low
+     * four bits, and zeroes where bit 7 is set, which the specials overwrite).
+     * blendv looks only at bit 7 of its mask: bit 4 of the control shifted up
+     * picks b, and the control itself marks the special selectors. */
+    const __m128i A = spu__mi(a), B = spu__mi(b), C = spu__mi(c);
+    const __m128i idx = _mm_xor_si128(C, _mm_set1_epi8(3));
+    const __m128i r = _mm_blendv_epi8(_mm_shuffle_epi8(A, idx), _mm_shuffle_epi8(B, idx),
+                                      _mm_slli_epi16(C, 3));
+    /* Special selectors (bit 7 set): 10x -> 0x00, 110 -> 0xFF, 111 -> 0x80.
+     * As signed bytes 110xxxxx and up are > (int8)0xBF, 111xxxxx > (int8)0xDF. */
+    const __m128i ge_c0 = _mm_cmpgt_epi8(C, _mm_set1_epi8((char)0xBF));
+    const __m128i ge_e0 = _mm_cmpgt_epi8(C, _mm_set1_epi8((char)0xDF));
+    const __m128i special = _mm_andnot_si128(_mm_and_si128(ge_e0, _mm_set1_epi8(0x7F)), ge_c0);
+    return spu__um(_mm_blendv_epi8(r, special, C));
 }
