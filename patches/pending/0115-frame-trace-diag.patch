+    }
+    if (!s_tr_on) return;
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    const unsigned long long ns = (unsigned long long)ts.tv_sec * 1000000000ull + (unsigned long long)ts.tv_nsec;
+    pthread_mutex_lock(&s_tr_mu);
+    static __thread unsigned tid;
+    if (!tid) tid = (unsigned)syscall(SYS_gettid);
+    fprintf(s_tr, "%llu %u %c %u\n", ns, tid, ev, arg);
+    if (ns - s_tr_flush > 1000000000ull) { fflush(s_tr); s_tr_flush = ns; }
+    pthread_mutex_unlock(&s_tr_mu);
+}
