+"""Optional AOT regions for pure lifted blocks, entered by the nested drain only.
+Original entry symbols remain intact for IRQ-enabled/root/fallback execution.
+"""
+import re
+
+def emit_region(source, names):
+    names = list(names)
+    blocks = dict(re.findall(r'^void (\w+)\(spu_context\* ctx\) \{\n(.*?)^\}', source, re.M | re.S))
+    if not names or len(set(names)) != len(names):
+        raise ValueError('region entries must be nonempty and unique')
+    for name in names:
+        body = blocks[name]
+        calls = set(re.findall(r'\b(\w+)\s*\(ctx\s*[,)]', body))
+        if calls - {'spu_ls_read128', 'spu_ls_write128', 'SPU_RET', 'SPU_RET_REG'}:
+            raise ValueError(f'{name}: region contains context callbacks: {calls}')
+        # Only GPR assignments and direct PC publications may change context.
+        if re.search(r'ctx->(?!gpr\[|pc\s*=)\w+\s*=', body):
+            raise ValueError(f'{name}: context mutation')
+        if 'goto ' in body or 'TODO' in body:
+            raise ValueError(f'{name}: unsupported control flow')
+        for target in re.findall(r'g_spu_trampoline_fn\s*=\s*(\w+)', body):
+            if target not in names:
+                raise ValueError(f'{name}: external tail {target}')
+    code = ['#if defined(SPU_LS_NO_PROBES) && defined(__SSSE3__)', '#include <stdatomic.h>',
+            'int spu_try_region(spu_context* ctx, void (*entry)(spu_context*)) {',
+            '    if (entry != '+ ' && entry != '.join(names) + ') return 0;',
+            '    if (ctx->int_enable || ctx->policy_mode || ctx->irq_frame || ctx->irq_saved) return 0;',
+            '    static atomic_int enabled = -1;',
+            '    int on = atomic_load_explicit(&enabled, memory_order_relaxed);',
+            '    if (on < 0) { const char* e = getenv("SPU_REGIONS");',
+            '        on = !e || e[0] != \'0\'; atomic_store_explicit(&enabled, on, memory_order_relaxed); }',
+            '    if (!on) return 0;']
+    for i,name in enumerate(names):
+        code.append(f'    if (entry == {name}) goto region_{i};')
+    code.append('    return 0;')
+    for i,name in enumerate(names):
+        body=blocks[name]
+        for j,target in enumerate(names):
+            body=body.replace(f'g_spu_trampoline_fn = {target}; return;',
+                 f'yz_lockstep_tick(ctx); spu_task_launch_check(ctx, (void*){target}); goto region_{j};')
+        # SPU_RET returns from this int-valued native region instead of the
+        # void entry. Preserve its exact PC/trampoline/host-depth semantics.
+        def ret(reg):
+            return ('do { ctx->pc = ctx->gpr['+reg+']._u32[0]; '
+                    'if (ctx->host_depth == 0) g_spu_trampoline_fn = spu_indirect_branch; '
+                    'return 1; } while (0)')
+        body=body.replace('SPU_RET(ctx)',ret('0'))
+        body=re.sub(r'SPU_RET_REG\(ctx,\s*(\d+)\)',lambda m:ret(m[1]),body)
+        if re.search(r'\breturn\s*;', body) or re.search(r'g_spu_trampoline_fn\s*=\s*(?!spu_indirect_branch\b)\w+', body):
+            raise ValueError(f'{name}: unconverted transfer')
+        code += [f'region_{i}: {{',body,'    return 1;', '}']
+    code += ['}', '#endif']
+    return source + '\n' + '\n'.join(code) + '\n'
