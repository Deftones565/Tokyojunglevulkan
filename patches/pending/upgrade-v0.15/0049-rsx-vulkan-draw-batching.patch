+/* Take `bytes` of a ring reserved above. */
+static VkDeviceSize vk_ring_take(VkDeviceSize* off, VkDeviceSize bytes, VkDeviceSize align)
+{
+    const VkDeviceSize at = vk_align_up(*off, align);
+    *off = at + bytes;
+    return at;
