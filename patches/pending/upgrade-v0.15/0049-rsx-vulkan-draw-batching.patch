+/* ---------------------------------------------------------------------------
+ * Batch storage: per-draw slices of three host-coherent rings (vertices,
+ * indices, constants) and one descriptor set per draw from a pool, all
+ * recycled when the batch is submitted (vk_batch_reset). A recorded draw
+ * owns its slices until then, so nothing it reads is overwritten under it.
+ * -------------------------------------------------------------------------*/
+#define VK_BATCH_SETS 1024u          /* draws per batch before a flush     */
+
+static struct {
+    vk_buffer        v, i, u;        /* vertex / index / uniform rings     */
+    VkDeviceSize     vo, io, uo;     /* next free byte of each             */
+    VkDeviceSize     ualign;         /* minUniformBufferOffsetAlignment    */
+    VkDescriptorPool pool;
+    u32              sets;           /* allocated from pool this batch     */
+    u8*              vsc;            /* last bound constants: they persist */
+    u8*              psc;            /* across draws until rebound         */
+} s_bs;
+
+static void vk_batch_reset(void)
+{
+    s_bs.vo = s_bs.io = s_bs.uo = 0;
+    if (s_bs.pool && s_bs.sets) pvkResetDescriptorPool(s_vk.device, s_bs.pool, 0);
+    s_bs.sets = 0;
+}
+
+static void vk_batch_shutdown(void)
+{
+    vk_destroy_buffer(&s_bs.v);
+    vk_destroy_buffer(&s_bs.i);
+    vk_destroy_buffer(&s_bs.u);
+    if (s_bs.pool) pvkDestroyDescriptorPool(s_vk.device, s_bs.pool, NULL);
+    free(s_bs.vsc); free(s_bs.psc);
+    memset(&s_bs, 0, sizeof s_bs);
+}
+
+static VkDeviceSize vk_align_up(VkDeviceSize x, VkDeviceSize a) { return (x + a - 1u) / a * a; }
+
+/* Make room in a ring that is EMPTY (the batch was just flushed): grow it to
+ * at least `bytes`. */
+static int vk_ring_fit(vk_buffer* b, VkDeviceSize bytes, VkBufferUsageFlags usage, VkDeviceSize first)
+{
+    if (b->buf && b->size >= bytes) return 0;
+    VkDeviceSize size = b->size ? b->size : first;
+    while (size < bytes) size *= 2;
+    vk_destroy_buffer(b);
+    if (vk_create_host_buffer(b, size, usage)) return -1;
+    return b->coherent ? 0 : -1;
+}
+
+/* Reserve one draw's worth of every ring plus a descriptor set, flushing the
+ * batch first when any of them is full. Nothing after this may flush until
+ * the draw is recorded, or its slices would be recycled under it. */
+static int vk_batch_reserve(VkDeviceSize vbytes, VkDeviceSize ibytes, VkDeviceSize ubytes)
+{
+    if (!s_bs.pool) {
+        VkDescriptorPoolSize ps[3] = {
+            { VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 2u * VK_BATCH_SETS },
+            { VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, RSX_MAX_TEXTURES * VK_BATCH_SETS },
+            { VK_DESCRIPTOR_TYPE_SAMPLER, RSX_MAX_TEXTURES * VK_BATCH_SETS },
+        };
+        VkDescriptorPoolCreateInfo pci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                           .maxSets = VK_BATCH_SETS, .poolSizeCount = 3, .pPoolSizes = ps };
+        if (pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &s_bs.pool) != VK_SUCCESS) {
+            s_bs.pool = VK_NULL_HANDLE; return -1;
+        }
+    }
+    /* vk_ring_take aligns vertex slices to 16 B: count that padding too. */
+    const int fits = s_bs.v.buf && vk_align_up(s_bs.vo, 16u) + vbytes <= s_bs.v.size
+                  && (!ibytes || (s_bs.i.buf && s_bs.io + ibytes <= s_bs.i.size))
+                  && s_bs.u.buf && vk_align_up(s_bs.uo, s_bs.ualign) + ubytes <= s_bs.u.size
+                  && s_bs.sets < VK_BATCH_SETS
+                  && !s_batch.off;
+    if (fits) return 0;
+    if (vk_batch_flush()) return -1;
+    if (vk_ring_fit(&s_bs.v, vbytes, VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, 8u << 20) ||
+        (ibytes && vk_ring_fit(&s_bs.i, ibytes, VK_BUFFER_USAGE_INDEX_BUFFER_BIT, 4u << 20)) ||
+        vk_ring_fit(&s_bs.u, ubytes, VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT, 8u << 20)) {
+        VK_LOG("engine: batch rings: out of host-coherent memory\n");
+        return -1;
+    }
+    return 0;
+}
