diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3edd19b..f28ac3d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -273,6 +273,9 @@ if(SPU_SOURCES)
             if(PORT_BUILD_HOST_HAS_SSE41_FMA)
                 set(SPU_HOST_SIMD_DEFAULT ON)
             endif()
+            check_c_source_runs("int main(void) { __builtin_cpu_init();
+                return !__builtin_cpu_supports(\"avx2\"); }"
+                PORT_BUILD_HOST_HAS_AVX2)
         endif()
         # It was forced OFF for a while: with it ON the Pomeranian's fur exploded.
         # The flags never changed a result (tools/spu-bisect/harness: SPU image 9's
@@ -283,6 +286,14 @@ if(SPU_SOURCES)
         if(PORT_SPU_HOST_SIMD AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64|amd64")
             list(APPEND SPU_COMPILE_OPTIONS -msse4.1 -mfma -ffp-contract=off)
             message(STATUS "Lifted SPU:      SSE4.1 + FMA, -ffp-contract=off")
+            # AVX2 turns on ps3recomp's four-lane single-precision fast path
+            # (upstream PR #369, patch 0089): exact like the per-lane path it
+            # replaces, which was ~20% of gameplay CPU after the v0.15 upgrade.
+            option(PORT_SPU_HOST_AVX2 "Also build the lifted SPU sources with AVX2" ${PORT_BUILD_HOST_HAS_AVX2})
+            if(PORT_SPU_HOST_AVX2)
+                list(APPEND SPU_COMPILE_OPTIONS -mavx2)
+                message(STATUS "Lifted SPU:      + AVX2")
+            endif()
         else()
             message(STATUS "Lifted SPU:      baseline host ISA (PORT_SPU_HOST_SIMD off)")
         endif()
