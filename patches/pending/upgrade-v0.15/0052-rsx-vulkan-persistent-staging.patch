+/* Staging for the engine's synchronous transfers (texture uploads, surface
+ * readbacks, depth snapshots). Each used to create, allocate, map and free a
+ * buffer per transfer: in Tokyo Jungle gameplay that was ~20% of the FIFO
+ * thread, with the copies into freshly mapped pages most of the rest of the
+ * upload cost. Every transfer that uses one is submitted and waited on before
+ * it returns, so the buffer is idle again by the next call; it only grows. */
+static vk_buffer s_stage_up;         /* TRANSFER_SRC, coherent: uploads     */
+static vk_buffer s_stage_dn;         /* TRANSFER_DST, cached: readbacks     */
+static vk_buffer s_stage_zz;         /* SRC|DST: depth -> R32F snapshots    */
+
+static int vk_stage(vk_buffer* b, VkDeviceSize bytes, VkBufferUsageFlags usage)
+{
+    if (b->buf && b->size >= bytes) return 0;
+    VkDeviceSize size = b->size ? b->size * 2u : (VkDeviceSize)1u << 20;
+    while (size < bytes) size *= 2u;
+    vk_destroy_buffer(b);
+    return vk_create_host_buffer(b, size, usage);
+}
