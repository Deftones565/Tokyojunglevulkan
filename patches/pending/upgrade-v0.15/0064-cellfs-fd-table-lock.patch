 /* ---- fd / dir handle tables ---- */
+/* One lock for the tables and every use of an fd. lv2's file calls are
+ * thread-safe and titles rely on it: Tokyo Jungle's sound library loads its
+ * banks on its own thread (sgsfile-req-th) while the map loader and the game
+ * thread open, read and close other files. Unlocked, two opens at the same
+ * moment could hand out the same fd (fd_alloc_file scans, then claims), and a
+ * close could free a FILE* another thread was reading. Held across the host
+ * I/O of a call, never across a call back into guest code. Recursive so a
+ * handler that ends up in another handler cannot deadlock itself. */
+static std::recursive_mutex g_fs_lock;
+/* Takes the lock; when another thread holds it, says so (first 16, then every
+ * 256th with a count): each of those is a call that, before this lock, ran
+ * concurrently with another thread's file call on the same tables. */
+struct fs_locked {
+    explicit fs_locked(const char* who) {
+        if (g_fs_lock.try_lock()) return;
+        static unsigned long n;
+        const unsigned long k = __atomic_add_fetch(&n, 1, __ATOMIC_RELAXED);
+        if (k <= 16 || (k & 255) == 0)
+            fprintf(stderr, "[fs] %s waited for another thread's file call (#%lu)\n", who, k);
+        g_fs_lock.lock();
+    }
+    ~fs_locked() { g_fs_lock.unlock(); }
+    fs_locked(const fs_locked&) = delete;
+    fs_locked& operator=(const fs_locked&) = delete;
+};
+#define FS_LOCKED fs_locked fs_locked_(__func__)
 #define FS_MAX 256
 static FILE* g_files[FS_MAX];
 static uint8_t g_fd_usm[FS_MAX];
