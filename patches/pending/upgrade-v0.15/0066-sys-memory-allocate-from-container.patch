+int64_t sys_memory_allocate(ppu_context* ctx)
+{
+    uint32_t size      = LV2_ARG_U32(ctx, 0);
+    uint32_t flags     = LV2_ARG_U32(ctx, 1);
+    uint32_t addr_out  = LV2_ARG_PTR(ctx, 2);
