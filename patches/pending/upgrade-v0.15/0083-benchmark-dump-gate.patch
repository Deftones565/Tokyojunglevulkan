+/* Benchmark-only gate. Cache the decision for one present so the engine's
+ * display blit and the following readback always agree, even if the driver
+ * creates/removes the pause file between the two calls. */
+static int vk_wants_dump(void)
+{
+    static const char* pause_file;
+    static int initialized, cached;
+    static u32 presented = ~0u;
+    if (!initialized) { pause_file = getenv("TJ_FRAME_DUMP_PAUSE_FILE"); initialized = 1; }
+    if (presented != s_vk.presented) {
+        presented = s_vk.presented;
+        cached = s_vk.dump_path && ((s_vk.presented + 1u) % s_vk.dump_every) == 0;
+        if (cached && pause_file && *pause_file) {
+            FILE* f = fopen(pause_file, "rb");
+            if (f) { fclose(f); cached = 0; }
+        }
+    }
+    return cached;
+}
