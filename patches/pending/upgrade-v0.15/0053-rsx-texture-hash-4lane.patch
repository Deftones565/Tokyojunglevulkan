diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index e7e9126..f8b72fe 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -1078,15 +1078,28 @@ static u64 eng_texture_content_hash(u32 location, u32 offset, u32 span,
 {
     const u8* src = span ? eng_guest_ptr(NULL, location, offset, span) : NULL;
     if (!src) { *readable = 0; return 0; }
-    u64 hash = 1469598103934665603ull;
+    /* FNV-1a over 8-byte words in four independent lanes, folded at the end.
+     * Every cached texture is hashed once a frame (~10 MB a frame in Tokyo
+     * Jungle gameplay); one lane is a serial multiply chain and ran at a
+     * quarter of the speed. The value only has to change when the bytes do. */
+    const u64 P = 1099511628211ull;
+    u64 h0 = 1469598103934665603ull, h1 = h0 ^ 1u, h2 = h0 ^ 2u, h3 = h0 ^ 3u;
     u32 i = 0;
+    for (; i + 32 <= span; i += 32) {
+        u64 w[4];
+        memcpy(w, src + i, sizeof(w));
+        h0 = (h0 ^ w[0]) * P;
+        h1 = (h1 ^ w[1]) * P;
+        h2 = (h2 ^ w[2]) * P;
+        h3 = (h3 ^ w[3]) * P;
+    }
+    u64 hash = (((h0 * P) ^ h1) * P ^ h2) * P ^ h3;
     for (; i + 8 <= span; i += 8) {
         u64 word;
         memcpy(&word, src + i, sizeof(word));
-        hash ^= word;
-        hash *= 1099511628211ull;
+        hash = (hash ^ word) * P;
     }
-    for (; i < span; i++) { hash ^= src[i]; hash *= 1099511628211ull; }
+    for (; i < span; i++) hash = (hash ^ src[i]) * P;
     *readable = 1;
     return hash;
 }
