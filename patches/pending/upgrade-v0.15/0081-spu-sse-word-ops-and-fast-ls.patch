+/* SPU_LS_NO_PROBES (defined for a port's lifted SPU sources, CMakeLists.txt):
+ * a 16-byte local-store access is one load or store plus one pshufb that
+ * byte-swaps each 32-bit word -- the same bytes the probe-carrying versions
+ * below produce, without their per-access debug hooks (the LBP WWS probes,
+ * SPU_LS_LOWREAD, the LS watch list, SPU_SMC_WATCH), which every lifted
+ * load and store paid for. Lifted code only; the runtime keeps the probes. */
+#include <tmmintrin.h>
+static inline __m128i spu__ls_bswap_mask(void)
+{
+    return _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12);
+}
+static inline u128 spu_ls_read128(const spu_context* ctx, uint32_t lsa)
+{
+    const __m128i x = _mm_loadu_si128((const __m128i*)&ctx->ls[lsa & SPU_LS_MASK & ~0xFu]);
+    u128 v;
+    _mm_storeu_si128((__m128i*)&v, _mm_shuffle_epi8(x, spu__ls_bswap_mask()));
+    return v;
+}
