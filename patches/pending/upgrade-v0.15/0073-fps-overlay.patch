@@ -75,6 +75,11 @@ int  rsx_vulkan_backend_pump_messages(void);
 /* Read the frame back to host memory (and to PS3RECOMP_VK_DUMP if set). */
 void rsx_vulkan_backend_present(void);
 
+/* Draw a short line of text (digits . - F P S) in the window's top-right corner
+ * on every present until it is replaced; NULL or "" removes it. Window only:
+ * not in the guest's surfaces, the readback or frame dumps. */
+void rsx_vulkan_backend_set_overlay(const char* text);
+
 /* The clear colour most recently set through the command stream, ARGB8888. */
 u32  rsx_vulkan_backend_debug_color(void);
 
