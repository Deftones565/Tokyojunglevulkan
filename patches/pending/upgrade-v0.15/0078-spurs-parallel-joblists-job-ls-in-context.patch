+/* ---------------------------------------------------------------------------
+ * JOBLIST jobs on several host threads
+ *
+ * SPURS hands a job list's jobs to every SPU the chain may use, which run them
+ * at the same time; only a SYNC (or the end of the list's command) orders them
+ * against what follows. The walker ran them one after another on one virtual
+ * SPU, so in Tokyo Jungle gameplay ~30 ms of geometry and animation jobs a
+ * frame were serial work on the main thread's critical path (it waits for the
+ * chain in cellSpursEventFlagWait). A list now goes to a small pool of
+ * persistent workers plus the walker itself, as on hardware; the walker waits
+ * for the whole list, then sends the per-job completions in job order, each
+ * with the mailbox/event state its job left (thread-local on the thread that
+ * ran it). SPURS_JOBLIST_PARALLEL=0 runs lists serially as before;
+ * SPURS_JOBLIST_WORKERS sets the pool size (default 4: five SPUs with the
+ * walker, of the six a PS3 title gets).
+ * -------------------------------------------------------------------------*/
+extern SPURS_JOB_TLS uint32_t g_spurs_job_mbox, g_spurs_job_mbox_intr, g_spurs_job_cmd;
+extern SPURS_JOB_TLS int g_spurs_job_mbox_valid, g_spurs_job_sent_event;
+
+typedef struct { uint32_t mbox, mbox_intr, cmd; int mbox_valid, sent_event; } jl_result;
+
+typedef struct jl_batch {
+    u32 list, size, n, jc_ea;
+    int idx0;
+    volatile long next;        /* next job index to claim   */
+    volatile long done;        /* jobs finished             */
+    long active;               /* pool workers inside jl_drain(b); s_jl_lock.
+                                * The batch lives on the walker's stack: it is
+                                * unlinked only when done == n AND active == 0,
+                                * so no worker can touch it afterwards (a
+                                * worker's last claim attempt, or one that
+                                * picked it just as the others finished). */
+    jl_result* res;
+    struct jl_batch* link;
+} jl_batch;
+
+static SRWLOCK            s_jl_lock = SRWLOCK_INIT;
+static CONDITION_VARIABLE s_jl_work = CONDITION_VARIABLE_INIT;   /* a list was posted */
+static CONDITION_VARIABLE s_jl_fin  = CONDITION_VARIABLE_INIT;   /* a list finished   */
+static jl_batch*          s_jl_head;
+
+static void jc_run_one_job(u32 job_ea, int idx, u32 size_desc);
+
+/* Claim and run jobs of `b` until none are left. */
+static void jl_drain(jl_batch* b)
+{
+    for (;;) {
+        const long k = InterlockedIncrement(&b->next) - 1;
+        if (k >= (long)b->n) return;
+        { extern u32 g_spurs_job_ls_handle; g_spurs_job_ls_handle = b->jc_ea; }
+        g_spurs_job_mbox_valid = 0;
+        g_spurs_job_sent_event = 0;
+        { extern SPURS_JOB_TLS int g_spurs_job_in_list; g_spurs_job_in_list = 1; }
+        jc_run_one_job(b->list + (u32)k * b->size, b->idx0 + (int)k, b->size);
+        { extern SPURS_JOB_TLS int g_spurs_job_in_list; g_spurs_job_in_list = 0; }
+        jl_result* r = &b->res[k];
+        r->mbox = g_spurs_job_mbox; r->mbox_intr = g_spurs_job_mbox_intr;
+        r->cmd = g_spurs_job_cmd; r->mbox_valid = g_spurs_job_mbox_valid;
+        r->sent_event = g_spurs_job_sent_event;
+        g_spurs_job_mbox_valid = 0;
+        g_spurs_job_sent_event = 0;
+        if (InterlockedIncrement(&b->done) == (long)b->n) {
+            AcquireSRWLockExclusive(&s_jl_lock);
+            WakeAllConditionVariable(&s_jl_fin);
+            ReleaseSRWLockExclusive(&s_jl_lock);
+        }
+    }
+}
+
+static DWORD WINAPI jl_worker(LPVOID p)
+{
+    (void)p;
+    AcquireSRWLockExclusive(&s_jl_lock);
+    for (;;) {
+        jl_batch* b = s_jl_head;
+        while (b && b->next >= (long)b->n) b = b->link;
+        if (!b) { SleepConditionVariableSRW(&s_jl_work, &s_jl_lock, INFINITE, 0); continue; }
+        b->active++;
+        ReleaseSRWLockExclusive(&s_jl_lock);
+        jl_drain(b);
+        AcquireSRWLockExclusive(&s_jl_lock);
+        if (--b->active == 0 && b->done >= (long)b->n)
+            WakeAllConditionVariable(&s_jl_fin);
+    }
+    return 0;
+}
+
+/* Number of pool workers, starting them the first time; 0 = run serially. */
+static int jl_workers(void)
+{
+    static volatile long started = 0;
+    static int n = -1;
+    if (n < 0) {
+        const char* e = getenv("SPURS_JOBLIST_PARALLEL");
+        const char* w = getenv("SPURS_JOBLIST_WORKERS");
+        int k = w ? atoi(w) : 4;
+        if (k < 0) k = 0;
+        if (k > 15) k = 15;
+        n = (e && *e == '0') ? 0 : k;
+    }
+    if (n > 0 && InterlockedCompareExchange(&started, 1, 0) == 0) {
+        for (int i = 0; i < n; i++) {
+            HANDLE th = CreateThread(NULL, 4u << 20, jl_worker, NULL, 0, NULL);
+            if (th) CloseHandle(th);
+        }
+        fprintf(stderr, "[cellSpurs] JOBLIST jobs run on %d pool threads + the chain walker\n", n);
+    }
+    return n;
+}
+
+/* Run a JOBLIST's n jobs on the pool and the calling walker, then signal each
+ * job's completion in order. Returns 0 if the chain is stopping. */
+static int jl_run_parallel(u32 jc_ea, u32 list, u32 n, u32 size, int idx0)
+{
+    jl_batch b;
+    memset(&b, 0, sizeof b);
+    b.list = list; b.size = size; b.n = n; b.jc_ea = jc_ea; b.idx0 = idx0;
+    b.res = (jl_result*)calloc(n, sizeof(jl_result));
+    if (!b.res) return -1;
+    AcquireSRWLockExclusive(&s_jl_lock);
+    b.link = s_jl_head; s_jl_head = &b;
+    WakeAllConditionVariable(&s_jl_work);
+    ReleaseSRWLockExclusive(&s_jl_lock);
+    jl_drain(&b);
+    AcquireSRWLockExclusive(&s_jl_lock);
+    while (b.done < (long)n || b.active > 0)
+        SleepConditionVariableSRW(&s_jl_fin, &s_jl_lock, INFINITE, 0);
+    jl_batch** pp = &s_jl_head;
+    while (*pp != &b) pp = &(*pp)->link;
+    *pp = b.link;
+    ReleaseSRWLockExclusive(&s_jl_lock);
+    for (u32 i = 0; i < n; i++) {
+        g_spurs_job_mbox = b.res[i].mbox; g_spurs_job_mbox_intr = b.res[i].mbox_intr;
+        g_spurs_job_cmd = b.res[i].cmd; g_spurs_job_mbox_valid = b.res[i].mbox_valid;
+        g_spurs_job_sent_event = b.res[i].sent_event;
+        jc_signal_done(jc_ea, idx0 + (int)i);
+    }
+    free(b.res);
+    return 1;
+}
+
 static void jc_execute(u32 entry_ea, u32 jc_ea, u32 size_desc)
 {
     u32 pc = entry_ea, ret_pc = 0;
@@ -2775,7 +2916,17 @@ static void jc_execute(u32 entry_ea, u32 jc_ea, u32 size_desc)
               if (t) fprintf(stderr, "[jc-trace] chain 0x%08X JOBLIST @0x%08X n=%u size=%u list=0x%08X\n",
                              jc_ea, jl, n, size, list); }
             if (n == 0) { pc += 8; continue; }    /* an empty list is valid: nothing to run */
-            if (n <= 4096 && size >= 64 && size <= 0x1000 && list) {
+            if (n > 1 && n <= 4096 && size >= 64 && size <= 0x1000 && list && jl_workers() > 0) {
+                const int idx0 = jobs;
+                jobs += (int)n;
+                if (jl_run_parallel(jc_ea, list, n, size, idx0) < 0) {
+                    jobs = idx0;
+                    goto serial;
+                }
+                if (jc_stopping()) return;
+                idle = 0;
+            } else if (n <= 4096 && size >= 64 && size <= 0x1000 && list) {
+            serial:
                 for (u32 i = 0; i < n; i++) {
                     if (jc_stopping()) return;
                     { extern u32 g_spurs_job_ls_handle; g_spurs_job_ls_handle = jc_ea; }
diff --git a/runtime/spu/spurs_job.c b/runtime/spu/spurs_job.c
index 5aeee83..e1a9088 100644
--- a/runtime/spu/spurs_job.c
