index f6232af..dbc9e6b 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -2723,6 +2723,147 @@ static void jc_signal_done(u32 jc_ea, int job_index)
     }
