@@ -42,6 +42,7 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include "../platform/win32_compat.h"   /* SRWLOCK (s_job_ls copy) */
 
 extern uint8_t* vm_base;
 extern int spu_run_with_halt(void (*)(spu_context*), spu_context*);
@@ -122,12 +123,31 @@ static uint8_t  s_job_ls[SPU_LS_SIZE];
 static int      s_job_ls_valid;
 uint32_t        g_spurs_job_ls_handle;   /* set by the chain walker */
 
+/* Chain handles the PPU has polled this way. A job run from a parallel
+ * JOBLIST (g_spurs_job_in_list, set by cellSpurs.c's pool) only stores its
+ * local store for one of these: copying 256 KB under a lock after every
+ * geometry job serialised the pool, and nothing reads those chains' stores. */
+#define SPURS_POLLED_MAX 16
+static volatile uint32_t s_polled[SPURS_POLLED_MAX];
+
 const uint8_t* spurs_job_ls_for_handle(uint32_t handle)
 {
+    if (handle) {
+        int seen = 0;
+        for (int i = 0; i < SPURS_POLLED_MAX && s_polled[i]; i++) if (s_polled[i] == handle) seen = 1;
+        for (int i = 0; !seen && i < SPURS_POLLED_MAX; i++)
+            if (!s_polled[i]) { s_polled[i] = handle; break; }
+    }
     if (!s_job_ls_valid || !handle || handle != g_spurs_job_ls_handle) return 0;
     return s_job_ls;
 }
 
+static int spurs_job_handle_polled(uint32_t handle)
+{
+    for (int i = 0; i < SPURS_POLLED_MAX && s_polled[i]; i++) if (s_polled[i] == handle) return 1;
+    return 0;
+}
+
