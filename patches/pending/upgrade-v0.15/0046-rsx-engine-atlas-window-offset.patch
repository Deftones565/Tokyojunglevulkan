+    const u32 y0 = *oy > sf->clip_y ? *oy : sf->clip_y;
+    *ext_w = x0 + (sf->clip_w ? sf->clip_w : g.width);
+    *ext_h = y0 + (sf->clip_h ? sf->clip_h : g.height);
