+/* A w x h rectangle of colour target `slot`, at (x, y), as a texture of its
+ * own: copied on the GPU when the backend can, otherwise read back and
+ * uploaded, and refreshed whenever the target has been written since. The
+ * unit's crossbar becomes the image's view as it does for a surface view.
+ * Returns the texture, or 0. */
+static u32 eng_region_texture(u32 slot, u32 x, u32 y, u32 w, u32 h,
+                              u32 remap, u32 format)
+{
+    const eng_surface* s = &g.surfaces[slot];
+    eng_region* r = NULL;
+    for (u32 i = 0; i < g.n_regions; i++) {
+        eng_region* e = &g.regions[i];
+        if (e->slot == slot && e->x == x && e->y == y && e->w == w &&
+            e->h == h && e->remap == remap && e->format == format) { r = e; break; }
+    }
+    if (r && r->handle && r->surface_handle != s->handle) {
+        g.be->texture_release(g.be->user, r->handle);   /* target recreated */
+        r->handle = 0;
+    }
+    if (!r) {
+        if (g.n_regions < ENG_MAX_REGIONS) {
+            r = &g.regions[g.n_regions++];
+        } else {
+            r = &g.regions[0];
+            for (u32 i = 1; i < g.n_regions; i++)
+                if (g.regions[i].last_use < r->last_use) r = &g.regions[i];
+            if (r->handle) g.be->texture_release(g.be->user, r->handle);
+        }
+        memset(r, 0, sizeof *r);
+        r->slot = slot; r->x = x; r->y = y; r->w = w; r->h = h;
+        r->remap = remap; r->format = format;
+    }
+    r->last_use = ++g.region_use_serial;
+    if (!r->handle) {
+        r->handle = g.be->texture_create(g.be->user, s->fmt, w, h, 1, 1, remap, format);
+        if (!r->handle) return 0;
+        r->surface_handle = s->handle;
+        r->copied_serial = ~0ull;
+    }
+    if (r->copied_serial != s->color_serial) {
+        int ok = g.be->copy_surface_region
+            ? g.be->copy_surface_region(g.be->user, s->handle, x, y, w, h, r->handle)
+            : -1;
