diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index 804bca0..4069a5d 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -76,6 +76,7 @@ typedef struct {
 } PadHostState;
 
 static int           s_pad_initialized = 0;
+static int           s_host_blocked = 0;   /* cellPad_host_set_blocked */
 static u32           s_max_connect = 0;
 static u32           s_port_setting[CELL_PAD_MAX_PORT_NUM];
 static PadHostState  s_host_state[PAD_MAX_HOST_PORTS];
@@ -454,6 +455,22 @@ static void pad_poll_backend(void)
 #ifdef _WIN32
     if (!s_host_state[0].connected) pad_poll_keyboard();
 #endif
+    /* The host's own UI has the controller (cellPad_host_set_blocked): the
+     * title sees its pads still connected, at rest. */
+    if (__atomic_load_n(&s_host_blocked, __ATOMIC_ACQUIRE))
+        for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) {
+            const u8 connected = s_host_state[i].connected;
+            pad_host_state_neutral(&s_host_state[i]);
+            s_host_state[i].connected = connected;
+        }
+}
+
+/* A host settings menu that reads the same controller sets this while it is
+ * open, so the button presses that drive the menu do not also reach the
+ * title. Any thread. */
+void cellPad_host_set_blocked(int blocked)
+{
+    __atomic_store_n(&s_host_blocked, blocked ? 1 : 0, __ATOMIC_RELEASE);
 }
 
