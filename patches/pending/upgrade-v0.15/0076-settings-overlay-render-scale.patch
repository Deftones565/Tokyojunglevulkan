+/* Views and framebuffers over the swapchain images, once per swapchain. */
+static int vk_ui_targets(void)
+{
+    if (!s_disp.sc_color_ok || vk_ui_pipeline()) return -1;
+    for (u32 i = 0; i < s_vk.sc_count; i++) {
+        if (s_disp.sc_fb[i]) continue;
+        VkImageViewCreateInfo vci = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .image = s_vk.sc_images[i],
+            .viewType = VK_IMAGE_VIEW_TYPE_2D, .format = s_disp.sc_fmt,
+            .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+        };
+        VK_CHECK(pvkCreateImageView(s_vk.device, &vci, NULL, &s_disp.sc_views[i]), "vkCreateImageView(ui)");
+        VkFramebufferCreateInfo fci = { .sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO,
+                                        .renderPass = s_disp.rp, .attachmentCount = 1,
+                                        .pAttachments = &s_disp.sc_views[i],
+                                        .width = s_vk.sc_extent.width, .height = s_vk.sc_extent.height,
+                                        .layers = 1 };
+        VK_CHECK(pvkCreateFramebuffer(s_vk.device, &fci, NULL, &s_disp.sc_fb[i]), "vkCreateFramebuffer(ui)");
+    }
+    return 0;
+}
