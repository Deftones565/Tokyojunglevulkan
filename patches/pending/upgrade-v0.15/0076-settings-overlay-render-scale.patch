+/* ---------------------------------------------------------------------------
+ * Display settings and render scale: the public side (rsx_vulkan_backend.h).
+ * All of these are called on the presenting thread, the one that drains the
+ * FIFO, so they run between two engine operations, never inside one.
+ * -------------------------------------------------------------------------*/
+
+/* Remake every colour and depth target at num/den of its guest size. Colour
+ * contents are carried over (blit, LINEAR); depth starts at the far plane
+ * (the next frame redraws it). Views follow their targets, and pixel programs
+ * that read WPOS are rebuilt for the new scale. Region textures and depth
+ * snapshots are remade the next time the engine fills them. */
+static int vk_eng_rescale(u32 num, u32 den)
+{
+    for (u32 i = 1; i < VK_ENG_MAX_OBJ; i++) {
+        const vk_eng_obj* o = &s_eobj[i];
+        if (o->kind != VK_ENG_COLOR && o->kind != VK_ENG_DEPTH) continue;
+        if ((u64)o->w * num / den > vk_max_dim() || (u64)o->h * num / den > vk_max_dim()) {
+            VK_LOG("render scale %u/%u: a %ux%u target would exceed %u; unchanged\n",
+                   num, den, o->w, o->h, vk_max_dim());
+            return -1;
+        }
+    }
+    vk_batch_flush();
+    vk_eng_drop_framebuffers();
+    s_rs_num = num; s_rs_den = den;
+
+    vk_image* old = (vk_image*)calloc(VK_ENG_MAX_OBJ, sizeof *old);
+    if (!old) return -1;
+    int rc = vk_begin();
+    for (u32 i = 1; !rc && i < VK_ENG_MAX_OBJ; i++) {
+        vk_eng_obj* o = &s_eobj[i];
+        if (o->kind != VK_ENG_COLOR && o->kind != VK_ENG_DEPTH) continue;
+        const u32 iw = rs_hi(o->w), ih = rs_hi(o->h);
+        if (iw == o->iw && ih == o->ih) continue;
+        const int color = o->kind == VK_ENG_COLOR;
+        vk_image im;
+        memset(&im, 0, sizeof im);
+        if (vk_create_image(&im, o->fmt, iw, ih,
+                            color ? (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                                     VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT)
+                                  : (VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT |
+                                     VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT),
+                            color ? VK_IMAGE_ASPECT_COLOR_BIT : s_vk.depth_aspect)) {
+            vk_destroy_image(&im); rc = -1; break;
+        }
+        vk_barrier_image(im.img, color ? VK_IMAGE_ASPECT_COLOR_BIT : s_vk.depth_aspect,
+                         VK_IMAGE_LAYOUT_UNDEFINED);
+        if (color) {
+            VkImageBlit b = {
+                .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                .srcOffsets = { { 0, 0, 0 }, { (int32_t)o->iw, (int32_t)o->ih, 1 } },
+                .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                .dstOffsets = { { 0, 0, 0 }, { (int32_t)iw, (int32_t)ih, 1 } },
+            };
+            pvkCmdBlitImage(s_vk.cmd, o->im.img, VK_IMAGE_LAYOUT_GENERAL,
+                            im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &b, VK_FILTER_LINEAR);
+        } else {
+            VkClearDepthStencilValue far_plane = { 1.0f, 0 };
+            VkImageSubresourceRange r = { s_vk.depth_aspect, 0, 1, 0, 1 };
+            pvkCmdClearDepthStencilImage(s_vk.cmd, im.img, VK_IMAGE_LAYOUT_GENERAL, &far_plane, 1, &r);
+        }
+        old[i] = o->im;
+        o->im = im; o->iw = iw; o->ih = ih;
+    }
+    if (!rc) rc = vk_submit_and_wait();
+    else     vk_submit_and_wait();
+    for (u32 i = 1; i < VK_ENG_MAX_OBJ; i++) if (old[i].img) vk_destroy_image(&old[i]);
+    free(old);
+
+    /* Views of a remade target point at its new image. */
+    for (u32 i = 1; i < VK_ENG_MAX_OBJ; i++) {
+        vk_eng_obj* v = &s_eobj[i];
+        if (v->kind != VK_ENG_VIEW) continue;
+        const vk_eng_obj* t = vk_eng_get(v->surface, VK_ENG_COLOR);
+        if (!t || (v->iw == t->iw && v->ih == t->ih)) continue;
+        if (v->im.view) pvkDestroyImageView(s_vk.device, v->im.view, NULL);
+        v->im.view = VK_NULL_HANDLE;
+        vk_eng_make_view(t->im.img, t->fmt, 1, vk_remap(v->remap, v->rsx_fmt), 0, &v->im.view);
+        v->iw = t->iw; v->ih = t->ih;
+    }
+    /* WPOS readers: new pixel module, new variants. */
+    for (u32 i = 0; i < VK_ENG_MAX_PIPE; i++) {
+        vk_eng_pipe* P = &s_epipe[i];
+        if (!P->used || !P->ps_wpos) continue;
+        for (u32 t = 0; t < VK_ENG_TOPOLOGIES; t++)
+            if (P->variant[t]) { pvkDestroyPipeline(s_vk.device, P->variant[t], NULL); P->variant[t] = VK_NULL_HANDLE; }
+        VkShaderModule fs;
+        if (!vk_eng_translate_ps(P->ps_wpos, &fs)) {
+            pvkDestroyShaderModule(s_vk.device, P->fs, NULL);
+            P->fs = fs;
+        }
+    }
+    VK_LOG("render scale %u/%u%s\n", num, den, rc ? " (some targets could not be remade)" : "");
+    return rc;
+}
+
+int rsx_vulkan_backend_set_render_scale(u32 num, u32 den)
+{
+    if (!num || !den || num > 8u * den) return -1;
+    u32 a = num, b = den;
+    while (b) { const u32 t = a % b; a = b; b = t; }
+    num /= a; den /= a;
+    if (num == s_rs_num && den == s_rs_den) return 0;
+    if (!s_vk.device) { s_rs_num = num; s_rs_den = den; return 0; }   /* before init */
+    if (!s_vk.eng_active) return -1;
+    return vk_eng_rescale(num, den);
+}
+
+u32 rsx_vulkan_backend_max_image_dim(void) { return vk_max_dim(); }
+
+void rsx_vulkan_backend_set_ui(const u32* rgba, u32 w, u32 h)
+{
+    if (!rgba || !w || !h) { s_disp.ui_shown = 0; return; }
+    if (s_disp.ui_w != w || s_disp.ui_h != h || !s_disp.ui_px) {
+        u32* p = (u32*)realloc(s_disp.ui_px, (size_t)w * h * 4u);
+        if (!p) { s_disp.ui_shown = 0; return; }
+        s_disp.ui_px = p; s_disp.ui_w = w; s_disp.ui_h = h;
+    }
+    memcpy(s_disp.ui_px, rgba, (size_t)w * h * 4u);
+    s_disp.ui_version++;
+    s_disp.ui_shown = 1;
+}
+
+void rsx_vulkan_backend_set_vsync(int on)
+{
+    on = on ? 1 : 0;
+    if (on == s_disp.vsync) return;
+    s_disp.vsync = on;
+    if (s_vk.windowed && s_vk.swapchain) vk_swapchain_lost();   /* recreate with the new mode */
+}
+
+void rsx_vulkan_backend_set_keep_aspect(int mode) { s_disp.keep_aspect = (mode >= 0 && mode <= 2) ? mode : 0; }
+void rsx_vulkan_backend_set_escape_quits(int on) { s_disp.escape_quits = on ? 1 : 0; }
+void* rsx_vulkan_backend_sdl_window(void) { return s_vk.windowed ? (void*)s_vk.window : NULL; }
+
+void rsx_vulkan_backend_window_extent(u32* w, u32* h)
+{
+    if (w) *w = s_vk.windowed ? s_vk.sc_extent.width : 0;
+    if (h) *h = s_vk.windowed ? s_vk.sc_extent.height : 0;
+}
+
 #endif /* !_WIN32 */
