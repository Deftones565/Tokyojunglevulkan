+/* Recording into the open batch. Transfers and clears the CPU needs nothing
+ * back from -- uploads, clears, surface -> texture copies, depth snapshots,
+ * new images' layout moves -- used to go through vk_begin() and end in their
+ * own vk_submit_and_wait(): one GPU round trip each, dozens a frame, with the
+ * CPU and GPU taking turns (Tokyo Jungle gameplay: ~16% of the FIFO thread's
+ * wall time waiting, mg5-g1). They are now recorded into the open batch like
+ * a draw, behind the same global barrier, so the GPU still sees every
+ * operation in exactly the order the engine issued it; only what the CPU
+ * reads back (readbacks, presents) and object destruction still flush and
+ * wait. PS3RECOMP_VK_BATCH=0 keeps the old one-submit-per-operation path. */
+static int vk_batching_off(void)
+{
+    static int off = -1;
+    if (off < 0) { const char* e = getenv("PS3RECOMP_VK_BATCH"); off = e && e[0] == '0'; }
+    return off;
+}
+
+static int vk_rec_begin(void)
+{
+    if (vk_batching_off()) return vk_begin();
+    if (!s_batch.open) {
+        if (vk_begin()) return -1;
+        s_batch.open = 1;
+    }
+    VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                           .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+                           .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT };
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                          VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+    return 0;
+}
+
+static int vk_rec_end(void)
+{
+    return vk_batching_off() ? vk_submit_and_wait() : 0;
+}
+
+/* Upload staging that lives as long as the open batch: the CPU fills a slice
+ * when the upload is recorded and the GPU reads it when the batch runs, so a
+ * slice is free again only after the batch's submit-and-wait. Taking a slice
+ * that does not fit flushes the batch first (vk_batch_reset rewinds it). */
+static vk_buffer s_bst;
+static VkDeviceSize s_bst_off;
+
+static int vk_bstage(VkDeviceSize bytes, VkDeviceSize* off)
+{
+    bytes = (bytes + 15u) & ~(VkDeviceSize)15u;
+    if (!s_bst.buf || s_bst_off + bytes > s_bst.size) {
+        if (s_batch.open && vk_batch_flush()) return -1;
+        s_bst_off = 0;
+        if (!s_bst.buf || bytes > s_bst.size) {
+            VkDeviceSize size = s_bst.size ? s_bst.size : (VkDeviceSize)64u << 20;
+            while (size < bytes) size *= 2u;
+            vk_destroy_buffer(&s_bst);
+            if (vk_create_host_buffer(&s_bst, size, VK_BUFFER_USAGE_TRANSFER_SRC_BIT) ||
+                !s_bst.coherent) {
+                vk_destroy_buffer(&s_bst); return -1;
+            }
+        }
+    }
+    *off = s_bst_off;
+    s_bst_off += bytes;
+    return 0;
+}
