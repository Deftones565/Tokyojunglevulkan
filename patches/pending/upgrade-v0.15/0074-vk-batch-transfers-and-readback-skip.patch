+ * A readback there would store the very bytes already in guest memory. */
+static int eng_guest_clean(const eng_surface* s, u32 location, u32 offset, u32 pitch,
+                           u32 x, u32 y, u32 w, u32 h)
+{
+    if (!s->clean_bytes || s->clean_serial != s->color_serial || s->guest_dirty ||
+        x < s->clean_x || y < s->clean_y ||
+        x + w > s->clean_x + s->clean_w || y + h > s->clean_y + s->clean_h)
+        return 0;
+    for (u32 r = 0; r < h; r++) {
