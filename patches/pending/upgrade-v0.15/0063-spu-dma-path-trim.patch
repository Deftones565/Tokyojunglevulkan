diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index f666627..9f6271e 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -167,6 +167,11 @@ typedef struct IoMapping {
 } IoMapping;
 
 static IoMapping s_io_mappings[CELL_GCM_MAX_IO_MAPPINGS];
+/* One past the highest slot ever handed out (find_free_mapping, or slot 0 at
+ * init): every slot at or above it has never been active, so a scan can stop
+ * there. gcm_ea2io_range runs on every SPU PUT, and walking all 256 slots
+ * there was a few percent of Tokyo Jungle's SPU task threads. Only grows. */
+static volatile int s_io_mappings_hi;
 static int s_io_mapping_count = 0;
 
 /* Callback handlers — these are GUEST OPD addresses passed by the
@@ -440,8 +445,10 @@ static IoMapping* find_mapping_by_io(u32 io)
 static IoMapping* find_free_mapping(void)
 {
     for (int i = 0; i < CELL_GCM_MAX_IO_MAPPINGS; i++) {
-        if (!s_io_mappings[i].active)
+        if (!s_io_mappings[i].active) {
+            if (i + 1 > s_io_mappings_hi) s_io_mappings_hi = i + 1;
             return &s_io_mappings[i];
+        }
     }
     return NULL;
 }
@@ -530,6 +537,7 @@ s32 cellGcmInit(u32 cmdSize, u32 ioSize, u32 ioAddress)
         s_io_mappings[0].size   = ioSize;
         s_io_mappings[0].active = 1;
         s_io_mapping_count = 1;
+        if (s_io_mappings_hi < 1) s_io_mappings_hi = 1;
     }
 
     /* Zero the guest-visible control register (put/get/ref). */
@@ -1411,7 +1419,8 @@ static int s_spu_blk_w = 0;
 /* EA -> IO through the mapping list (range lookup; the by-ea helper is exact). */
 static u32 gcm_ea2io_range(u32 ea, u32* room)
 {
