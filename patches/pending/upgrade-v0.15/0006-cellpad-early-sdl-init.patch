@@ -200,6 +200,10 @@ s32 cellPadClearBuf(u32 port_no);
 /* Internal: call once per frame to update pad state from host input */
 void cellPad_poll(void);
 
+/* Port setup (not a firmware call): initialise the host input backend from the
+ * main thread before any other thread uses SDL. See cellPad.c. */
+void cellPad_host_init(void);
