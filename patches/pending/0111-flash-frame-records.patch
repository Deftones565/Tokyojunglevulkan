+        d12 += (u32)abs((int)h[1].y[i] - (int)h[2].y[i]);
+        d02 += (u32)abs((int)h[0].y[i] - (int)h[2].y[i]);
+    }
+    d01 /= N; d12 /= N; d02 /= N;
+    if (d01 >= 12 && d12 >= 12 && d02 * 3 <= (d01 < d12 ? d01 : d12)) {
+        static u32 logged;
+        if (logged++ < 500) {
+            fprintf(stderr, "[flash] frame %u flip %u: diff %u/%u vs neighbours (they differ by %u)\n",
