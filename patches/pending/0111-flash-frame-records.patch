+                k, g.surfaces[k].location, g.surfaces[k].offset, g.surfaces[k].w, g.surfaces[k].h,
+                g.surfaces[k].pitch, (int)g.surfaces[k].fmt,
+                (unsigned long long)g.surfaces[k].color_serial, g.surfaces[k].handle ? "" : " (no handle)");
+}
