+/* RSX_FLASH_DETECT=1 (diag): what each frame wrote where, as runs of
+ * <kind><surface> x<count> in command order -- d draw with colour writes,
+ * z draw without, c clear, x GPU copy into, w CPU/SPU write pushed into --
+ * kept for the last 8 frames. When the flash detector flags a frame, the
+ * flash frame and its neighbours are printed: did the world's draws go to a
+ * different surface, not run at all, or run where we did not present? */
+enum { FR_RUNS = 64 };
+typedef struct {
+    u32 frame, flip_buf, target, disp_loc, disp_off, draws, n_runs, dropped, gcm_anom, gcm_wraps;
+    struct { u32 n; u16 surf, aux; char kind; } run[FR_RUNS];
+} eng_frame_rec;
+static eng_frame_rec s_fr[8];
+static int fr_on(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("RSX_FLASH_DETECT") ? 1 : 0;
+    return on;
+}
+static eng_frame_rec* fr_cur(void)
+{
+    eng_frame_rec* r = &s_fr[g.frames & 7u];
+    if (r->frame != g.frames || !r->n_runs) {
+        if (r->frame != g.frames) { memset(r, 0, sizeof *r); r->frame = g.frames; }
+    }
+    return r;
+}
+/* aux: for draws, the depth target slot (0xFF none) | 0x100 if depth-tested;
+ * 0xFFFF prints nothing. F = the drain met the flip (FIFO order), P = the
+ * frame clock's present (rsx_draw_engine_present). */
+static void fr_note_aux(char kind, unsigned surf, unsigned aux)
+{
+    if (!fr_on()) return;
+    eng_frame_rec* r = fr_cur();
+    if (r->n_runs && r->run[r->n_runs - 1].surf == (u16)surf && r->run[r->n_runs - 1].kind == kind &&
+        r->run[r->n_runs - 1].aux == (u16)aux) {
+        r->run[r->n_runs - 1].n++;
+        return;
+    }
+    if (r->n_runs < FR_RUNS) {
+        r->run[r->n_runs].surf = (u16)surf; r->run[r->n_runs].kind = kind; r->run[r->n_runs].n = 1;
+        r->run[r->n_runs].aux = (u16)aux;
+        r->n_runs++;
+    } else r->dropped++;
+}
+static void fr_note(char kind, unsigned surf) { fr_note_aux(kind, surf, 0xFFFFu); }
+u32 rsx_draw_engine_frame_no(void) { return g.frames; }
+void rsx_draw_engine_print_frame(u32 frame, const char* tag)
+{
+    const eng_frame_rec* r = &s_fr[frame & 7u];
+    if (r->frame != frame) { fprintf(stderr, "[flash]   %s frame %u: record gone\n", tag, frame); return; }
+    char line[2048]; int n = 0;
+    for (u32 i = 0; i < r->n_runs && n < (int)sizeof line - 32; i++)
+    {
+        const u32 a = r->run[i].aux;
+        if (a == 0xFFFFu)
+            n += snprintf(line + n, sizeof line - n, " %c%u x%u", r->run[i].kind, r->run[i].surf, r->run[i].n);
+        else
+            n += snprintf(line + n, sizeof line - n, " %c%u/z%d%s x%u", r->run[i].kind, r->run[i].surf,
+                          (a & 0xFFu) == 0xFFu ? -1 : (int)(a & 0xFFu), (a & 0x100u) ? "t" : "", r->run[i].n);
+    }
+    fprintf(stderr, "[flash]   %s frame %u buf %u (loc %u off 0x%08X) -> surface %u, draws %u, gcm resync/recycle %u, wraps %u, runs%s%s\n",
+            tag, r->frame, r->flip_buf, r->disp_loc, r->disp_off, r->target, r->draws, r->gcm_anom,
+            r->gcm_wraps, line, r->dropped ? " (+more)" : "");
+}
+void rsx_draw_engine_print_surfaces(void)
+{
+    for (u32 k = 0; k < g.n_surfaces; k++)
