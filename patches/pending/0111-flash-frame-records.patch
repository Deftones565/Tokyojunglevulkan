+    /* History of three: [0] oldest. */
+    typedef struct { u8 y[N]; u32 frame, flip, draws, surface, w, h; u32 mean; } shot;
+    static shot h[3]; static u32 nh, frame;
+    memmove(&h[0], &h[1], sizeof(shot) * 2);
+    shot* c = &h[2];
+    const u8* px = (const u8*)buf.ptr;
+    u32 sum = 0;
+    for (u32 i = 0; i < N; i++) {
+        c->y[i] = (u8)((px[i * 4] * 54u + px[i * 4 + 1] * 183u + px[i * 4 + 2] * 19u) >> 8);
+        sum += c->y[i];
