+                            VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT) ||
+            vk_stage(&buf, (VkDeviceSize)N * 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT)) { on = 0; return; }
+        if (vk_begin()) { on = 0; return; }
+        vk_barrier_image(im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        if (vk_submit_and_wait()) { on = 0; return; }
+        ready = 1;
+    }
+    if (vk_begin()) return;
+    vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkImageBlit b = {
+        .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .srcOffsets = { { 0, 0, 0 }, { (int32_t)o->iw, (int32_t)o->ih, 1 } },
+        .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .dstOffsets = { { 0, 0, 0 }, { TW, TH, 1 } },
+    };
+    pvkCmdBlitImage(s_vk.cmd, o->im.img, VK_IMAGE_LAYOUT_GENERAL, im.img, VK_IMAGE_LAYOUT_GENERAL,
+                    1, &b, VK_FILTER_LINEAR);
+    VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                           .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+                           .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_HOST_READ_BIT };
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+                          0, 1, &mb, 0, NULL, 0, NULL);
+    VkBufferImageCopy region = {
+        .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .imageExtent = { TW, TH, 1 },
+    };
+    pvkCmdCopyImageToBuffer(s_vk.cmd, im.img, VK_IMAGE_LAYOUT_GENERAL, buf.buf, 1, &region);
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+                          0, 1, &mb, 0, NULL, 0, NULL);
+    if (vk_submit_and_wait()) return;
+    vk_invalidate(&buf);
