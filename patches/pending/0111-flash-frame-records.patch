+/* RSX_FLASH_DETECT=1 (diag): a 64x36 luminance thumbnail of every presented
+ * frame, compared with its neighbours. A frame unlike both the one before and
+ * the one after, while those two match each other (A-B-A), is a one-frame
+ * flash -- the user's "world vanishes to the skybox" -- and is logged with
+ * its render stats next to its neighbours'. One small blit + readback per
+ * present. */
+extern unsigned cellGcm_flip_request_count(void);
+extern u32 rsx_draw_engine_frame_draws(void);
+extern u32 rsx_draw_engine_frame_no(void);
+extern void rsx_draw_engine_print_frame(u32 frame, const char* tag);
+extern void rsx_draw_engine_print_surfaces(void);
+static void vk_flash_probe(const vk_eng_obj* o, u32 surface)
+{
+    enum { TW = 64, TH = 36, N = TW * TH };
+    static int on = -1;
+    if (on < 0) on = getenv("RSX_FLASH_DETECT") ? 1 : 0;
+    if (!on || !o || o->fmt != VK_FORMAT_R8G8B8A8_UNORM) return;
+    if (!rsx_draw_engine_frame_draws()) return;    /* a re-present: not a new frame */
+    static vk_image im; static vk_buffer buf; static int ready;
+    if (!ready) {
+        if (vk_create_image(&im, VK_FORMAT_R8G8B8A8_UNORM, TW, TH,
+                            VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT) ||
+            vk_stage(&buf, (VkDeviceSize)N * 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT)) { on = 0; return; }
+        if (vk_begin()) { on = 0; return; }
+        vk_barrier_image(im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        if (vk_submit_and_wait()) { on = 0; return; }
+        ready = 1;
+    }
+    if (vk_begin()) return;
+    vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkImageBlit b = {
+        .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .srcOffsets = { { 0, 0, 0 }, { (int32_t)o->iw, (int32_t)o->ih, 1 } },
+        .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .dstOffsets = { { 0, 0, 0 }, { TW, TH, 1 } },
+    };
+    pvkCmdBlitImage(s_vk.cmd, o->im.img, VK_IMAGE_LAYOUT_GENERAL, im.img, VK_IMAGE_LAYOUT_GENERAL,
+                    1, &b, VK_FILTER_LINEAR);
+    VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                           .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+                           .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_HOST_READ_BIT };
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+                          0, 1, &mb, 0, NULL, 0, NULL);
+    VkBufferImageCopy region = {
+        .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .imageExtent = { TW, TH, 1 },
+    };
+    pvkCmdCopyImageToBuffer(s_vk.cmd, im.img, VK_IMAGE_LAYOUT_GENERAL, buf.buf, 1, &region);
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+                          0, 1, &mb, 0, NULL, 0, NULL);
+    if (vk_submit_and_wait()) return;
+    vk_invalidate(&buf);
+
+    /* History of three: [0] oldest. */
+    typedef struct { u8 y[N]; u32 frame, flip, draws, surface, w, h; u32 mean; } shot;
+    static shot h[3]; static u32 nh, frame;
+    memmove(&h[0], &h[1], sizeof(shot) * 2);
+    shot* c = &h[2];
+    const u8* px = (const u8*)buf.ptr;
+    u32 sum = 0;
+    for (u32 i = 0; i < N; i++) {
+        c->y[i] = (u8)((px[i * 4] * 54u + px[i * 4 + 1] * 183u + px[i * 4 + 2] * 19u) >> 8);
+        sum += c->y[i];
+    }
+    c->mean = sum / N; c->frame = rsx_draw_engine_frame_no(); (void)frame; c->flip = cellGcm_flip_request_count();
+    c->draws = rsx_draw_engine_frame_draws(); c->surface = surface; c->w = o->iw; c->h = o->ih;
+    if (++nh < 3) return;
+    u32 d01 = 0, d12 = 0, d02 = 0;
+    for (u32 i = 0; i < N; i++) {
+        d01 += (u32)abs((int)h[0].y[i] - (int)h[1].y[i]);
+        d12 += (u32)abs((int)h[1].y[i] - (int)h[2].y[i]);
+        d02 += (u32)abs((int)h[0].y[i] - (int)h[2].y[i]);
+    }
+    d01 /= N; d12 /= N; d02 /= N;
+    if (d01 >= 12 && d12 >= 12 && d02 * 3 <= (d01 < d12 ? d01 : d12)) {
+        static u32 logged;
+        if (logged++ < 500) {
+            fprintf(stderr, "[flash] frame %u flip %u: diff %u/%u vs neighbours (they differ by %u)\n",
+                    h[1].frame, h[1].flip, d01, d12, d02);
+            for (int k = 0; k < 3; k++)
+                fprintf(stderr, "[flash]   %s frame %u flip %u surface %u %ux%u draws %u mean %u\n",
+                        k == 1 ? "FLASH" : "     ", h[k].frame, h[k].flip, h[k].surface,
+                        h[k].w, h[k].h, h[k].draws, h[k].mean);
+            /* every present in between, also the ones without draws */
+            for (u32 f = h[0].frame; f <= h[2].frame && f - h[0].frame < 8; f++)
+                rsx_draw_engine_print_frame(f, f == h[1].frame ? "FLASH" : f < h[1].frame ? "prev " : "next ");
+            if (logged <= 20 || logged % 50 == 0) rsx_draw_engine_print_surfaces();
+            /* RSX_FLASH_GATE=<file>: create it on the first flash, so the pass
+             * dump (RSX_ENGINE_PASS_DUMP_GATE=<same file>) starts right there. */
+            { const char* g = getenv("RSX_FLASH_GATE");
+              if (g && *g) { FILE* gf = fopen(g, "ab"); if (gf) fclose(gf); } }
+        }
+    }
+}
