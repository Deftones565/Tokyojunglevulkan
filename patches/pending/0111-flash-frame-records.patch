+ * flash frame and its neighbours are printed: did the world's draws go to a
+ * different surface, not run at all, or run where we did not present? */
+enum { FR_RUNS = 64 };
+typedef struct {
+    u32 frame, flip_buf, target, disp_loc, disp_off, draws, n_runs, dropped, gcm_anom, gcm_wraps;
+    struct { u32 n; u16 surf; char kind; } run[FR_RUNS];
