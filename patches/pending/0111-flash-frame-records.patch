+    c->mean = sum / N; c->frame = rsx_draw_engine_frame_no(); (void)frame; c->flip = cellGcm_flip_request_count();
+    c->draws = rsx_draw_engine_frame_draws(); c->surface = surface; c->w = o->iw; c->h = o->ih;
+    if (++nh < 3) return;
