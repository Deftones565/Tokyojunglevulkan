+extern void rsx_draw_engine_print_surfaces(void);
+static void vk_flash_probe(const vk_eng_obj* o, u32 surface)
+{
+    enum { TW = 64, TH = 36, N = TW * TH };
+    static int on = -1;
+    if (on < 0) on = getenv("RSX_FLASH_DETECT") ? 1 : 0;
+    if (!on || !o || o->fmt != VK_FORMAT_R8G8B8A8_UNORM) return;
+    if (!rsx_draw_engine_frame_draws()) return;    /* a re-present: not a new frame */
+    static vk_image im; static vk_buffer buf; static int ready;
+    if (!ready) {
