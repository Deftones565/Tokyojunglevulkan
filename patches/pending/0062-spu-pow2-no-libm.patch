-        float step = ldexpf((float)step_frac, (int)exp - 127 - 13);
+        /* Same values as ldexpf((float)step_frac, exp - 140) and
+         * ldexpf(ra & 0x7FFFF, -19): both are exact (a 10-bit integer times
+         * 2^-140..2^115, a 19-bit one times 2^-19), so no rounding to differ. */
+        float step = (float)((double)step_frac * spu__pow2((int)exp - 127 - 13));
         if (base < 0.0f) step = -step;
-        float y = ldexpf((float)(ra & 0x7FFFFu), -19);
+        float y = (float)(ra & 0x7FFFFu) * (1.0f / 524288.0f);
         r._f32[i] = base - step * y;
     }
     return r;
@@ -396,8 +406,11 @@
 static inline double spu__xf_in(uint32_t b) {
     const uint32_t e = (b >> 23) & 0xFFu;
     if (e == 0u) return (b & 0x80000000u) ? -0.0 : 0.0;
-    const double v = ldexp(1.0 + (double)(b & 0x7FFFFFu) / 8388608.0, (int)e - 127);
-    return (b & 0x80000000u) ? -v : v;
+    /* (1 + m/2^23) * 2^(e-127), sign applied: the same double the ldexp form
+     * gave, built from its bits (exponent e - 127 + 1023, mantissa m << 29). */
+    const uint64_t u = ((uint64_t)(b & 0x80000000u) << 32) | ((uint64_t)(e + 896u) << 52) |
+                       ((uint64_t)(b & 0x7FFFFFu) << 29);
+    double v; memcpy(&v, &u, sizeof v); return v;
