+/* ---------------------------------------------------------------------------
+ * Frame-rate readout (user, 2026-10-16)
+ * -----------------------------------------------------------------------*/
+/* F1 toggles it, TJ_SHOW_FPS=1 starts with it on. The window title then reads
+ * "<title> | 23.4 fps", refreshed once a second; fps is GAME frames: flips the
+ * guest finished (cellGcm_flip_request_count), the number that matters for how
+ * the game plays, not presents. The key is caught with SDL_AddEventWatch, which
+ * sees every event the backend's pump takes off the queue on this thread, so
+ * the backend's own loop is untouched. Headless there is no window: no-op. */
+#if __has_include(<SDL2/SDL.h>)
+#include <SDL2/SDL.h>
+static int s_show_fps = -1;                  /* -1: TJ_SHOW_FPS not read yet */
+static int SDLCALL fps_key_watch(void*, SDL_Event* e)
+{
+    if (e->type == SDL_KEYDOWN && !e->key.repeat && e->key.keysym.sym == SDLK_F1)
+        s_show_fps = !s_show_fps;
+    return 1;
+}
+static void fps_title_update(const char* title)
+{
+    static bool watching = false, shown = false;
+    static auto t0 = std::chrono::steady_clock::now();
+    static unsigned f0 = 0;
+    if (s_show_fps < 0) {
+        const char* e = getenv("TJ_SHOW_FPS");
+        s_show_fps = (e && *e && *e != '0') ? 1 : 0;
+    }
+    if (!watching) { SDL_AddEventWatch(fps_key_watch, NULL); watching = true; }
+    /* The backend's one window. Its id is not reliably 1, so find it once. */
+    static SDL_Window* w = NULL;
+    if (!w) {
+        for (Uint32 id = 1; id < 256 && !w; id++) w = SDL_GetWindowFromID(id);
+        if (!w) return;
+        fprintf(stderr, "[fps] readout on window id %u (F1 toggles)\n", SDL_GetWindowID(w));
+    }
+    if (!s_show_fps) {
+        if (shown) { SDL_SetWindowTitle(w, title); shown = false; }
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    const double s = std::chrono::duration<double>(now - t0).count();
+    if (shown && s < 1.0) return;
+    const unsigned f = cellGcm_flip_request_count();
+    char buf[256];
+    if (shown) snprintf(buf, sizeof buf, "%s | %.1f fps", title, (f - f0) / s);
+    else       snprintf(buf, sizeof buf, "%s | -- fps", title);   /* first second */
+    SDL_SetWindowTitle(w, buf);
+    shown = true; t0 = now; f0 = f;
+}
+#else
+static void fps_title_update(const char*) {}
+#endif
+
 static DWORD WINAPI frame_clock(LPVOID)
 {
     const char* title = getenv("PS3_TITLE");
@@ -449,6 +502,7 @@ static DWORD WINAPI frame_clock(LPVOID)
                 fprintf(stderr, "[quit] window closed: REQUEST_EXITGAME sent, %ld ms to exit\n",
                         grace_ms);
             }
+            fps_title_update(title);   /* F1 / TJ_SHOW_FPS: fps in the window title */
