diff --color -ruN base/runtime/diag/lift_gap.c ps3recomp-magi4/runtime/diag/lift_gap.c
--- /dev/null
+++ b/runtime/diag/lift_gap.c
@@ -0,0 +1,78 @@
+/* lift_gap.c -- see lift_gap.h. */
+#include "lift_gap.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _MSC_VER
+#include <windows.h>
+#define LG_CAS_PTR(p, o, n) InterlockedCompareExchangePointer((PVOID volatile*)(p), (PVOID)(n), (PVOID)(o))
+#define LG_INC(p)           ((uint32_t)InterlockedIncrement((volatile LONG*)(p)))
+#else
+#define LG_CAS_PTR(p, o, n) __sync_val_compare_and_swap((p), (o), (n))
+#define LG_INC(p)           __sync_add_and_fetch((p), 1u)
+#endif
+
+#define LIFT_GAP_KINDS     32
+#define LIFT_GAP_FIRST     16u
+#define LIFT_GAP_EVERY   1024u
+
+static struct {
+    const char* volatile kind;
+    volatile uint32_t count;
+} s_kinds[LIFT_GAP_KINDS];
+
+int ps3_lift_strict(void)
+{
+    static int strict = -1;
+    if (strict < 0) {
+        const char* e = getenv("PS3_STRICT_LIFT");
+        strict = (e && e[0] && e[0] != '0') ? 1 : 0;
+    }
+    return strict;
+}
+
+/* Count one more of `kind`; the count after this one. Slots are claimed with
+ * a compare-and-swap so two threads never share one; a full table still
+ * reports (count 0 = no rate limit). */
+static uint32_t lift_gap_bump(const char* kind)
+{
+    for (int i = 0; i < LIFT_GAP_KINDS; i++) {
+        const char* k = s_kinds[i].kind;
+        if (!k) {
+            k = (const char*)LG_CAS_PTR(&s_kinds[i].kind, (const char*)NULL, kind);
+            if (!k) k = kind;
+        }
+        if (k == kind || strcmp(k, kind) == 0)
+            return LG_INC(&s_kinds[i].count);
+    }
+    return 0;
+}
+
+void ps3_lift_gap(const char* kind, uint32_t addr, const char* fmt, ...)
+{
+    const uint32_t n = lift_gap_bump(kind);
+    const int strict = ps3_lift_strict();
+    if (!strict && n > LIFT_GAP_FIRST && (n % LIFT_GAP_EVERY) != 0) return;
+
+    char detail[256];
+    detail[0] = 0;
+    if (fmt) {
+        va_list ap;
+        va_start(ap, fmt);
+        vsnprintf(detail, sizeof detail, fmt, ap);
+        va_end(ap);
+    }
+    if (n > LIFT_GAP_FIRST)
+        fprintf(stderr, "[LIFT-GAP] %s addr=0x%08X %s (#%u of this kind)\n", kind, addr, detail, n);
+    else
+        fprintf(stderr, "[LIFT-GAP] %s addr=0x%08X %s\n", kind, addr, detail);
+    if (strict) {
+        fprintf(stderr, "[LIFT-GAP] FATAL: PS3_STRICT_LIFT=1 -- add 0x%08X as an entry point and "
+                        "re-lift (never interpret it)\n", addr);
+        fflush(stderr);
+        exit(4);
+    }
+}
diff --color -ruN base/runtime/diag/lift_gap.h ps3recomp-magi4/runtime/diag/lift_gap.h
--- /dev/null
+++ b/runtime/diag/lift_gap.h
@@ -0,0 +1,40 @@
+/* lift_gap.h -- one loud, greppable line for every lift gap.
+ *
+ * A lift gap is guest code the port reached but has no lifted function for:
+ * an indirect call to an unregistered PPU address, an SPU thread or SPURS job
+ * whose image is not in the lifted registry, a branch into unlifted local
+ * store, an SPU instruction the lifter could not translate. The fix is always
+ * to add the entry point and re-lift, never to interpret the bytes. Several
+ * runtime paths used to step over these quietly (return 0, complete the job,
+ * log a few lines and go on); each now also reports through ps3_lift_gap():
+ *
+ *   [LIFT-GAP] <kind> addr=0x%08X <detail>
+ *
+ * Always on, whatever PS3_VERBOSE says. Rate-limited per kind: the first 16,
+ * then every 1024th with a running count. PS3_STRICT_LIFT=1 makes the first
+ * one fatal (exit code 4) after printing it, so a run proves there are none.
+ */
+#ifndef PS3_LIFT_GAP_H
+#define PS3_LIFT_GAP_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* `kind` must be a string literal (it is the rate-limit key). */
+void ps3_lift_gap(const char* kind, uint32_t addr, const char* fmt, ...)
+#if defined(__GNUC__) || defined(__clang__)
+    __attribute__((format(printf, 3, 4)))
+#endif
+    ;
+
+/* PS3_STRICT_LIFT=1 */
+int ps3_lift_strict(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3_LIFT_GAP_H */
