+/* Append the transfer after queued draws, then wait ONCE for both. This
+ * retains CPU-visible ordering while avoiding a separate draw-only wait.
+ * PS3RECOMP_VK_READBACK_BATCH=0 restores the old two-submission sequence. */
+static int vk_readback_batched(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_VK_READBACK_BATCH"); on = !e || *e != '0'; }
+    return on;
+}
+static int vk_readback_begin(void)
+{
+    return vk_readback_batched() ? vk_rec_begin() : vk_begin();
+}
+static int vk_readback_finish(void)
+{
+    return vk_readback_batched() && !vk_batching_off() ? vk_batch_flush() : vk_submit_and_wait();
+}
