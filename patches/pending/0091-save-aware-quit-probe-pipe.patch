# NOT LANDED. (1) cellSaveData counts saves in progress (cellSaveData_busy) and
# src/main.cpp's quit path waits for them (up to 30 s past the 3 s grace).
# (2) ppu_dump_readable's probe pipe non-blocking + drained when full.
# Blocked on: quit never finishes, on build/ too (TJ_QUIT_AFTER_S=20 headless,
# mg5-quit*): all threads in do_exit but one, stuck in anon_pipe_write on a
# self-pipe (not this probe pipe). Find that pipe (SDL/pipewire/libusb wake
# pipe?) with gdb started as the parent, breaking on exit_group.
diff --git a/libs/system/cellSaveData.c b/libs/system/cellSaveData.c
index ef0906e..7409090 100644
--- a/libs/system/cellSaveData.c
+++ b/libs/system/cellSaveData.c
@@ -799,12 +799,36 @@ static void read_param_sfo(const char* save_path, CellSaveDataSystemFileParam* p
     fclose(fp);
 }
 
+/* Saves in progress, for the host's quit path: closing the window gives the
+ * title a few seconds to exit, then ends the process, and a save being written
+ * then would be cut off. The host waits while this is non-zero (bounded). */
+static volatile long s_saves_in_progress;
+int cellSaveData_busy(void) { return __atomic_load_n(&s_saves_in_progress, __ATOMIC_ACQUIRE) != 0; }
+
+static s32 savedata_execute_impl(const char* dirName, int is_save,
+                                 CellSaveDataSetBuf* setBuf,
+                                 CellSaveDataStatCallback funcStat,
+                                 CellSaveDataFileCallback funcFile,
+                                 void* userdata);
+
 /* Core save/load implementation shared by List/Fixed/Auto variants */
 static s32 savedata_execute(const char* dirName, int is_save,
                              CellSaveDataSetBuf* setBuf,
                              CellSaveDataStatCallback funcStat,
                              CellSaveDataFileCallback funcFile,
                              void* userdata)
+{
+    if (is_save) __atomic_add_fetch(&s_saves_in_progress, 1, __ATOMIC_ACQ_REL);
+    const s32 r = savedata_execute_impl(dirName, is_save, setBuf, funcStat, funcFile, userdata);
+    if (is_save) __atomic_sub_fetch(&s_saves_in_progress, 1, __ATOMIC_ACQ_REL);
+    return r;
+}
+
+static s32 savedata_execute_impl(const char* dirName, int is_save,
+                                 CellSaveDataSetBuf* setBuf,
+                                 CellSaveDataStatCallback funcStat,
+                                 CellSaveDataFileCallback funcFile,
+                                 void* userdata)
 {
     if (!dirName || !funcStat)
         return CELL_SAVEDATA_ERROR_PARAM;
diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
index 7965ce0..2fb7f03 100644
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -41,6 +41,8 @@
 #include <sys/mman.h>   /* the guest-pointer trap reserves the low 4 GB */
 #include <signal.h>
 #include <unistd.h>
+#include <fcntl.h>   /* pipe2, O_NONBLOCK: ppu_dump_readable */
+#include <errno.h>
 #endif
 extern "C" uint32_t ppu_prof_resolve_host(void* ra);
 
@@ -2108,16 +2110,26 @@ static bool ppu_dump_readable(uint32_t ea, uint32_t n)
 #ifdef _WIN32
     return true;
 #else
+    /* Non-blocking, and emptied when full: a read that failed (EINTR) or two
+     * threads probing at once could leave bytes behind, and once the pipe's
+     * 64 KB filled, the next probe blocked in write() for good -- at quit,
+     * when every exiting guest thread dumps its stack, which kept the process
+     * from ever finishing its exit. */
     static int s_probe[2] = {-1, -1};
-    static const bool s_have_probe = pipe(s_probe) == 0;
+    static const bool s_have_probe = pipe2(s_probe, O_NONBLOCK | O_CLOEXEC) == 0;
     if (!s_have_probe) return true;           /* cannot probe: read as before */
     const uintptr_t pg    = (uintptr_t)vm_host_page_size();
     const uintptr_t first = (uintptr_t)(vm_base + ea) & ~(pg - 1);
     const uintptr_t last  = (uintptr_t)(vm_base + ea + n - 1) & ~(pg - 1);
     for (uintptr_t a = first; a <= last; a += pg) {
-        char c;
-        if (write(s_probe[1], (const void*)a, 1) != 1) return false;
-        if (read(s_probe[0], &c, 1) != 1) return false;
+        char c, sink[256];
+        ssize_t w = write(s_probe[1], (const void*)a, 1);
+        if (w < 0 && errno == EAGAIN) {       /* full: empty it, try once more */
+            while (read(s_probe[0], sink, sizeof sink) > 0) {}
+            w = write(s_probe[1], (const void*)a, 1);
+        }
+        if (w != 1) return false;
+        (void)read(s_probe[0], &c, 1);
     }
     return true;
 #endif
