+/* BAL experiment (private, never lands): busy-wait BAL_IMG9_SPIN_NS after every
+ * WAIT_SIGNAL return of image 9's tasks, to slow each work cycle. Timing test. */
+static void bal_img9_wake_spin(spu_context* ctx)
+{
+    static long ns = -1; static long n = 0;
+    if (ns < 0) { const char* e = getenv("BAL_IMG9_SPIN_NS"); ns = e ? atol(e) : 0; }
+    if (ctx->image_id != 9) return;
+    { /* which wait site, and was a PPU kick pending when it woke */
+      extern volatile uint32_t g_bal_kick[128]; extern uint8_t* vm_base;
+      static long nb, nbk, nk, nk0; static long tot;
+      const uint32_t link = ctx->gpr[0]._u32[0] & SPU_LS_MASK;
+      const uint32_t tid = ((uint32_t)ctx->ls[0x27D6] << 8) | ctx->ls[0x27D7];
+      const uint32_t kicks = tid < 128 ? __atomic_exchange_n(&g_bal_kick[tid], 0, __ATOMIC_SEQ_CST) : 0;
+      const uint8_t* b = vm_base + 0x441D2400u;
+      if (link == 0x0A868) {                 /* barrier wait */
+          __atomic_add_fetch(&nb, 1, __ATOMIC_RELAXED);
+          if (kicks) { long m = __atomic_add_fetch(&nbk, 1, __ATOMIC_RELAXED);
+              if (m <= 20 || (m & (m - 1)) == 0)
+                  fprintf(stderr, "[bal-bar] task %u passed BARRIER wait with %u PPU kick(s) pending (#%ld); barrier:"
+                          " %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X\n", tid, kicks, m,
+                          b[0],b[1],b[2],b[3],b[4],b[5],b[6],b[7],b[8],b[9],b[10],b[11],b[12],b[13],b[14],b[15]); }
+      } else if (link == 0x0A230) {          /* PPU kick wait */
+          __atomic_add_fetch(&nk, 1, __ATOMIC_RELAXED);
+          if (!kicks) __atomic_add_fetch(&nk0, 1, __ATOMIC_RELAXED);
+      }
+      long tt = __atomic_add_fetch(&tot, 1, __ATOMIC_RELAXED);
+      if ((tt & 1023) == 0)
+          fprintf(stderr, "[bal-bar] summary: %ld wakes; barrier waits %ld (with PPU kick pending %ld); kick waits %ld (no kick seen %ld)\n",
+                  tt, nb, nbk, nk, nk0);
+    }
+    long k = __atomic_add_fetch(&n, 1, __ATOMIC_RELAXED);
+    if ((k & (k - 1)) == 0) fprintf(stderr, "[bal] img9 wake #%ld spin %ld ns\n", k, ns);
+    if (!ns) return;
+    struct timespec a, b; clock_gettime(CLOCK_MONOTONIC, &a);
+    do clock_gettime(CLOCK_MONOTONIC, &b);
+    while ((b.tv_sec - a.tv_sec) * 1000000000L + (b.tv_nsec - a.tv_nsec) < ns);
+}
